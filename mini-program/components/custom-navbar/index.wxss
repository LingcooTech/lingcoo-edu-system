.custom-navbar {
  position: fixed;
  z-index: 900;
  top: 0;
  right: 0;
  left: 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.03);
  background: rgba(246, 244, 240, 0.74);
  backdrop-filter: blur(18rpx);
  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    backdrop-filter 0.18s ease;
}

.custom-navbar.transparent {
  border-bottom-color: transparent;
  background: transparent;
  backdrop-filter: none;
}

.custom-navbar-inner {
  position: relative;
  display: flex;
  min-width: 0;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding-left: 40rpx;
}

.navbar-title {
  display: flex;
  height: 100%;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
  letter-spacing: 0;
}

.navbar-title.centered {
  position: fixed;
  right: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 180rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  pointer-events: none;
}

.navbar-back {
  position: absolute;
  z-index: 1;
  top: 0;
  bottom: 0;
  left: 40rpx;
  display: flex;
  width: 56rpx;
  height: 100%;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: flex-start;
  border: 0;
  background: transparent;
  color: #211f1c;
  line-height: 1;
  margin: 0;
  padding: 0;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.navbar-back-icon {
  width: 22rpx;
  height: 22rpx;
  margin-left: 8rpx;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.navbar-back::after {
  border: 0;
}

.navbar-back:active {
  opacity: 0.6;
}
