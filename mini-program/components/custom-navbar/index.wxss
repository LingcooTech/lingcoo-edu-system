.custom-navbar {
  position: fixed;
  z-index: 900;
  top: 0;
  right: 0;
  left: 0;
  box-sizing: border-box;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.05);
  display: flex;
  align-items: flex-end;
}

.custom-navbar-inner {
  position: relative;
  display: flex;
  min-width: 0;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding-left: 24rpx;
}

.navbar-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
  letter-spacing: -0.3px;
}

.navbar-title.with-back {
  padding-right: 0;
}

.navbar-back {
  display: flex;
  width: 72rpx;
  height: 100%;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: #211f1c;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
  margin: 0;
  padding: 0 12rpx 0 0;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.navbar-back::after {
  border: 0;
}

.navbar-back:active {
  opacity: 0.6;
}
