          <view class="form-label">家长姓名</view>
          <input class="academic-input" value="{{studentCreateForm.guardianName}}" data-field="guardianName" bindinput="onStudentCreateInput" placeholder="可不填" />
          <view class="form-label">家长手机号</view>
          <input class="academic-input" type="number" value="{{studentCreateForm.guardianPhone}}" data-field="guardianPhone" bindinput="onStudentCreateInput" placeholder="可不填" />
