<view class="teacher-workbench">
  <skeleton wx:if="{{loading}}" variant="hub" />

  <block wx:else>
    <view class="card summary-card">
      <view class="summary-head">
        <view class="summary-titlebar">
          <view>
            <view class="summary-eyebrow">老师工作台</view>
            <view class="summary-title">{{summaryTitle}}</view>
          </view>
          <view
            wx:if="{{canSwitchRole}}"
            class="role-switch-button {{switchingRole ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-label="切到管理"
            bindtap="requestRoleSwitch"
          >
            <view wx:if="{{switchingRole}}" class="role-switch-spinner"></view>
            <text>{{switchingRole ? '切换中' : '切到管理'}}</text>
          </view>
        </view>
        <view class="scope-tabs">
          <view
            wx:for="{{scopeTabs}}"
            wx:key="key"
            class="{{item.className}}"
            data-key="{{item.key}}"
            bindtap="switchScope"
          >
            {{item.label}}
          </view>
        </view>
      </view>
      <view class="summary-grid">
        <view class="summary-item summary-action" data-action="schedule" bindtap="handleSummaryTap">
          <view class="summary-value">{{stats.courseCount}}</view>
          <view class="summary-label">课程数</view>
        </view>
        <view class="summary-item summary-action" data-action="rollcall" bindtap="handleSummaryTap">
          <view class="summary-value">{{stats.pendingRollCall}}</view>
          <view class="summary-label">待点名</view>
        </view>
        <view class="summary-item summary-action" data-action="leave" bindtap="handleSummaryTap">
          <view class="summary-value">{{stats.leaveMessages}}</view>
          <view class="summary-label">请假消息</view>
        </view>
        <view class="summary-item summary-action" data-action="homework" bindtap="handleSummaryTap">
          <view class="summary-value">{{stats.pendingHomework}}</view>
          <view class="summary-label">待批阅</view>
        </view>
      </view>
    </view>

    <view class="quick-grid">
      <view
        wx:for="{{viewTabs}}"
        wx:key="key"
        class="{{item.className}}"
        data-key="{{item.key}}"
        bindtap="switchView"
      >
        <view class="quick-icon">
          <image class="quick-icon-image" src="{{item.iconSrc}}" mode="aspectFit" />
          <view wx:if="{{item.badge}}" class="quick-badge">{{item.badge > 99 ? '99+' : item.badge}}</view>
        </view>
        <view class="quick-label">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{teacherNotifications.length}}" class="notice-panel">
      <view class="notice-panel-head">
        <view>
          <view class="section-title notice-title">待处理</view>
          <view class="notice-subtitle">{{pendingAttentionCount}} 条新通知</view>
        </view>
      </view>
      <view class="notice-list">
        <view
          wx:for="{{teacherNotifications}}"
          wx:key="id"
          class="{{item.className}}"
          data-id="{{item.id}}"
          bindtap="openTeacherNotification"
        >
          <view>
            <view class="notice-card-title">{{item.title}}</view>
            <view class="notice-card-body">{{item.body}}</view>
            <view class="notice-card-date">{{item.dateLabel}}</view>
          </view>
          <view class="notice-action">{{item.actionLabel}}</view>
        </view>
      </view>
    </view>

    <block wx:if="{{activeView == 'schedule'}}">
      <view class="card today-reminder-card">
        <view>
          <view class="today-reminder-title">{{todaySummaryText}}</view>
        </view>
        <view class="today-reminder-count">{{todayCourseCount}}</view>
      </view>

      <view class="card calendar-card">
        <view class="calendar-toolbar">
          <view>{{monthLabel}}</view>
          <view class="calendar-actions">
            <button wx:if="{{canSchedule}}" class="schedule-add-button" catchtap="openScheduleCreate">＋ 添加课次</button>
            <view class="calendar-toggle" bindtap="toggleCalendar">{{calendarExpanded ? '收起' : '展开'}}</view>
          </view>
        </view>
        <scroll-view
          wx:if="{{!calendarExpanded}}"
          class="date-strip"
          scroll-x
          enhanced
          enable-flex
          show-scrollbar="{{false}}"
          scroll-with-animation
          scroll-into-view="{{selectedDateAnchor}}"
          upper-threshold="80"
          lower-threshold="80"
          bindscroll="onDateStripScroll"
          bindscrolltoupper="extendDateStripBackward"
          bindscrolltolower="extendDateStripForward"
        >
          <view class="date-strip-track">
            <view
              wx:for="{{dateStripDays}}"
              wx:key="key"
              id="{{item.anchorId}}"
              class="{{item.className}}"
              data-key="{{item.key}}"
              bindtap="selectDay"
            >
              <view class="day-label">{{item.label}}</view>
              <view class="day-num">{{item.day}}</view>
            </view>
          </view>
        </scroll-view>
        <view wx:else>
          <view class="month-weekdays">
            <view wx:for="{{monthWeekdays}}" wx:key="*this">周{{item}}</view>
          </view>
          <view class="month-grid">
            <view
              wx:for="{{monthDays}}"
              wx:key="key"
              class="{{item.className}}"
              data-key="{{item.key}}"
              bindtap="selectDay"
            >
              <view class="month-day-num">{{item.day}}</view>
              <view wx:if="{{item.eventCount}}" class="month-day-count">{{item.eventCount}}场</view>
            </view>
          </view>
        </view>
        <view wx:if="{{selectedEvents.length}}" class="session-list">
          <view
            wx:for="{{selectedEvents}}"
            wx:key="id"
            class="session-row"
            data-id="{{item.id}}"
            data-type="{{item.type}}"
            bindtap="openSessionEdit"
          >
            <view class="row-between">
              <view>
                <view class="session-time">{{item.timeLabel}}</view>
                <view class="session-class">{{item.className}}</view>
                <view class="card-meta">{{item.classroomName}} · {{item.title}} · {{item.scopeLabel}}</view>
              </view>
              <view class="status-text">{{item.statusLabel}}</view>
            </view>
            <view class="session-foot">
              <view wx:if="{{item.type == 'trial_session'}}" class="card-meta">
                试听安排 · {{item.teacherName}}
              </view>
              <view wx:else class="card-meta">
                已点 {{item.attendanceCount}}/{{item.rosterCount}}{{item.leaveCount ? ' · 请假 ' + item.leaveCount : ''}}
              </view>
              <view wx:if="{{item.type == 'class_session' && item.canOperate}}" class="session-quick-actions">
                <button
                  wx:if="{{item.pending}}"
                  class="mini-button session-attendance-button"
                  data-id="{{item.id}}"
                  catchtap="openRollCall"
                >
                  {{item.attendanceActionLabel}}
                </button>
                <button
                  wx:if="{{item.showRosterAction}}"
                  class="mini-button session-roster-button"
                  data-id="{{item.id}}"
                  catchtap="openSessionRoster"
                >
                  添加学员
                </button>
              </view>
              <view wx:elif="{{item.type == 'class_session'}}" class="pill subtle">仅查看</view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-card">当天暂无课程。</view>
      </view>
    </block>

    <block wx:elif="{{activeView == 'trials'}}">
      <view class="trial-workbench-heading">
        <view class="section-title">{{isTrialAdmin ? '试听管理' : '我的试听安排'}}</view>
        <button
          wx:if="{{isTrialAdmin}}"
          class="trial-create-button"
          bindtap="openTrialInviteEditor"
        >
          添加试听课
        </button>
      </view>

      <block wx:if="{{isTrialAdmin}}">
        <view class="trial-section-head">
          <view class="trial-section-title">预约线索</view>
          <view class="trial-section-count">共 {{teacherTrialLeads.length}} 条</view>
        </view>
        <view wx:if="{{teacherTrialLeads.length}}" class="teacher-trial-leads">
          <view wx:for="{{teacherTrialLeads}}" wx:key="id" class="card teacher-trial-lead">
            <view class="trial-lead-top">
              <view class="trial-lead-person">
                <view class="trial-lead-name">{{item.studentName}}</view>
                <view wx:if="{{item.grade}}" class="trial-lead-grade">{{item.grade}}</view>
              </view>
              <view class="trial-lead-top-actions">
                <view class="trial-lead-status">{{item.statusLabel}}</view>
                <view
                  class="trial-lead-inline-button"
                  data-id="{{item.id}}"
                  bindtap="openTrialLeadSchedule"
                >
                  {{item.trialSessionId ? '调整试听' : '安排试听'}}
                </view>
              </view>
            </view>
            <view class="trial-lead-meta trial-lead-contact">
              <text class="trial-lead-guardian">{{item.guardianName || '家长未署名'}}</text>
              <text class="trial-lead-contact-separator">·</text>
              <text
                class="trial-lead-phone"
                data-phone="{{item.phone}}"
                bindtap="callTrialLead"
              >{{item.phone}}</text>
            </view>
            <view class="trial-lead-meta">
              {{item.courseName}} · {{item.campusName}} · {{item.teacherName}}
            </view>
            <view class="trial-lead-created">{{item.createdLabel}} 提交</view>
          </view>
        </view>
        <view wx:else class="card trial-empty-card">暂无预约线索。</view>
      </block>

      <view class="trial-section-head trial-session-section-head">
        <view>
          <view class="trial-section-title">试听课</view>
          <view class="trial-section-note">
            {{activeTrialSessionScope == 'pending' ? '只显示待试听的课次，点击可编辑' : '已结束或已取消的试听记录'}}
          </view>
        </view>
        <view class="trial-session-scopes">
          <view
            class="trial-session-scope {{activeTrialSessionScope == 'pending' ? 'active' : ''}}"
            data-scope="pending"
            bindtap="switchTrialSessionScope"
          >
            待试听 {{pendingTeacherTrialSessions.length}}
          </view>
          <view
            class="trial-session-scope {{activeTrialSessionScope == 'history' ? 'active' : ''}}"
            data-scope="history"
            bindtap="switchTrialSessionScope"
          >
            历史试听 {{historyTeacherTrialSessions.length}}
          </view>
        </view>
      </view>
      <view wx:if="{{displayedTeacherTrialSessions.length}}" class="teacher-trial-list">
        <view
          wx:for="{{displayedTeacherTrialSessions}}"
          wx:key="id"
          class="card teacher-trial-card {{isTrialAdmin && activeTrialSessionScope == 'pending' ? 'is-editable' : ''}}"
          data-id="{{item.id}}"
          bindtap="openTrialSessionEditor"
        >
          <view class="teacher-trial-date">
            <view class="teacher-trial-date-label">{{item.dateLabel}}</view>
            <view class="teacher-trial-time">{{item.timeLabel}}</view>
          </view>
          <view class="teacher-trial-main">
            <view class="teacher-trial-title">{{item.title}}</view>
            <view class="teacher-trial-meta">{{item.courseName}} · {{item.campusName}}</view>
            <view class="teacher-trial-meta">授课：{{item.teacherName}}</view>
            <view class="{{item.confirmationClassName}}">{{item.confirmationLabel}}</view>
          </view>
          <view class="teacher-trial-card-side">
            <view class="teacher-trial-status">{{item.statusLabel}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="card trial-empty-card">
        {{activeTrialSessionScope == 'history' ? '暂无历史试听。' : (isTrialAdmin ? '暂无待试听课次，可从预约线索安排，或直接添加试听课。' : '暂时没有安排给你的待试听课次。')}}
      </view>
    </block>

    <block wx:elif="{{activeView == 'rollcall'}}">
      <view
        wx:if="{{rollCallReminderVisible && pendingRollCall30Count}}"
        class="rollcall-reminder"
        bindtap="showPendingRollCallList"
      >
        <view class="rollcall-reminder-mark">!</view>
        <view class="rollcall-reminder-text">
          近30天有 {{pendingRollCall30Count}} 个课次未点名，请及时处理
        </view>
        <view class="rollcall-reminder-close" catchtap="dismissRollCallReminder">×</view>
      </view>

      <view class="card rollcall-calendar-card">
        <view class="rollcall-calendar-head">
          <view class="rollcall-month">
            {{showPendingRollCalls ? '近30天未点名' : monthLabel}}
          </view>
          <view
            wx:if="{{showPendingRollCalls}}"
            class="rollcall-today"
            bindtap="showRollCallCalendar"
          >
            返回日历
          </view>
          <view wx:else class="rollcall-today" bindtap="goToTodayRollCall">回到今天</view>
        </view>
        <scroll-view
          wx:if="{{!showPendingRollCalls}}"
          class="date-strip rollcall-date-strip"
          scroll-x
          enhanced
          enable-flex
          show-scrollbar="{{false}}"
          scroll-with-animation
          scroll-into-view="{{selectedDateAnchor}}"
          bindscroll="onDateStripScroll"
        >
          <view class="date-strip-track">
            <view
              wx:for="{{rollCallDateStripDays}}"
              wx:key="key"
              id="{{item.anchorId}}"
              class="{{item.className}}"
              data-key="{{item.key}}"
              bindtap="selectDay"
            >
              <view class="day-label">{{item.label}}</view>
              <view class="day-num">{{item.day}}</view>
            </view>
          </view>
        </scroll-view>

        <view wx:if="{{rollCallDisplayEvents.length}}" class="rollcall-session-list">
          <view wx:for="{{rollCallDisplayEvents}}" wx:key="id" class="rollcall-session-row">
            <view class="rollcall-session-main {{showPendingRollCalls ? 'show-date' : ''}}">
              <view class="rollcall-session-when">
                <view wx:if="{{showPendingRollCalls}}" class="rollcall-session-date">
                  {{item.dateLabel}}
                </view>
                <view class="rollcall-session-time">{{item.timeLabel}}</view>
              </view>
              <view class="rollcall-session-info">
                <view class="rollcall-session-title">{{item.className}} · {{item.title}}</view>
                <view class="card-meta">
                  {{item.courseName}} · {{item.classroomName}} · 已点 {{item.attendanceCount}}/{{item.rosterCount}}
                </view>
              </view>
              <view class="rollcall-session-status">{{item.statusLabel}}</view>
            </view>
            <button
              wx:if="{{item.rosterCount}}"
              class="rollcall-start-button"
              data-id="{{item.id}}"
              bindtap="openRollCallDetail"
            >
              {{item.rollCallActionLabel}}
            </button>
            <view wx:else class="rollcall-no-roster">本课次暂无学员，请先在课表中添加学员</view>
          </view>
        </view>
        <view wx:else class="rollcall-empty">
          <view class="rollcall-empty-mark">· · ·</view>
          <view>
            {{showPendingRollCalls ? '近30天暂无未点名课次' : '当天暂无需要点名的课次'}}
          </view>
        </view>
      </view>

      <button
        wx:if="{{canCreateAdHocSession}}"
        class="direct-rollcall-button"
        bindtap="openDirectRollCall"
      >
        没有排课？未排课直接点名
      </button>
    </block>

    <block wx:elif="{{activeView == 'records'}}">
      <view class="feedback-filter record-filter">
        <view
          wx:for="{{recordScopeTabs}}"
          wx:key="key"
          class="{{item.className}}"
          data-key="{{item.key}}"
          bindtap="switchRecordScope"
        >
          <view class="feedback-scope-label">{{item.label}}</view>
          <view class="feedback-scope-count">{{item.count}}</view>
        </view>
      </view>
      <view wx:if="{{recordEvents.length}}" class="list">
        <view
          wx:for="{{recordEvents}}"
          wx:key="id"
          class="card compact-card record-card {{item.canOperate ? 'is-operable' : ''}}"
          data-id="{{item.id}}"
          bindtap="openRecordDetail"
        >
          <view class="row-between">
            <view>
              <view class="card-title">{{item.className}} · {{item.title}}</view>
              <view class="card-meta">
                {{item.dateLabel}} · {{item.timeLabel}} · {{item.courseName}} · {{item.scopeLabel}}
              </view>
            </view>
            <view class="pill subtle">{{item.recordStatusLabel}}</view>
          </view>
          <view class="session-foot">
            <view class="card-meta">
              已点 {{item.attendanceCount}}/{{item.rosterCount}}{{item.leaveCount ? ' · 请假 ' + item.leaveCount : ''}}
            </view>
            <button
              wx:if="{{item.canOperate}}"
              class="mini-button"
              data-id="{{item.id}}"
              catchtap="openRecordDetail"
            >
              {{item.recordActionLabel}}
            </button>
            <view wx:else class="pill subtle">仅查看</view>
          </view>
        </view>
      </view>
      <view wx:else class="card empty-card">暂无上课记录。</view>
    </block>

    <block wx:elif="{{activeView == 'classes'}}">
      <view class="class-list-heading">
        <view class="section-title">班级</view>
        <button wx:if="{{canManageClasses}}" class="class-create-button" catchtap="openClassCreate">新建班级</button>
      </view>

      <view class="card class-filter-card">
        <view class="class-search">
          <view class="student-search-icon">⌕</view>
          <input
            class="class-search-input"
            value="{{classSearchKeyword}}"
            placeholder="搜索班级名称或课程"
            confirm-type="search"
            bindinput="onClassSearchInput"
          />
        </view>
        <view class="class-filter-grid">
          <picker
            mode="selector"
            range="{{classCampusFilterOptions}}"
            range-key="label"
            value="{{classCampusFilterIndex}}"
            bindchange="onClassCampusFilterChange"
          >
            <view class="class-status-picker">
              <text>{{classCampusFilterOptions[classCampusFilterIndex].label}}</text>
              <view class="student-filter-arrow"></view>
            </view>
          </picker>
          <picker
            mode="selector"
            range="{{classTeacherFilterOptions}}"
            range-key="label"
            value="{{classTeacherFilterIndex}}"
            bindchange="onClassTeacherFilterChange"
          >
            <view class="class-status-picker">
              <text>{{classTeacherFilterOptions[classTeacherFilterIndex].label}}</text>
              <view class="student-filter-arrow"></view>
            </view>
          </picker>
          <picker
            mode="selector"
            range="{{classStatusFilterOptions}}"
            range-key="label"
            value="{{classStatusFilterIndex}}"
            bindchange="onClassStatusFilterChange"
          >
            <view class="class-status-picker">
              <text>{{classStatusFilterOptions[classStatusFilterIndex].label}}</text>
              <view class="student-filter-arrow"></view>
            </view>
          </picker>
        </view>
        <view class="class-filter-footer">
          <view class="class-filter-count">共 {{filteredClasses.length}} 个班级</view>
          <view class="class-filter-reset" bindtap="resetClassFilters">重置筛选</view>
        </view>
      </view>

      <view wx:if="{{classUnscheduledCount}}" class="class-warning">
        有 {{classUnscheduledCount}} 个进行中的班级尚未安排后续课次
      </view>

      <view wx:if="{{filteredClasses.length}}" class="class-simple-list">
        <view
          wx:for="{{filteredClasses}}"
          wx:key="id"
          class="class-simple-row"
          data-id="{{item.id}}"
          bindtap="openClassManage"
        >
          <view class="class-simple-main">
            <view class="class-simple-title-row">
              <view class="class-simple-name">{{item.name}}</view>
              <view wx:if="{{!item.upcomingSessionCount && (item.status == 'active' || item.status == 'recruiting')}}" class="class-alert-dot">!</view>
            </view>
            <view class="class-simple-meta">
              <view class="class-meta-item">
                <text class="class-meta-icon">👥</text>
                <text>{{item.students.length}}/{{item.capacity}}</text>
              </view>
              <view class="class-meta-item">
                <text class="class-meta-icon">讲</text>
                <text>{{item.teacherName || '未指定老师'}}</text>
              </view>
            </view>
            <view class="class-simple-course">{{item.courseName}} · {{item.classroomName}}</view>
          </view>
          <view class="class-simple-side">
            <view class="pill subtle">{{item.statusLabel}}</view>
            <view class="class-row-arrow">›</view>
          </view>
        </view>
      </view>
      <view wx:else class="card empty-card">没有符合条件的班级。</view>
    </block>

    <block wx:elif="{{activeView == 'students'}}">
      <view class="student-list-heading">
        <view>
          <view class="section-title">学员</view>
        </view>
        <view wx:if="{{canCreateAcademicRecords}}" class="student-heading-actions">
          <view class="student-create-action" bindtap="openStudentCreate">新增学员</view>
          <view class="student-create-action primary" bindtap="openContractCreate">新增课程档案</view>
        </view>
      </view>
      <view class="card student-filter-card">
        <view class="student-search">
          <view class="student-search-icon">⌕</view>
          <input
            class="student-search-input"
            value="{{studentSearchKeyword}}"
            placeholder="搜索学员姓名"
            confirm-type="search"
            bindinput="onStudentSearchInput"
          />
        </view>
        <view class="student-filter-grid">
          <picker
            mode="selector"
            range="{{studentCampusFilterOptions}}"
            range-key="label"
            value="{{studentCampusFilterIndex}}"
            bindchange="onStudentCampusFilterChange"
          >
            <view class="student-filter-picker">
              <text class="student-filter-value">{{studentCampusFilterOptions[studentCampusFilterIndex].label}}</text>
              <view class="student-filter-arrow"></view>
            </view>
          </picker>
          <picker
            mode="selector"
            range="{{studentClassFilterOptions}}"
            range-key="label"
            value="{{studentClassFilterIndex}}"
            bindchange="onStudentClassFilterChange"
          >
            <view class="student-filter-picker">
              <text class="student-filter-value">{{studentClassFilterOptions[studentClassFilterIndex].label}}</text>
              <view class="student-filter-arrow"></view>
            </view>
          </picker>
          <picker
            mode="selector"
            range="{{studentCourseFilterOptions}}"
            range-key="label"
            value="{{studentCourseFilterIndex}}"
            bindchange="onStudentCourseFilterChange"
          >
            <view class="student-filter-picker">
              <text class="student-filter-value">{{studentCourseFilterOptions[studentCourseFilterIndex].label}}</text>
              <view class="student-filter-arrow"></view>
            </view>
          </picker>
          <picker
            mode="selector"
            range="{{studentLessonFilterOptions}}"
            range-key="label"
            value="{{studentLessonFilterIndex}}"
            bindchange="onStudentLessonFilterChange"
          >
            <view class="student-filter-picker">
              <text class="student-filter-value">{{studentLessonFilterOptions[studentLessonFilterIndex].label}}</text>
              <view class="student-filter-arrow"></view>
            </view>
          </picker>
        </view>
        <view class="student-filter-footer">
          <view>显示 {{studentFilteredCount}} 名学员</view>
          <view class="student-filter-reset" bindtap="resetStudentFilters">重置筛选</view>
        </view>
      </view>

      <view wx:if="{{students.length}}" class="student-compact-list">
        <view
          wx:for="{{students}}"
          wx:key="id"
          class="card student-card student-card-compact student-link"
          data-id="{{item.id}}"
          bindtap="openStudentDetail"
        >
          <view class="student-compact-head">
            <view class="student-name-group">
              <view class="student-compact-name">{{item.name}}</view>
              <view wx:if="{{item.isMyStudent}}" class="student-owner-tag student-owner-tag-mine">我的学员</view>
            </view>
            <view class="student-compact-classes">
              <view
                wx:for="{{item.classes}}"
                wx:for-item="classItem"
                wx:key="id"
                class="{{classItem.isMine ? 'student-class-tag student-class-tag-mine' : 'student-class-tag'}}"
              >
                {{classItem.name}}{{classItem.isMine ? ' · 我的' : (classItem.teacherName ? ' · ' + classItem.teacherName : '')}}
              </view>
              <view wx:if="{{!item.classes.length}}" class="card-meta">暂未加入班级</view>
            </view>
          </view>
          <view class="student-lesson-grid">
            <view
              wx:for="{{item.balances}}"
              wx:for-item="balanceItem"
              wx:key="courseId"
              class="student-lesson-row"
            >
              <view class="student-lesson-course">{{balanceItem.courseName}}</view>
              <view class="student-lesson-count">
                <text>{{balanceItem.lessonCountLabel}}</text>
              </view>
            </view>
            <view wx:if="{{!item.balances.length}}" class="card-meta">暂无课时账户</view>
          </view>
        </view>
      </view>
      <view wx:else class="card empty-card">没有符合当前条件的学员。</view>

      <view wx:if="{{studentTotalPages > 1}}" class="student-pagination">
        <button
          class="student-page-button"
          disabled="{{studentPage <= 1}}"
          bindtap="previousStudentPage"
        >
          上一页
        </button>
        <view class="student-page-status">{{studentPage}} / {{studentTotalPages}}</view>
        <button
          class="student-page-button"
          disabled="{{studentPage >= studentTotalPages}}"
          bindtap="nextStudentPage"
        >
          下一页
        </button>
      </view>
    </block>

    <block wx:elif="{{activeView == 'feedbacks'}}">
      <view class="feedback-filter">
        <view
          wx:for="{{feedbackScopeTabs}}"
          wx:key="key"
          class="{{item.className}}"
          data-key="{{item.key}}"
          bindtap="switchFeedbackScope"
        >
          <view class="feedback-scope-label">{{item.label}}</view>
          <view class="feedback-scope-count">{{item.count}}</view>
        </view>
      </view>
      <view wx:if="{{feedbackEvents.length}}" class="list">
        <view
          wx:for="{{feedbackEvents}}"
          wx:key="id"
          class="card compact-card feedback-event-card {{item.canOperate ? 'is-operable' : ''}}"
          data-id="{{item.id}}"
          bindtap="openFeedback"
        >
          <view class="row-between">
            <view>
              <view class="card-title">{{item.className}} · {{item.title}}</view>
              <view class="card-meta">{{item.dateLabel}} · {{item.timeLabel}} · {{item.courseName}} · {{item.scopeLabel}}</view>
            </view>
            <view class="pill">{{item.interactionStatusLabel}}</view>
          </view>
          <view class="session-foot">
            <view class="card-meta">{{item.classroomName}}</view>
            <button
              wx:if="{{item.canOperate}}"
              class="mini-button"
              data-id="{{item.id}}"
              catchtap="openFeedback"
            >
              {{item.interactionActionLabel}}
            </button>
            <view wx:else class="pill subtle">仅查看</view>
          </view>
        </view>
      </view>
      <view wx:else class="card empty-card">{{feedbackEmptyText}}</view>
    </block>

    <block wx:else>
      <view class="section-title">任务批阅</view>
      <view wx:if="{{homeworkCheckIns.length}}" class="list">
        <view wx:for="{{homeworkCheckIns}}" wx:key="id" class="card compact-card">
          <view class="row-between">
            <view>
              <view class="card-title">{{item.studentName}} · {{item.courseName}}</view>
              <view class="card-meta">{{item.className}} · {{item.dateLabel}} · {{item.scopeLabel}}</view>
            </view>
            <view class="pill">{{item.statusLabel}}</view>
          </view>
          <view wx:if="{{item.content}}" class="content-text">{{item.content}}</view>
          <view wx:if="{{item.imageUrls.length}}" class="homework-images">
            <image
              wx:for="{{item.imageUrls}}"
              wx:key="*this"
              class="homework-image"
              src="{{item}}"
              mode="aspectFill"
              data-url="{{item}}"
              bindtap="previewImage"
            />
          </view>
          <view wx:if="{{item.teacherFeedback}}" class="teacher-feedback">{{item.teacherFeedback}}</view>
          <view class="session-foot">
            <view class="card-meta">{{item.reviewer ? '批阅：' + item.reviewer.name : ''}}</view>
            <button class="mini-button" data-id="{{item.id}}" bindtap="openReview">批阅</button>
          </view>
        </view>
      </view>
      <view wx:else class="card empty-card">暂无任务打卡。</view>
    </block>
  </block>

  <view wx:if="{{trialScheduleVisible}}" class="sheet-mask" bindtap="closeTrialSchedule">
    <view class="work-sheet academic-sheet trial-schedule-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-title">安排试听</view>
          <view class="sheet-meta">指定试听课程、老师和确定时间</view>
        </view>
        <view class="sheet-close-icon" aria-role="button" aria-label="关闭" bindtap="closeTrialSchedule">×</view>
      </view>
      <scroll-view class="sheet-scroll academic-scroll" scroll-y>
        <view class="academic-form">
          <view class="form-label">试听标题</view>
          <input
            class="academic-input"
            value="{{trialScheduleForm.title}}"
            data-field="title"
            bindinput="onTrialScheduleInput"
            placeholder="请输入试听标题"
          />
          <view class="form-label">课程</view>
          <picker
            mode="selector"
            range="{{trialCourses}}"
            range-key="name"
            value="{{trialScheduleCourseIndex}}"
            bindchange="onTrialScheduleCourseChange"
          >
            <view class="academic-picker">{{trialCourses[trialScheduleCourseIndex].name || '选择课程'}}</view>
          </picker>
          <view class="form-two-cols">
            <view>
              <view class="form-label">校区</view>
              <picker
                mode="selector"
                range="{{trialCampuses}}"
                range-key="name"
                value="{{trialScheduleCampusIndex}}"
                bindchange="onTrialScheduleCampusChange"
              >
                <view class="academic-picker">{{trialCampuses[trialScheduleCampusIndex].name || '选择校区'}}</view>
              </picker>
            </view>
            <view>
              <view class="form-label">授课老师</view>
              <picker
                mode="selector"
                range="{{trialTeachers}}"
                range-key="name"
                value="{{trialScheduleTeacherIndex}}"
                bindchange="onTrialScheduleTeacherChange"
              >
                <view class="academic-picker">{{trialTeachers[trialScheduleTeacherIndex].name || '选择老师'}}</view>
              </picker>
            </view>
          </view>
          <view class="form-label">试听日期</view>
          <picker
            mode="date"
            value="{{trialScheduleForm.date}}"
            data-field="date"
            bindchange="onTrialScheduleInput"
          >
            <view class="academic-picker">{{trialScheduleForm.date || '选择日期'}}</view>
          </picker>
          <view class="form-two-cols">
            <view>
              <view class="form-label">开始时间</view>
              <picker
                mode="time"
                value="{{trialScheduleForm.startsAt}}"
                data-field="startsAt"
                bindchange="onTrialScheduleInput"
              >
                <view class="academic-picker">{{trialScheduleForm.startsAt || '开始时间'}}</view>
              </picker>
            </view>
            <view>
              <view class="form-label">结束时间</view>
              <picker
                mode="time"
                value="{{trialScheduleForm.endsAt}}"
                data-field="endsAt"
                bindchange="onTrialScheduleInput"
              >
                <view class="academic-picker">{{trialScheduleForm.endsAt || '结束时间'}}</view>
              </picker>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{trialScheduleError}}" class="sheet-error">{{trialScheduleError}}</view>
      <button
        class="btn btn-primary sheet-submit"
        loading="{{trialScheduleSaving}}"
        disabled="{{trialScheduleSaving}}"
        bindtap="submitTrialSchedule"
      >
        {{trialScheduleSaving ? '创建中...' : '确认并创建试听课次'}}
      </button>
    </view>
  </view>

  <view wx:if="{{rollCallVisible}}" class="sheet-mask" bindtap="closeRollCall">
    <view class="work-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-title">点名</view>
          <view wx:if="{{rollCallSession}}" class="sheet-meta">
            {{rollCallSession.className}} · {{rollCallSession.courseName}}
          </view>
        </view>
        <view class="sheet-close-icon" aria-role="button" aria-label="关闭" bindtap="closeRollCall">×</view>
      </view>
      <view wx:if="{{rollCallSession}}" class="sheet-session">
        <view class="sheet-time">{{rollCallSession.timeLabel}}</view>
        <view class="sheet-date">{{rollCallSession.dateLabel}}</view>
        <view class="sheet-desc">{{rollCallSession.title}} · {{rollCallSession.classroomName}} · 本次扣 {{rollCallSession.lessonUnits}} 课时</view>
      </view>
      <view class="roll-summary">
        <view>
          <view class="roll-num">{{rollCallSummary.present}}</view>
          <view class="roll-label">到课</view>
        </view>
        <view>
          <view class="roll-num">{{rollCallSummary.late}}</view>
          <view class="roll-label">迟到</view>
        </view>
        <view>
          <view class="roll-num">{{rollCallSummary.leave}}</view>
          <view class="roll-label">请假</view>
        </view>
        <view>
          <view class="roll-num">{{rollCallSummary.absent}}</view>
          <view class="roll-label">未到</view>
        </view>
      </view>
      <scroll-view class="sheet-scroll" scroll-y>
        <view wx:if="{{rollCallLoading}}" class="sheet-loading">正在加载名单...</view>
        <view wx:elif="{{rollCallRows.length}}" class="sheet-list">
          <view wx:for="{{rollCallRows}}" wx:for-item="student" wx:key="id" class="roll-row">
            <view class="roll-student">
              <view>
                <view class="roll-name">{{student.name}}</view>
                <view class="roll-grade">{{student.grade}}</view>
              </view>
              <view wx:if="{{student.recorded}}" class="recorded-pill">{{student.statusLabel}}</view>
            </view>
            <view class="status-grid">
              <view
                wx:for="{{attendanceStatusOptions}}"
                wx:for-item="option"
                wx:key="value"
                class="status-option {{student.draftStatus == option.value ? 'status-option-active' : ''}} {{student.recorded ? 'status-option-disabled' : ''}}"
                aria-role="button"
                data-id="{{student.id}}"
                data-status="{{option.value}}"
                bindtap="selectRollCallStatus"
              >
                {{option.label}}
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="sheet-empty">本场暂无成员。</view>
      </scroll-view>
      <view wx:if="{{rollCallError}}" class="sheet-error">{{rollCallError}}</view>
      <button
        class="btn btn-primary sheet-submit"
        loading="{{rollCallSaving}}"
        disabled="{{rollCallSaving || rollCallLoading}}"
        bindtap="submitRollCall"
      >
        {{rollCallSaving ? '保存中...' : '完成点名'}}
      </button>
    </view>
  </view>

  <view wx:if="{{feedbackVisible}}" class="sheet-mask" bindtap="closeFeedback">
    <view class="work-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-title">课程互动</view>
          <view wx:if="{{feedbackSession}}" class="sheet-meta">
            {{feedbackSession.className}} · {{feedbackSession.courseName}}
          </view>
        </view>
        <view class="sheet-close-icon" aria-role="button" aria-label="关闭" bindtap="closeFeedback">×</view>
      </view>
      <view wx:if="{{feedbackSession}}" class="sheet-session">
        <view class="sheet-time">{{feedbackSession.timeLabel}}</view>
        <view class="sheet-date">{{feedbackSession.dateLabel}}</view>
        <view class="sheet-desc">{{feedbackSession.title}} · {{feedbackSession.classroomName}}</view>
      </view>
      <scroll-view class="sheet-scroll feedback-scroll" scroll-y>
        <view wx:if="{{feedbackLoading}}" class="sheet-loading">正在加载互动名单...</view>
        <view wx:elif="{{feedbackRows.length}}" class="sheet-list">
          <view class="assignment-box">
            <view class="assignment-head">
              <view class="roll-name">班级任务</view>
              <view class="card-meta">不填则不布置统一任务</view>
            </view>
            <view class="template-row">
              <view
                wx:for="{{assignmentTemplates}}"
                wx:key="*this"
                class="template-chip"
                data-value="{{item}}"
                bindtap="applyAssignmentTemplate"
              >
                {{item}}
              </view>
            </view>
            <textarea
              class="feedback-input assignment-input"
              value="{{classAssignmentContent}}"
              bindinput="updateClassAssignment"
              placeholder="班级统一任务"
              maxlength="2000"
            />
          </view>
          <view wx:for="{{feedbackRows}}" wx:for-item="student" wx:key="id" class="feedback-row">
            <view class="roll-name">{{student.name}} · {{student.grade}}</view>
            <view class="star-row">
              <view
                wx:for="{{starOptions}}"
                wx:key="*this"
                class="star {{student.rating >= item ? 'star-active' : ''}}"
                data-id="{{student.id}}"
                data-rating="{{item}}"
                bindtap="selectFeedbackRating"
              >
                ★
              </view>
              <view class="star-hint">{{student.rating ? student.rating + ' 星' : '未评分'}}</view>
            </view>
            <textarea
              class="feedback-input"
              value="{{student.content}}"
              data-id="{{student.id}}"
              bindinput="updateFeedbackContent"
              placeholder="课堂表现、掌握情况、后续建议，可不填"
              maxlength="2000"
            />
            <view class="personal-assignment-toggle" data-id="{{student.id}}" bindtap="togglePersonalAssignment">
              {{student.personalAssignmentEnabled ? '取消单独任务' : '单独课后作业'}}
            </view>
            <textarea
              wx:if="{{student.personalAssignmentEnabled}}"
              class="feedback-input assignment-input"
              value="{{student.assignmentContent}}"
              data-id="{{student.id}}"
              bindinput="updateStudentAssignment"
              placeholder="该成员的单独任务，会覆盖全组任务"
              maxlength="2000"
            />
            <view wx:if="{{student.imageUrls.length}}" class="homework-images">
              <image
                wx:for="{{student.imageUrls}}"
                wx:key="*this"
                class="homework-image"
                src="{{item}}"
                mode="aspectFill"
                data-url="{{item}}"
                bindtap="previewImage"
              />
            </view>
          </view>
        </view>
        <view wx:else class="sheet-empty">本场暂无正式成员。</view>
      </scroll-view>
      <view wx:if="{{feedbackError}}" class="sheet-error">{{feedbackError}}</view>
      <button
        class="btn btn-primary sheet-submit"
        loading="{{feedbackSaving}}"
        disabled="{{feedbackSaving || feedbackLoading}}"
        bindtap="submitFeedback"
      >
        {{feedbackSaving ? '保存中...' : '保存互动'}}
      </button>
    </view>
  </view>

  <view wx:if="{{reviewVisible}}" class="sheet-mask" bindtap="closeReview">
    <view class="work-sheet review-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-title">批阅任务</view>
          <view wx:if="{{reviewTarget}}" class="sheet-meta">
            {{reviewTarget.studentName}} · {{reviewTarget.courseName}}
          </view>
        </view>
        <view class="sheet-close-icon" aria-role="button" aria-label="关闭" bindtap="closeReview">×</view>
      </view>
      <scroll-view class="sheet-scroll feedback-scroll" scroll-y>
        <block wx:if="{{reviewTarget}}">
          <view class="review-origin">
            <view class="card-meta">{{reviewTarget.className}} · {{reviewTarget.dateLabel}}</view>
            <view wx:if="{{reviewTarget.content}}" class="content-text">{{reviewTarget.content}}</view>
            <view wx:if="{{reviewTarget.imageUrls.length}}" class="homework-images">
              <image
                wx:for="{{reviewTarget.imageUrls}}"
                wx:key="*this"
                class="homework-image"
                src="{{item}}"
                mode="aspectFill"
                data-url="{{item}}"
                bindtap="previewImage"
              />
            </view>
          </view>
          <view class="review-status-row">
            <button
              class="review-status {{reviewStatus == 'reviewed' ? 'review-status-active' : ''}}"
              data-status="reviewed"
              bindtap="selectReviewStatus"
            >
              已批阅
            </button>
            <button
              class="review-status {{reviewStatus == 'needs_revision' ? 'review-status-active' : ''}}"
              data-status="needs_revision"
              bindtap="selectReviewStatus"
            >
              需订正
            </button>
          </view>
          <view class="star-row review-star-row">
            <view
              wx:for="{{starOptions}}"
              wx:key="*this"
              class="star {{reviewRating >= item ? 'star-active' : ''}}"
              data-rating="{{item}}"
              bindtap="selectReviewRating"
            >
              ★
            </view>
            <view class="star-hint">{{reviewRating ? reviewRating + ' 星' : '未评分'}}</view>
          </view>
          <textarea
            wx:if="{{reviewStatus == 'needs_revision'}}"
            class="feedback-input review-input"
            value="{{teacherFeedback}}"
            bindinput="updateTeacherFeedback"
            placeholder="填写练习建议或订正要求"
            maxlength="2000"
          />
          <view wx:else class="review-ok-hint">确认通过后，成长中心会看到任务已批阅。</view>
        </block>
      </scroll-view>
      <view wx:if="{{reviewError}}" class="sheet-error">{{reviewError}}</view>
      <button
        class="btn btn-primary sheet-submit"
        loading="{{reviewSaving}}"
        disabled="{{reviewSaving}}"
        bindtap="submitReview"
      >
        {{reviewSaving ? '保存中...' : '保存批阅'}}
      </button>
    </view>
  </view>

  <view wx:if="{{studentCreateVisible}}" class="sheet-mask" bindtap="closeStudentCreate">
    <view class="work-sheet academic-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-title">新增学员档案</view>
        </view>
        <view class="sheet-close-icon" aria-role="button" aria-label="关闭" bindtap="closeStudentCreate">×</view>
      </view>
      <scroll-view class="sheet-scroll academic-scroll" scroll-y>
        <view class="academic-form">
          <view class="form-label">学员姓名</view>
          <input class="academic-input" value="{{studentCreateForm.name}}" data-field="name" bindinput="onStudentCreateInput" placeholder="请输入学员姓名" />
          <view class="form-label">年级</view>
          <input class="academic-input" value="{{studentCreateForm.grade}}" data-field="grade" bindinput="onStudentCreateInput" placeholder="如：三年级" />
          <view class="form-label">学校</view>
