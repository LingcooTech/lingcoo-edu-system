      <view wx:if="{{studentCreateError}}" class="sheet-error">{{studentCreateError}}</view>
      <button
        class="btn btn-primary sheet-submit"
        loading="{{studentCreateSaving}}"
        disabled="{{studentCreateSaving}}"
        bindtap="submitStudentCreate"
      >
        {{studentCreateSaving ? '保存中...' : '保存学员档案'}}
      </button>
    </view>
  </view>

  <view wx:if="{{contractCreateVisible}}" class="sheet-mask" bindtap="closeContractCreate">
    <view class="work-sheet academic-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-title">新增正式课程档案</view>
          <view class="sheet-meta">创建后会生成线下已支付订单和课时余额</view>
        </view>
        <view class="sheet-close-icon" aria-role="button" aria-label="关闭" bindtap="closeContractCreate">×</view>
      </view>
      <scroll-view class="sheet-scroll academic-scroll" scroll-y>
        <view class="academic-form">
          <view class="form-label">学员</view>
          <view class="contract-student-search">
            <view class="student-search-icon">⌕</view>
            <input
              class="contract-student-input"
              value="{{contractStudentKeyword}}"
              bindinput="onContractStudentSearchInput"
              placeholder="搜索学员姓名、班级或课程"
              confirm-type="search"
            />
          </view>
          <view wx:if="{{contractStudentName}}" class="contract-selected-student">已选择：{{contractStudentName}}</view>
          <view wx:if="{{contractFilteredStudentOptions.length}}" class="contract-student-list">
            <view
              wx:for="{{contractFilteredStudentOptions}}"
              wx:key="id"
              class="contract-student-row {{contractStudentId == item.id ? 'contract-student-row-active' : ''}}"
              data-id="{{item.id}}"
              bindtap="selectContractStudent"
            >
              <view class="{{contractStudentId == item.id ? 'check check-active' : 'check'}}">{{contractStudentId == item.id ? '✓' : ''}}</view>
              <view class="contract-student-name">{{item.label}}</view>
            </view>
          </view>
          <view wx:else class="contract-student-empty">没有匹配的学员</view>
          <view class="form-label">正式课程</view>
          <picker mode="selector" range="{{contractCourseOptions}}" range-key="label" value="{{contractCourseIndex}}" bindchange="onContractCourseChange">
            <view class="academic-picker">{{contractCourseOptions[contractCourseIndex].label}}</view>
          </picker>
          <view class="form-label">课时包</view>
          <picker mode="selector" range="{{contractPackageOptions}}" range-key="label" value="{{contractPackageIndex}}" bindchange="onContractPackageChange">
            <view class="academic-picker">{{contractPackageOptions[contractPackageIndex].label}}</view>
          </picker>
          <view class="form-label">档案标题</view>
          <input class="academic-input" value="{{contractForm.title}}" data-field="title" bindinput="onContractInput" placeholder="可不填，默认使用课程名" />
          <view class="form-two-cols">
            <view>
              <view class="form-label">{{contractPackageOptions[contractPackageIndex].billingType == 'period' ? '周期课时上限' : '课时数'}}</view>
              <input class="academic-input" type="number" value="{{contractForm.lessonCount}}" data-field="lessonCount" bindinput="onContractInput" placeholder="必填" />
            </view>
            <view>
              <view class="form-label">实收金额(元)</view>
              <input class="academic-input" type="digit" value="{{contractForm.paidYuan}}" data-field="paidYuan" bindinput="onContractInput" placeholder="0" />
            </view>
          </view>
          <view class="form-label">班级</view>
          <picker mode="selector" range="{{contractClassOptions}}" range-key="label" value="{{contractClassIndex}}" bindchange="onContractClassChange">
            <view class="academic-picker">{{contractClassOptions[contractClassIndex].label}}</view>
          </picker>
          <view class="form-label">支付方式</view>
          <picker mode="selector" range="{{paymentMethodOptions}}" range-key="label" value="{{paymentMethodIndex}}" bindchange="onContractPaymentMethodChange">
            <view class="academic-picker">{{paymentMethodOptions[paymentMethodIndex].label}}</view>
          </picker>
          <view class="form-two-cols">
            <view>
              <view class="form-label">开始日期</view>
              <picker mode="date" value="{{contractForm.startsAt}}" data-field="startsAt" bindchange="onContractDateChange">
                <view class="academic-picker">{{contractForm.startsAt || '选择开始日期'}}</view>
              </picker>
            </view>
            <view>
              <view class="form-label">结束日期</view>
              <picker mode="date" value="{{contractForm.endsAt}}" data-field="endsAt" bindchange="onContractDateChange" disabled="{{contractPackageOptions[contractPackageIndex].billingType == 'period'}}">
                <view class="academic-picker">{{contractForm.endsAt || '选择结束日期'}}</view>
              </picker>
              <view wx:if="{{contractPackageOptions[contractPackageIndex].billingType == 'period'}}" class="form-hint">按周期自动计算</view>
            </view>
          </view>
          <view class="form-label">备注</view>
          <textarea class="academic-textarea" value="{{contractForm.note}}" data-field="note" bindinput="onContractInput" placeholder="可不填" maxlength="500" />
        </view>
      </scroll-view>
      <view wx:if="{{contractCreateError}}" class="sheet-error">{{contractCreateError}}</view>
      <button
        class="btn btn-primary sheet-submit"
        loading="{{contractCreateSaving}}"
        disabled="{{contractCreateSaving}}"
        bindtap="submitContractCreate"
      >
        {{contractCreateSaving ? '创建中...' : '创建课程档案'}}
      </button>
    </view>
  </view>
</view>
