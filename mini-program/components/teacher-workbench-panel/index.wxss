.teacher-workbench {
  display: block;
  padding-bottom: 24rpx;
}

.summary-card {
  overflow: hidden;
  border: 0;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(208, 225, 255, 0.7), rgba(208, 225, 255, 0) 36%),
    linear-gradient(180deg, #ffffff 0%, #f8f3ed 100%);
  padding: 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
}

.summary-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 22rpx;
}

.summary-head > view:first-child {
  min-width: 0;
}

.summary-titlebar {
  position: relative;
  display: block;
  min-width: 0;
  padding-right: 168rpx;
}

.summary-titlebar > view:first-child {
  min-width: 0;
}

.summary-eyebrow {
  color: #6b6258;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
}

.summary-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
}

.role-switch-button {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  box-sizing: border-box;
  width: 148rpx;
  height: 46rpx;
  min-width: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #35312d 0%, #211f1c 100%);
  box-shadow: 0 4rpx 12rpx rgba(33, 31, 28, 0.14);
  color: #fff;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1;
  margin: 0 0 0 auto;
  padding: 0 14rpx;
}

.role-switch-button:active {
  opacity: 0.86;
}

.role-switch-button.is-disabled {
  opacity: 0.68;
}

.role-switch-spinner {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.38);
  border-top-color: #fff;
  border-radius: 50%;
  animation: role-switch-spin 0.8s linear infinite;
}

@keyframes role-switch-spin {
  to {
    transform: rotate(360deg);
  }
}

.scope-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(33, 31, 28, 0.1);
  border-radius: 999rpx;
  background: rgba(246, 244, 240, 0.9);
  padding: 6rpx;
}

.scope {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 52rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: transparent;
  color: #57534e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  margin: 0;
  padding: 0;
  text-align: center;
}

.scope::after,
.quick-action::after,
.day::after {
  border: 0;
}

.scope-active {
  background: #211f1c;
  color: #fff;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 30rpx;
  text-align: center;
}

.summary-item {
  min-width: 0;
}

.summary-action {
  border-radius: 18rpx;
  padding: 10rpx 4rpx;
}

.summary-action:active {
  background: rgba(154, 106, 75, 0.08);
}

.calendar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: auto;
}

.schedule-add-button {
  display: flex;
  width: 146rpx;
  max-width: 146rpx;
  height: 48rpx;
  flex: 0 0 146rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1;
  margin: 0 0 0 auto;
  padding: 0;
}

.schedule-add-button::after {
  border: 0;
}

.class-manage-button {
  height: 56rpx;
  margin: 20rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 21rpx;
  font-weight: 850;
  line-height: 56rpx;
}

.class-manage-button::after {
  border: 0;
}

.class-list-heading {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 30rpx 0 16rpx;
}

.class-list-heading .section-title {
  flex: 1;
  margin: 0;
  line-height: 1.2;
}

.class-create-button {
  display: flex;
  box-sizing: border-box;
  width: 158rpx;
  max-width: 158rpx;
  height: 48rpx;
  min-width: 158rpx;
  flex: 0 0 158rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1;
  margin: 0 0 0 auto;
  padding: 0;
}

.class-create-button::after {
  border: 0;
}

.class-filter-card {
  margin-bottom: 16rpx;
  padding: 18rpx;
}

.class-filter-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 12rpx;
}

.class-filter-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.35;
}

.class-filter-count {
  min-width: 0;
}

.class-filter-reset {
  flex-shrink: 0;
  color: #9a6a4b;
  font-weight: 850;
}

.class-filter-grid > picker {
  display: block;
  min-width: 0;
  height: 68rpx;
  line-height: normal;
}

.class-search {
  display: flex;
  min-width: 0;
  height: 68rpx;
  align-items: center;
  gap: 10rpx;
  border-radius: 18rpx;
  background: #f7f5f2;
  padding: 0 16rpx;
}

.class-search-input {
  min-width: 0;
  height: 68rpx;
  flex: 1;
  color: #211f1c;
  font-size: 23rpx;
}

.class-status-picker {
  display: flex;
  height: 68rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  border-radius: 18rpx;
  background: #f7f5f2;
  color: #211f1c;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  padding: 0 16rpx;
}

.class-status-picker text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-warning {
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  background: #fff1dc;
  color: #b76527;
  font-size: 22rpx;
  font-weight: 750;
  padding: 18rpx 20rpx;
}

.class-simple-list {
  overflow: hidden;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.class-simple-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #eeeae5;
  padding: 24rpx 22rpx;
}

.class-simple-row:last-child {
  border-bottom: 0;
}

.class-simple-row:active {
  background: #f8f5f1;
}

.class-simple-main {
  min-width: 0;
  flex: 1;
}

.class-simple-title-row,
.class-simple-meta,
.class-meta-item,
.class-simple-side {
  display: flex;
  align-items: center;
}

.class-simple-title-row {
  gap: 9rpx;
}

.class-simple-name {
  overflow: hidden;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-alert-dot {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #e6534b;
  color: #fff;
  font-size: 19rpx;
  font-weight: 900;
}

.class-simple-meta {
  gap: 28rpx;
  margin-top: 12rpx;
  color: #7c756d;
  font-size: 22rpx;
}

.class-meta-item {
  min-width: 0;
  gap: 8rpx;
}

.class-meta-icon {
  color: #b9784f;
  font-size: 20rpx;
  font-weight: 900;
}

.class-simple-course {
  margin-top: 8rpx;
  overflow: hidden;
  color: #9a948b;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-simple-side {
  flex-shrink: 0;
  flex-direction: column;
  gap: 12rpx;
}

.class-row-arrow {
  color: #aaa39b;
  font-size: 36rpx;
  line-height: 1;
}

.summary-value {
  color: #211f1c;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18rpx 8rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 26rpx 12rpx 22rpx;
}

.quick-action {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 126rpx;
  flex-direction: column;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  color: #211f1c;
  line-height: 1.25;
  margin: 0;
  padding: 8rpx 4rpx;
  overflow: visible;
  text-align: center;
}

.quick-action-active {
  background: transparent;
  color: #9a6a4b;
}

.quick-icon {
  position: relative;
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
}

.quick-icon-image {
  display: block;
  width: 60rpx;
  height: 60rpx;
}

.quick-badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 32rpx;
  border: 4rpx solid #fff;
  border-radius: 999rpx;
  background: #ef4f4f;
  color: #fff;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 32rpx;
  padding: 0 6rpx;
  text-align: center;
}

.quick-label {
  width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action-active .quick-label {
  color: #9a6a4b;
  font-weight: 850;
}

.notice-panel {
  margin-top: 24rpx;
}

.notice-panel-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.notice-title {
  margin: 0;
}

.notice-subtitle {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.notice-list {
  display: grid;
  gap: 14rpx;
  margin-top: 16rpx;
}

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 24rpx;
  background: #fff;
  padding: 22rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(33, 31, 28, 0.05);
}

.notice-card-unread {
  border: 1rpx solid rgba(154, 106, 75, 0.18);
  background: #fffaf4;
}

.notice-card-title {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.notice-card-body {
  margin-top: 6rpx;
  color: #57534e;
  font-size: 23rpx;
  line-height: 1.45;
}

.notice-card-date {
  margin-top: 8rpx;
  color: #9a948b;
  font-size: 21rpx;
}

.notice-action {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #211f1c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 850;
  padding: 10rpx 18rpx;
}

.section-title {
  margin: 32rpx 0 16rpx;
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.schedule-title {
  margin-top: 38rpx;
}

.today-reminder-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  border: 0;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 92% 16%, rgba(255, 224, 143, 0.52), rgba(255, 224, 143, 0) 34%), #fff;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.today-reminder-title {
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.today-reminder-count {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #211f1c;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.list {
  display: grid;
  gap: 18rpx;
}

.compact-card,
.class-card,
.student-card {
  padding: 28rpx;
}

.card-title {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.4;
}

.card-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 16rpx;
}

.pill.subtle {
  background: #f6f4f0;
  color: #57534e;
}

.empty-card {
  padding: 34rpx;
  color: #8b857c;
  font-size: 26rpx;
}

.feedback-filter {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin: 28rpx 0 18rpx;
}

.feedback-scope {
  display: flex;
  min-width: 0;
  min-height: 82rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(33, 31, 28, 0.06);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 4rpx 12rpx rgba(33, 31, 28, 0.04);
  color: #57534e;
}

.feedback-scope-active {
  border-color: rgba(154, 106, 75, 0.2);
  background: #211f1c;
  color: #fff;
}

.feedback-scope-label {
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
}

.feedback-scope-count {
  margin-top: 6rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  opacity: 0.72;
}

.calendar-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff;
  margin-top: 24rpx;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx 4rpx;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
}

.calendar-toggle {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f6f4f0;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 850;
  padding: 8rpx 18rpx;
}

.date-strip {
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
  background: rgba(255, 255, 255, 0.82);
  white-space: nowrap;
}

.date-strip-track {
  display: inline-flex;
  gap: 8rpx;
  padding: 18rpx 16rpx;
}

.date-strip .day {
  width: 94rpx;
  min-width: 94rpx;
}

.month-weekdays,
.month-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  width: 100%;
  box-sizing: border-box;
}

.month-weekdays {
  gap: 6rpx;
  padding: 18rpx 16rpx 6rpx;
  color: #8b857c;
  font-size: 21rpx;
  font-weight: 850;
  text-align: center;
}

.month-grid {
  gap: 6rpx;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
  padding: 8rpx 16rpx 18rpx;
}

.month-day {
  display: flex;
  min-width: 0;
  min-height: 82rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: transparent;
}

.month-day-muted {
  opacity: 0.34;
}

.month-day-active {
  background: #9a6a4b;
  opacity: 1;
  box-shadow: 0 8rpx 18rpx rgba(154, 106, 75, 0.18);
}

.month-day-num {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
}

.month-day-count {
  min-height: 22rpx;
  margin-top: 8rpx;
  color: #9a6a4b;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.month-day-active .month-day-num,
.month-day-active .month-day-count {
  color: #fff;
}

.day {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 116rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: transparent;
  color: #211f1c;
  font-size: 24rpx;
  line-height: 1.2;
  margin: 0;
  padding: 0;
}

.day-active {
  background: #9a6a4b;
  color: #9a6a4b;
  box-shadow: 0 8rpx 18rpx rgba(154, 106, 75, 0.18);
}

.day-active .day-label,
.day-active .day-num {
  color: #fff;
}

.day-has .day-num::after,
.day-active .day-num::after {
  display: block;
  width: 8rpx;
  height: 8rpx;
  margin: 8rpx auto 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  content: '';
}

.day-active .day-num::after {
  background: #fff;
}

.day-label {
  color: #8b857c;
  font-size: 22rpx;
  font-weight: 900;
}

.day-num {
  margin-top: 18rpx;
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.session-row {
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
}

.session-row:last-child {
  border-bottom: 0;
}

.session-time {
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
}

.session-class {
  margin-top: 6rpx;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.status-text {
  color: #57534e;
  font-size: 24rpx;
}

.session-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.session-foot .card-meta {
  flex: 1;
}

.session-quick-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
}

.session-quick-actions .mini-button {
  width: auto;
  min-width: 108rpx;
  height: 54rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  line-height: 54rpx;
  padding: 0 20rpx;
}

.session-attendance-button {
  background: #9a6a4b;
  color: #fff;
}

.session-roster-button {
  background: #efe5dc;
  color: #7c5138;
}

.class-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
  text-align: center;
}

.stat-num {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.student-mini-list {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.student-mini,
.balance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  padding: 18rpx 20rpx;
}

