.teacher-workbench {
  display: block;
  padding-bottom: 24rpx;
}

.summary-card {
  overflow: hidden;
  border: 0;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(208, 225, 255, 0.7), rgba(208, 225, 255, 0) 36%),
    linear-gradient(180deg, #ffffff 0%, #f8f3ed 100%);
  padding: 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
}

.summary-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 22rpx;
}

.summary-head > view:first-child {
  min-width: 0;
}

.summary-eyebrow {
  color: #6b6258;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
}

.summary-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
}

.scope-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(33, 31, 28, 0.1);
  border-radius: 999rpx;
  background: rgba(246, 244, 240, 0.9);
  padding: 6rpx;
}

.scope {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 52rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: transparent;
  color: #57534e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  margin: 0;
  padding: 0;
  text-align: center;
}

.scope::after,
.tab::after,
.day::after {
  border: 0;
}

.scope-active {
  background: #211f1c;
  color: #fff;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 30rpx;
  text-align: center;
}

.summary-item {
  min-width: 0;
}

.summary-action {
  border-radius: 18rpx;
  padding: 10rpx 4rpx;
}

.summary-action:active {
  background: rgba(154, 106, 75, 0.08);
}

.summary-value {
  color: #211f1c;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.tabs {
  display: flex;
  flex-wrap: nowrap;
  gap: 0;
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 12rpx 4rpx;
}

.tab {
  display: flex;
  width: 20%;
  min-width: 0;
  max-width: 20%;
  min-height: 112rpx;
  flex: 0 0 20%;
  flex-direction: column;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  color: #211f1c;
  line-height: 1.25;
  margin: 0;
  padding: 10rpx 4rpx;
  overflow: hidden;
  text-align: center;
}

.tab-active {
  background: transparent;
  color: #9a6a4b;
}

.tab-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f7e8dc;
}

.tab-active .tab-icon {
  background: #f7e8dc;
}

.tab-icon-image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tab-label {
  width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  color: #211f1c;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-active .tab-label {
  color: #9a6a4b;
  font-weight: 850;
}

.notice-panel {
  margin-top: 24rpx;
}

.notice-panel-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.notice-title {
  margin: 0;
}

.notice-subtitle {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.notice-list {
  display: grid;
  gap: 14rpx;
  margin-top: 16rpx;
}

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 24rpx;
  background: #fff;
  padding: 22rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(33, 31, 28, 0.05);
}

.notice-card-unread {
  border: 1rpx solid rgba(154, 106, 75, 0.18);
  background: #fffaf4;
}

.notice-card-title {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.notice-card-body {
  margin-top: 6rpx;
  color: #57534e;
  font-size: 23rpx;
  line-height: 1.45;
}

.notice-card-date {
  margin-top: 8rpx;
  color: #9a948b;
  font-size: 21rpx;
}

.notice-action {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #211f1c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 850;
  padding: 10rpx 18rpx;
}

.section-title {
  margin: 32rpx 0 16rpx;
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.schedule-title {
  margin-top: 38rpx;
}

.today-reminder-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  border: 0;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 92% 16%, rgba(255, 224, 143, 0.52), rgba(255, 224, 143, 0) 34%),
    #fff;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.today-reminder-title {
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.today-reminder-count {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #211f1c;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.list {
  display: grid;
  gap: 18rpx;
}

.compact-card,
.class-card,
.student-card {
  padding: 28rpx;
}

.card-title {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.4;
}

.card-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 16rpx;
}

.pill.subtle {
  background: #f6f4f0;
  color: #57534e;
}

.empty-card {
  padding: 34rpx;
  color: #8b857c;
  font-size: 26rpx;
}

.feedback-filter {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin: 28rpx 0 18rpx;
}

.feedback-scope {
  display: flex;
  min-width: 0;
  min-height: 82rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(33, 31, 28, 0.06);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 4rpx 12rpx rgba(33, 31, 28, 0.04);
  color: #57534e;
}

.feedback-scope-active {
  border-color: rgba(154, 106, 75, 0.2);
  background: #211f1c;
  color: #fff;
}

.feedback-scope-label {
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
}

.feedback-scope-count {
  margin-top: 6rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  opacity: 0.72;
}

.calendar-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff;
  margin-top: 24rpx;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx 4rpx;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
}

.calendar-toggle {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f6f4f0;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 850;
  padding: 8rpx 18rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
  padding: 18rpx 16rpx;
  background: rgba(255, 255, 255, 0.82);
}

.month-weekdays,
.month-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  width: 100%;
  box-sizing: border-box;
}

.month-weekdays {
  gap: 6rpx;
  padding: 18rpx 16rpx 6rpx;
  color: #8b857c;
  font-size: 21rpx;
  font-weight: 850;
  text-align: center;
}

.month-grid {
  gap: 6rpx;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
  padding: 8rpx 16rpx 18rpx;
}

.month-day {
  display: flex;
  min-width: 0;
  min-height: 82rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: transparent;
}

.month-day-muted {
  opacity: 0.34;
}

.month-day-active {
  background: #9a6a4b;
  opacity: 1;
  box-shadow: 0 8rpx 18rpx rgba(154, 106, 75, 0.18);
}

.month-day-num {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
}

.month-day-count {
  min-height: 22rpx;
  margin-top: 8rpx;
  color: #9a6a4b;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.month-day-active .month-day-num,
.month-day-active .month-day-count {
  color: #fff;
}

.day {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 116rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: transparent;
  color: #211f1c;
  font-size: 24rpx;
  line-height: 1.2;
  margin: 0;
  padding: 0;
}

.day-active {
  background: #9a6a4b;
  color: #9a6a4b;
  box-shadow: 0 8rpx 18rpx rgba(154, 106, 75, 0.18);
}

.day-active .day-label,
.day-active .day-num {
  color: #fff;
}

.day-has .day-num::after,
.day-active .day-num::after {
  display: block;
  width: 8rpx;
  height: 8rpx;
  margin: 8rpx auto 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  content: '';
}

.day-active .day-num::after {
  background: #fff;
}

.day-label {
  color: #8b857c;
  font-size: 22rpx;
  font-weight: 900;
}

.day-num {
  margin-top: 18rpx;
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.session-row {
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
}

.session-row:last-child {
  border-bottom: 0;
}

.session-time {
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
}

.session-class {
  margin-top: 6rpx;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.status-text {
  color: #57534e;
  font-size: 24rpx;
}

.session-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.session-foot .card-meta {
  flex: 1;
}

.class-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
  text-align: center;
}

.stat-num {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.student-mini-list {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.student-mini,
.balance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  padding: 18rpx 20rpx;
}

.student-link:active {
  background: #f1e9e1;
}

.student-name {
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.balance {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 25rpx;
  font-weight: 850;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.balance-list {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.content-text {
  margin-top: 20rpx;
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.7;
}

.homework-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.homework-image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  background: #f6f4f0;
}

.teacher-feedback {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.42);
}

.work-sheet {
  width: 100%;
  max-height: 90vh;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.review-sheet {
  max-height: 82vh;
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  margin: 0 auto 28rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.sheet-title {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.sheet-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.4;
}

.sheet-close-icon {
  position: relative;
  display: flex;
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  min-height: 56rpx;
  max-height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 52rpx;
  overflow: hidden;
  padding: 0;
  text-align: center;
}

.sheet-close-icon:active {
  background: #eadbce;
}

.review-status::after {
  border: 0;
}

.sheet-session {
  margin-top: 24rpx;
  border-radius: 22rpx;
  background: #f6f4f0;
  padding: 22rpx;
  text-align: center;
}

.sheet-time {
  color: #211f1c;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.sheet-date {
  margin-top: 8rpx;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
}

.sheet-desc {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.roll-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: #fbfaf7;
  padding: 18rpx 10rpx;
  text-align: center;
}

.roll-num {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.1;
}

.roll-label {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.sheet-scroll {
  max-height: 42vh;
  margin-top: 20rpx;
}

.feedback-scroll {
  max-height: 48vh;
}

.sheet-list {
  display: grid;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.sheet-loading,
.sheet-empty {
  color: #8b857c;
  font-size: 26rpx;
  padding: 34rpx 0;
  text-align: center;
}

.roll-row,
.feedback-row,
.review-origin {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border: 1rpx solid rgba(33, 31, 28, 0.07);
  border-radius: 22rpx;
  background: #fff;
  padding: 22rpx;
}

.roll-student {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.roll-name {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.35;
}

.roll-grade {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.recorded-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #e8f3ec;
  color: #287047;
  font-size: 22rpx;
  font-weight: 850;
  padding: 8rpx 16rpx;
}

.status-grid {
  display: grid;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.status-option {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 62rpx;
  min-height: 62rpx;
  min-width: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 16rpx;
  background: #f6f4f0;
  color: #57534e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  margin: 0;
  padding: 0;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-option-active {
  border-color: #9a6a4b;
  background: #f1e9e1;
  color: #9a6a4b;
}

.status-option-disabled {
  opacity: 0.58;
}

.feedback-input {
  width: 100%;
  min-height: 168rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 18rpx;
  background: #fbfaf7;
  color: #211f1c;
  font-size: 25rpx;
  line-height: 1.6;
  padding: 18rpx;
  box-sizing: border-box;
}

.review-input {
  min-height: 220rpx;
}

.review-status-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
}

.review-status {
  min-height: 56rpx;
  border-radius: 999rpx;
  background: #f6f4f0;
  color: #57534e;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 56rpx;
  padding: 0;
}

.review-status-active {
  background: #211f1c;
  color: #fff;
}

.sheet-error {
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #fff1f0;
  color: #c15c3a;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 16rpx 18rpx;
}

.sheet-submit {
  width: 100%;
  margin-top: 20rpx;
  margin-bottom: 0;
}

.review-ok-hint {
  margin-top: 20rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.55;
  padding: 20rpx;
}

.assignment-box {
  border: 1rpx solid rgba(33, 31, 28, 0.07);
  border-radius: 22rpx;
  background: #fff;
  padding: 22rpx;
}

.assignment-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.template-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.template-chip,
.personal-assignment-toggle {
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
  padding: 12rpx 16rpx;
}

.assignment-input {
  min-height: 116rpx;
}

.star-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}

.review-star-row {
  margin-top: 18rpx;
}

.star {
  color: #d8d0c6;
  font-size: 38rpx;
