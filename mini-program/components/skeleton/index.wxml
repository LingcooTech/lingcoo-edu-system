<view class="sk-wrap">
  <block wx:if="{{variant == 'home'}}">
    <view class="sk-card">
      <view class="sk sk-line sk-w30"></view>
      <view class="sk sk-line sk-title sk-w80"></view>
      <view class="sk sk-line sk-w90"></view>
      <view class="sk sk-line sk-w60"></view>
      <view class="sk-row sk-gap">
        <view class="sk sk-btn"></view>
        <view class="sk sk-btn"></view>
      </view>
      <view class="sk sk-media"></view>
    </view>
    <view class="sk-cards">
      <view class="sk-card sk-cardlet" wx:for="{{[1, 2]}}" wx:key="*this">
        <view class="sk sk-thumb"></view>
        <view class="sk sk-line sk-w70"></view>
        <view class="sk sk-line sk-w40"></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{variant == 'detail'}}">
    <view class="sk-card">
      <view class="sk sk-media"></view>
      <view class="sk sk-line sk-title sk-w70"></view>
      <view class="sk sk-line sk-w40"></view>
      <view class="sk sk-line sk-w90"></view>
      <view class="sk sk-line sk-w90"></view>
      <view class="sk sk-line sk-w60"></view>
    </view>
  </block>

  <block wx:elif="{{variant == 'hub'}}">
    <view class="sk-card sk-row sk-gap">
      <view class="sk sk-avatar"></view>
      <view class="sk-col sk-flex">
        <view class="sk sk-line sk-w50"></view>
        <view class="sk sk-line sk-w30"></view>
      </view>
    </view>
    <view class="sk-capsules">
      <view class="sk sk-capsule" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this"></view>
    </view>
    <view class="sk-card">
      <view class="sk-row sk-entry" wx:for="{{[1, 2, 3, 4, 5, 6]}}" wx:key="*this">
        <view class="sk sk-icon"></view>
        <view class="sk-col sk-flex">
          <view class="sk sk-line sk-w40"></view>
          <view class="sk sk-line sk-w60"></view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="sk-card">
      <view class="sk sk-line sk-title sk-w40"></view>
      <view class="sk-row sk-listrow" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
        <view class="sk-col sk-flex">
          <view class="sk sk-line sk-w60"></view>
          <view class="sk sk-line sk-w40"></view>
        </view>
        <view class="sk sk-pill"></view>
      </view>
    </view>
  </block>
</view>
