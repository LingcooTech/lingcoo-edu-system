<view class="admin-panel">
  <view class="admin-hero">
    <view>
      <view class="admin-eyebrow">管理员账号</view>
      <view class="admin-title">管理看板</view>
      <view class="admin-desc">数据展示、快速搜索和业务概览。</view>
    </view>
    <view class="admin-hero-actions">
      <button
        wx:if="{{canSwitchRole}}"
        class="role-switch-button"
        loading="{{switchingRole}}"
        disabled="{{switchingRole}}"
        bindtap="requestRoleSwitch"
      >
        切到老师
      </button>
      <view class="admin-badge">只读</view>
    </view>
  </view>

  <view class="admin-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="{{item.className}}"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <skeleton wx:if="{{loading}}" variant="list" />

  <block wx:elif="{{overview}}">
    <block wx:if="{{activeTab == 'overview'}}">
      <view class="metric-grid">
        <view class="metric-card">
          <view class="metric-value">{{overview.metrics.todaySessions}}</view>
          <view class="metric-label">今日课表</view>
        </view>
        <view class="metric-card">
          <view class="metric-value">{{overview.metrics.todayLeads}}</view>
          <view class="metric-label">今日线索</view>
        </view>
        <view class="metric-card">
          <view class="metric-value money">¥{{overview.metrics.monthRevenueLabel}}</view>
          <view class="metric-label">本月成交</view>
        </view>
        <view class="metric-card">
          <view class="metric-value">{{overview.metrics.pendingOrders}}</view>
          <view class="metric-label">待支付</view>
        </view>
        <view class="metric-card">
          <view class="metric-value">{{overview.metrics.activeStudents}}</view>
          <view class="metric-label">正式学员</view>
        </view>
        <view class="metric-card">
          <view class="metric-value">{{overview.metrics.lowLessonAccounts}}</view>
          <view class="metric-label">低余量</view>
        </view>
      </view>

      <view class="section-title">近期课表</view>
      <view wx:if="{{overview.upcomingSessions.length}}" class="admin-list">
        <view wx:for="{{overview.upcomingSessions}}" wx:key="id" class="admin-card">
          <view class="row-between">
            <view class="row-title">{{item.courseName}}</view>
            <view class="status-pill">{{item.statusLabel}}</view>
          </view>
          <view class="row-meta">{{item.timeLabel}}</view>
          <view class="row-meta">{{item.className}} · {{item.teacherName}}</view>
          <view class="row-meta">{{item.classroomName}}</view>
        </view>
      </view>
      <view wx:else class="admin-empty">近期暂无课表</view>
    </block>

    <block wx:elif="{{activeTab == 'search'}}">
      <view class="search-card">
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜索学员、手机号、订单号、课程"
          confirm-type="search"
          bindinput="onKeywordInput"
          bindconfirm="submitSearch"
        />
        <button
          class="mini-button search-button"
          loading="{{searching}}"
          disabled="{{searching}}"
          bindtap="submitSearch"
        >
          搜索
        </button>
      </view>

      <view wx:if="{{searchResult}}" class="search-result">
        <view class="section-title">学员</view>
        <view wx:if="{{searchResult.students.length}}" class="admin-list">
          <view wx:for="{{searchResult.students}}" wx:key="id" class="admin-card compact">
            <view class="row-between">
              <view class="row-title">{{item.name}}</view>
              <view class="status-pill">{{item.statusLabel}}</view>
            </view>
            <view class="row-meta">{{item.grade}}{{item.school ? ' · ' + item.school : ''}}</view>
          </view>
        </view>
        <view wx:else class="admin-empty compact">暂无匹配学员</view>

        <view class="section-title">家长</view>
        <view wx:if="{{searchResult.guardians.length}}" class="admin-list">
          <view wx:for="{{searchResult.guardians}}" wx:key="id" class="admin-card compact">
            <view class="row-title">{{item.name}}</view>
            <view class="row-meta">{{item.phone}}</view>
          </view>
        </view>
        <view wx:else class="admin-empty compact">暂无匹配家长</view>

        <view class="section-title">订单</view>
        <view wx:if="{{searchResult.orders.length}}" class="admin-list">
          <view wx:for="{{searchResult.orders}}" wx:key="id" class="admin-card compact">
            <view class="row-between">
              <view class="row-title">{{item.orderNo}}</view>
              <view class="status-pill">{{item.statusLabel}}</view>
            </view>
            <view class="row-meta">{{item.studentName}} · {{item.courseName}}</view>
            <view class="row-meta">¥{{item.paidAmountLabel}} · {{item.createdAtLabel}}</view>
          </view>
        </view>
        <view wx:else class="admin-empty compact">暂无匹配订单</view>

        <view class="section-title">课程</view>
        <view wx:if="{{searchResult.courses.length}}" class="admin-list">
          <view wx:for="{{searchResult.courses}}" wx:key="id" class="admin-card compact">
            <view class="row-title">{{item.name}}</view>
            <view class="row-meta">{{item.category}} · {{item.ageRange}}</view>
          </view>
        </view>
        <view wx:else class="admin-empty compact">暂无匹配课程</view>
      </view>
    </block>

    <block wx:elif="{{activeTab == 'orders'}}">
      <view class="section-title">最近订单</view>
      <view wx:if="{{overview.recentOrders.length}}" class="admin-list">
        <view wx:for="{{overview.recentOrders}}" wx:key="id" class="admin-card">
          <view class="row-between">
            <view class="row-title">{{item.orderNo}}</view>
            <view class="status-pill">{{item.statusLabel}}</view>
          </view>
          <view class="row-meta">{{item.studentName}} · {{item.courseName}}</view>
          <view class="order-line">
            <view class="row-meta">{{item.createdAtLabel}}</view>
            <view class="order-money">¥{{item.paidAmountLabel}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="admin-empty">暂无订单</view>
    </block>

    <block wx:else>
      <view class="section-title">最近学员</view>
      <view wx:if="{{overview.recentStudents.length}}" class="admin-list">
        <view wx:for="{{overview.recentStudents}}" wx:key="id" class="admin-card">
          <view class="row-between">
            <view class="row-title">{{item.name}}</view>
            <view class="status-pill">{{item.statusLabel}}</view>
          </view>
          <view class="row-meta">{{item.grade}}{{item.school ? ' · ' + item.school : ''}}</view>
          <view class="row-meta">家长：{{item.guardianName || '待绑定'}} {{item.guardianPhone}}</view>
          <view class="order-line">
            <view class="row-meta">{{item.createdAtLabel}}</view>
            <view class="order-money">{{item.balance}} 课时</view>
          </view>
        </view>
      </view>
      <view wx:else class="admin-empty">暂无学员</view>
    </block>
  </block>
</view>
