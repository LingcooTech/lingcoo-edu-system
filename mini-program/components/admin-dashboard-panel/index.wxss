.admin-panel {
  padding-bottom: 28rpx;
}

.admin-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 22rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 90% 8%, rgba(208, 225, 255, 0.85), rgba(208, 225, 255, 0) 36%),
    linear-gradient(180deg, #ffffff 0%, #f8f3ed 100%);
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
  padding: 34rpx 30rpx;
}

.admin-eyebrow {
  color: #6b6258;
  font-size: 25rpx;
  font-weight: 850;
}

.admin-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
}

.admin-desc {
  margin-top: 10rpx;
  color: #8b857c;
  font-size: 25rpx;
  line-height: 1.45;
}

.admin-hero-actions {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.role-switch-button {
  box-sizing: border-box;
  min-width: 132rpx;
  height: 54rpx;
  border: 0;
  border-radius: 999rpx;
  background: #211f1c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 54rpx;
  margin: 0;
  padding: 0 20rpx;
}

.role-switch-button::after {
  border: 0;
}

.admin-badge,
.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 850;
  padding: 8rpx 16rpx;
}

.admin-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  overflow: hidden;
  padding: 6rpx;
}

.admin-tab {
  display: flex;
  min-width: 0;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #6b6258;
  font-size: 24rpx;
  font-weight: 900;
}

.admin-tab.active {
  background: #211f1c;
  color: #fff;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.metric-card {
  display: flex;
  min-height: 124rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.04);
  padding: 14rpx 8rpx;
  text-align: center;
}

.metric-value {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-value.money {
  font-size: 31rpx;
}

.metric-label {
  margin-top: 10rpx;
  color: #8b857c;
  font-size: 21rpx;
  line-height: 1.2;
}

.section-title {
  margin: 34rpx 0 16rpx;
  color: #211f1c;
  font-size: 33rpx;
  font-weight: 900;
}

.admin-list {
  display: grid;
  gap: 16rpx;
}

.admin-card {
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(33, 31, 28, 0.05);
  padding: 24rpx;
}

.admin-card.compact {
  padding: 20rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.row-title {
  min-width: 0;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.row-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.45;
}

.order-line {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.order-money {
  color: #9a6a4b;
  font-size: 27rpx;
  font-weight: 900;
}

.admin-empty {
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #8b857c;
  font-size: 25rpx;
  padding: 34rpx;
  text-align: center;
}

.admin-empty.compact {
  padding: 22rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(33, 31, 28, 0.05);
  padding: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  color: #211f1c;
  font-size: 25rpx;
  padding: 0 20rpx;
}

.search-button {
  display: flex;
  width: 92rpx;
  max-width: 92rpx;
  height: 70rpx;
  flex: 0 0 92rpx;
  align-items: center;
  justify-content: center;
  background: #211f1c;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 70rpx;
  margin: 0;
  padding: 0;
}

.search-result {
  margin-top: 10rpx;
}
