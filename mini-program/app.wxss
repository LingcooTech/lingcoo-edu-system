page {
  min-height: 100vh;
  background: #f6f3ed;
  color: #1f2b24;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.section {
  margin-top: 28rpx;
}

.card {
  border: 1rpx solid rgba(31, 43, 36, 0.08);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(31, 43, 36, 0.06);
}

.muted {
  color: #6c766f;
}

.eyebrow {
  color: #1f6f5b;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  color: #1f2b24;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-title {
  color: #1f2b24;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.body-text {
  color: #4f5a53;
  font-size: 28rpx;
  line-height: 1.75;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid {
  display: grid;
  gap: 20rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  border-radius: 999rpx;
  background: #e9f4ef;
  color: #1f6f5b;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.btn {
  min-height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.btn::after {
  border: 0;
}

.btn-primary {
  background: #1f6f5b;
  color: #fff;
}

.btn-outline {
  border: 1rpx solid rgba(31, 43, 36, 0.14);
  background: #fff;
  color: #1f2b24;
}

.loading,
.empty {
  padding: 60rpx 0;
  color: #6c766f;
  text-align: center;
}

.form-field {
  width: 100%;
  min-height: 88rpx;
  border: 1rpx solid rgba(31, 43, 36, 0.12);
  border-radius: 20rpx;
  background: #fff;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
}

.form-gap {
  display: grid;
  gap: 18rpx;
}

.page-head {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.7);
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 43, 36, 0.05);
}

.rail {
  width: 100%;
  white-space: nowrap;
}

.rail-card {
  display: inline-block;
  width: 580rpx;
  margin-right: 18rpx;
  vertical-align: top;
  white-space: normal;
}

.rail-card-sm {
  width: 500rpx;
}

.app-bottom-bar {
  position: sticky;
  bottom: 0;
  margin: 32rpx -24rpx -24rpx;
  border-top: 1rpx solid rgba(31, 43, 36, 0.08);
  background: rgba(246, 243, 237, 0.96);
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  backdrop-filter: blur(16rpx);
}
