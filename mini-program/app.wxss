page {
  background: #f6f4f0;
  color: #211f1c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -webkit-text-size-adjust: 100%;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

/* ──────────────────────────────────────────────────────────────── */
/* Design System: Colors & Shadows */
/* ──────────────────────────────────────────────────────────────── */

:root {
  --color-primary: #9a6a4b;
  --color-primary-light: #f7e8dc;
  --color-text-primary: #211f1c;
  --color-text-secondary: #57534e;
  --color-text-muted: #8b857c;
  --color-border: rgba(33, 31, 28, 0.08);
  --color-border-light: rgba(33, 31, 28, 0.05);
  --color-bg-primary: #ffffff;
  --color-bg-secondary: #fbf9f7;
  --color-bg-tertiary: #f6f4f0;

  /* Shadow System */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);

  /* Transitions */
  --transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.page {
  padding: 88px 24rpx 24rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: page-enter 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.section {
  margin-top: 28rpx;
}

/* ──────────────────────────────────────────────────────────────── */
/* Card System with Elevation & Interactive States */
/* ──────────────────────────────────────────────────────────────── */

.card {
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(33, 31, 28, 0.06);
  transition: var(--transition-base);
}

.card-elevated {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-interactive {
  cursor: pointer;
  transition: var(--transition-fast);
}

.card-interactive:active {
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
  transform: scale(0.98);
}

.card-interactive:hover {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.muted {
  color: #8b857c;
}

.title {
  color: #211f1c;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: -0.5px;
}

.section-title {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: -0.3px;
}

.body-text {
  color: #57534e;
  font-size: 28rpx;
  line-height: 1.75;
  letter-spacing: 0;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid {
  display: grid;
  gap: 20rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  transition: var(--transition-fast);
}

.chip:active {
  background: #f1dcc8;
  transform: scale(0.95);
}

.btn {
  min-height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  transition: var(--transition-fast);
}

.btn::after {
  border: 0;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: #9a6a4b;
  color: #fff;
}

.btn-primary:active {
  background: #8a5a3b;
}

.btn-outline {
  border: 1rpx solid rgba(33, 31, 28, 0.14);
  background: #fff;
  color: #211f1c;
}

.btn-outline:active {
  background: #f7f3ee;
}

.loading,
.empty {
  padding: 60rpx 0;
  color: #8b857c;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.6;
}

.loading::before {
  content: '⏳';
  display: block;
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
  animation: pulse-fade 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.empty::before {
  content: '📭';
  display: block;
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

@keyframes pulse-fade {
  0%, 100% {
    opacity: 0.4;
  }
  50% {
    opacity: 0.8;
  }
}

.form-field {
  width: 100%;
  min-height: 88rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.12);
  border-radius: 20rpx;
  background: #fff;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  transition: var(--transition-fast);
}

.form-field:focus {
  border-color: #9a6a4b;
  box-shadow: 0 0 0 3rpx rgba(154, 106, 75, 0.1);
}

.form-gap {
  display: grid;
  gap: 18rpx;
}

.page-head {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.7);
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(33, 31, 28, 0.05);
}

.rail {
  width: 100%;
  white-space: nowrap;
}

.rail-card {
  display: inline-block;
  width: 580rpx;
  margin-right: 18rpx;
  vertical-align: top;
  white-space: normal;
  transition: var(--transition-fast);
}

.rail-card-sm {
  width: 500rpx;
}

.app-bottom-bar {
  position: sticky;
  bottom: 0;
  margin: 32rpx -24rpx -24rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  background: rgba(246, 244, 240, 0.96);
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  backdrop-filter: blur(16rpx);
}

/* ── Shared parent-center list primitives (hub + detail sub-pages) ───────── */
.panel {
  padding: 32rpx;
}

.mini-button {
  width: auto;
  height: 52rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  padding: 0 20rpx;
  transition: var(--transition-fast);
}

.mini-button::after {
  border: 0;
}

.mini-button:active {
  background: #f1dcc8;
  transform: scale(0.95);
}

.mini-button[disabled] {
  opacity: 0.5;
}

.item-list {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.info-row,
.stack-row,
.notification-row {
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  padding-top: 18rpx;
}

.item-list > .info-row:first-child,
.item-list > .stack-row:first-child,
.item-list > .notification-row:first-child {
  border-top: 0;
  padding-top: 0;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.row-title {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.row-meta,
.row-side {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #8b857c;
}

.row-side {
  max-width: 220rpx;
  margin-top: 0;
  text-align: right;
}

.balance-pill,
.order-status,
.attendance-status,
.notice-status,
.seat-status {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.balance-pill {
  background: #f1e9e1;
  color: #9a6a4b;
}

.order-status,
.attendance-status,
.notice-status,
.seat-status {
  background: #f2f0ea;
  color: #5d655f;
}

.order-status.pending,
.notice-status.unread,
.notice-status.submitted,
.seat-status.pending_payment {
  background: #fff4d8;
  color: #8a5a00;
}

.order-status.paid,
.notice-status.reviewed,
.seat-status.reserved {
  background: #f1e9e1;
  color: #9a6a4b;
}

.notice-status.needs_revision {
  background: #f8e7e7;
  color: #9a3412;
}

.seat-status.cancelled,
.seat-status.expired {
  background: #f8e7e7;
  color: #9a3412;
}

.reschedule-button {
  display: inline-block;
  margin-top: 16rpx;
}

.order-line,
.notice-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.order-amount {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
}

.attendance-topic,
.notice-body,
.teacher-feedback {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #57534e;
}

.teacher-feedback {
  border-radius: 18rpx;
  background: #f2f0ea;
  padding: 18rpx;
}

.picker-field {
  min-height: 88rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.12);
  border-radius: 18rpx;
  background: #fff;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 88rpx;
  padding: 0 24rpx;
}

.compact-empty {
  padding: 36rpx 0 6rpx;
}

.login-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}

.login-empty-btn {
  width: auto;
  padding: 0 44rpx;
}

/* ──────────────────────────────────────────────────────────────── */
/* Page & Global Animations */
/* ──────────────────────────────────────────────────────────────── */

@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-in-bottom {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
