.page-title {
  margin-top: 12rpx;
}

.intro {
  margin-top: 12rpx;
}

.tabs {
  margin-top: 28rpx;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 64rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1px solid #e3ddd1;
  background: #fff;
  color: #6b6357;
  font-size: 26rpx;
  vertical-align: top;
}

.tab-active {
  border-color: #c59a54;
  background: #fffaf0;
  color: #17324d;
  font-weight: 700;
}

.tab-logo {
  max-width: 156rpx;
  width: 156rpx;
  height: 44rpx;
}

.tagline {
  margin-top: 18rpx;
  color: #4a5550;
  font-size: 27rpx;
  line-height: 1.6;
}

.teacher-list {
  display: grid;
  gap: 20rpx;
  margin-top: 30rpx;
}

.teacher-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
}

.teacher-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #17324d, #c59a54);
}

.teacher-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 28rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e9f4ef;
  color: #1f6f5b;
  font-size: 34rpx;
  font-weight: 800;
}

.teacher-main {
  min-width: 0;
  flex: 1;
}

.teacher-name {
  color: #1f2b24;
  font-size: 32rpx;
  font-weight: 800;
}

.teacher-title {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.institution-mark {
  display: inline-flex;
  align-items: center;
  max-width: 260rpx;
  min-height: 44rpx;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(197, 154, 84, 0.55);
  border-radius: 999rpx;
  background: #fffaf0;
  color: #17324d;
  font-size: 23rpx;
  font-weight: 700;
}

.institution-logo {
  width: 150rpx;
  height: 34rpx;
}

.specialties {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.specialty-empty {
  margin-top: 22rpx;
  font-size: 26rpx;
}

.bio {
  margin-top: 24rpx;
}
