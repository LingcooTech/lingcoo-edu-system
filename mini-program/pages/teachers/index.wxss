.teachers-page {
  padding-bottom: 130rpx;
  background: #f5f3ef;
}

.tabs {
  margin-top: 8rpx;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 64rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  border: 1px solid #e3ddd1;
  border-radius: 999rpx;
  background: #fff;
  color: #6b6357;
  font-size: 26rpx;
  vertical-align: top;
}

.tab-active {
  border-color: #c59a54;
  background: #fffaf0;
  color: #9a6a4b;
  font-weight: 700;
}

.tab-logo {
  width: 136rpx;
  height: 38rpx;
}

.teacher-list {
  display: grid;
  gap: 16rpx;
  margin-top: 26rpx;
}

.teacher-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 10rpx 18rpx;
}

.teacher-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.teacher-avatar {
  display: flex;
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 38rpx;
  font-weight: 800;
}

.teacher-body {
  flex: 1;
  min-width: 0;
}

.teacher-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.teacher-name {
  flex: 0 0 auto;
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.teacher-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #8b857c;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.teacher-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.teacher-tagline {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #57534e;
  font-size: 24rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.institution-mark {
  display: inline-flex;
  align-items: center;
  max-width: 360rpx;
  min-height: 40rpx;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(154, 106, 75, 0.28);
  border-radius: 999rpx;
  background: #fffaf0;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 700;
}

.institution-logo-wrap {
  display: flex;
  align-items: center;
  width: 128rpx;
  height: 34rpx;
  margin-top: 8rpx;
}

.institution-logo {
  width: 128rpx;
  height: 30rpx;
}
