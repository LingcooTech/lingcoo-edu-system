<custom-navbar title="教师团队" />
<view class="page teachers-page">
  <scroll-view wx:if="{{tabs.length}}" class="tabs" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{activeTab === item.id ? 'tab-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTabTap"
    >
      <image wx:if="{{item.logoUrl}}" class="tab-logo" src="{{item.logoUrl}}" mode="aspectFit" />
      <text wx:else>{{item.name}}</text>
    </view>
  </scroll-view>

  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{visibleTeachers.length}}" class="teacher-list">
    <navigator
      wx:for="{{visibleTeachers}}"
      wx:key="id"
      class="teacher-card"
      url="/pages/teacher-detail/index?id={{item.id}}"
    >
      <image wx:if="{{item.avatarUrl}}" class="teacher-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="teacher-avatar teacher-avatar-fallback">{{item.initial}}</view>
      <view class="teacher-body">
        <view class="teacher-row">
          <view class="teacher-name">{{item.name}}</view>
          <view wx:if="{{item.title}}" class="teacher-title">{{item.title}}</view>
        </view>
        <view wx:if="{{item.metaText}}" class="teacher-meta">{{item.metaText}}</view>
        <view class="teacher-tagline">{{item.displayTagline}}</view>
        <view
          wx:if="{{item.institutionName || item.institutionLogoUrl}}"
          class="{{item.institutionLogoUrl ? 'institution-logo-wrap' : 'institution-mark'}}"
        >
          <image
            wx:if="{{item.institutionLogoUrl}}"
            class="institution-logo"
            src="{{item.institutionLogoUrl}}"
            mode="aspectFit"
          />
          <text wx:else>{{item.institutionName}}</text>
        </view>
      </view>
    </navigator>
  </view>
  <view wx:else class="empty">教师信息待上线。</view>
</view>
