<custom-navbar title="教师团队" show-back="{{true}}" />
<view class="page">
  <view class="body-text intro">提前了解授课老师的擅长方向，点击老师查看详情。</view>

  <scroll-view wx:if="{{tabs.length}}" class="tabs" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{activeTab === item.id ? 'tab-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTabTap"
    >
      <image wx:if="{{item.logoUrl}}" class="tab-logo" src="{{item.logoUrl}}" mode="aspectFit" />
      <text wx:else>{{item.name}}</text>
    </view>
  </scroll-view>

  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{visibleTeachers.length}}" class="teacher-list">
    <view
      wx:for="{{visibleTeachers}}"
      wx:key="id"
      class="card teacher-card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="teacher-head">
        <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar fallback">师</view>
        <view class="teacher-main">
          <view class="teacher-name">{{item.name}}</view>
          <view wx:if="{{item.title}}" class="muted teacher-title">{{item.title}}</view>
          <view
            wx:if="{{item.institutionName || item.institutionLogoUrl}}"
            class="{{item.institutionLogoUrl ? 'institution-logo-wrap' : 'institution-mark'}}"
          >
            <image
              wx:if="{{item.institutionLogoUrl}}"
              class="institution-logo"
              src="{{item.institutionLogoUrl}}"
              mode="aspectFit"
            />
            <text wx:else>{{item.institutionName}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{item.tagline}}" class="tagline">{{item.tagline}}</view>

      <view wx:if="{{item.specialties.length}}" class="specialties">
        <text wx:for="{{item.specialties}}" wx:for-item="spec" wx:key="*this" class="chip">{{spec}}</text>
      </view>
      <view wx:else class="muted specialty-empty">待补充擅长方向</view>
    </view>
  </view>
  <view wx:else class="empty">教师信息待上线。</view>
</view>
