.trials-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f6f4f0;
}

.trial-head {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
  margin: -24rpx -24rpx 0;
  margin-top: -88px;
  padding-top: calc(88px + 38rpx);
  background: linear-gradient(135deg, #a87553 0%, #8f6044 100%);
}

.trial-head-orb {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.09);
}

.trial-head-orb-one {
  top: 70rpx;
  right: -70rpx;
  width: 260rpx;
  height: 260rpx;
}

.trial-head-orb-two {
  bottom: -90rpx;
  left: -60rpx;
  width: 220rpx;
  height: 220rpx;
}

.trial-head-copy {
  position: absolute;
  right: 30rpx;
  bottom: 44rpx;
  left: 30rpx;
  color: #fff;
}

.trial-title {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.trial-subtitle {
  max-width: 620rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  opacity: 0.86;
}

.consultant-card {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 18rpx;
  margin-top: -24rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(33, 31, 28, 0.08);
}

.consultant-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #efe5dc;
}

.consultant-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a6a4b;
  font-size: 36rpx;
  font-weight: 900;
}

.consultant-main {
  min-width: 0;
}

.consultant-eyebrow {
  color: #9a6a4b;
  font-size: 20rpx;
  font-weight: 850;
}

.consultant-name {
  margin-top: 2rpx;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
}

.consultant-copy {
  overflow: hidden;
  margin-top: 5rpx;
  color: #8b857c;
  font-size: 21rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.consultant-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.consultant-button {
  display: flex;
  min-width: 146rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 850;
  padding: 0 22rpx;
}

.consultant-button-primary {
  background: #9a6a4b;
  color: #fff;
}

.consultant-button-light {
  background: #f1e9e1;
  color: #81583f;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 34rpx;
}

.section-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.section-count {
  color: #9a6a4b;
  font-size: 21rpx;
  font-weight: 850;
}

.course-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.course-card {
  display: grid;
  grid-template-columns: 154rpx minmax(0, 1fr);
  gap: 20rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.course-cover {
  display: flex;
  width: 154rpx;
  height: 154rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #efe5dc;
}

.course-cover-fallback {
  color: #9a6a4b;
  font-size: 44rpx;
  font-weight: 900;
}

.course-main {
  min-width: 0;
}

.course-name {
  overflow: hidden;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #696159;
  font-size: 21rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.course-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: #9a948b;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 12rpx;
}

.course-category {
  color: #9a6a4b;
  font-size: 20rpx;
  font-weight: 800;
}

.course-reserve {
  display: flex;
  width: 142rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 20rpx;
  font-weight: 850;
}

.empty-card {
  margin-top: 18rpx;
  border-radius: 26rpx;
  background: #fff;
  color: #8b857c;
  font-size: 23rpx;
  padding: 50rpx 24rpx;
  text-align: center;
}

.public-section {
  margin-top: 40rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
}

.public-heading {
  margin-top: 28rpx;
}

.public-list {
  display: grid;
  gap: 12rpx;
  margin-top: 16rpx;
}

.public-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 22rpx;
  background: #fff;
  padding: 20rpx 22rpx;
}

.public-title {
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 850;
}

.public-meta {
  margin-top: 5rpx;
  color: #8b857c;
  font-size: 20rpx;
  line-height: 1.4;
}

.public-arrow {
  color: #9a6a4b;
  font-size: 38rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.45);
}

.trial-sheet {
  width: 100%;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8d0;
  margin: 0 auto 26rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.sheet-title {
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
}

.sheet-course {
  margin-top: 5rpx;
  color: #9a6a4b;
  font-size: 25rpx;
  font-weight: 850;
}

.sheet-copy {
  margin-top: 5rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.sheet-close {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 38rpx;
}

.form-list {
  display: grid;
  gap: 12rpx;
  margin-top: 24rpx;
}

.form-input,
.form-picker,
.form-readonly {
  width: 100%;
  height: 76rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 18rpx;
  background: #f7f5f2;
  color: #211f1c;
  font-size: 23rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
}

.form-picker {
  text-align: left;
}

.form-readonly {
  color: #7a7067;
}

.submit-button {
  display: flex;
  width: 100%;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
  margin: 24rpx 0 0;
  padding: 0;
}

.submit-button::after {
  border: 0;
}
