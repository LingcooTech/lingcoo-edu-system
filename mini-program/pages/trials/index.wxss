.trials-page {
  padding-bottom: 130rpx;
  background: #f5f3ef;
}

.trial-head {
  position: relative;
  min-height: 360rpx;
  overflow: hidden;
  border-radius: 0;
  margin: -24rpx -24rpx 0;
  margin-top: -88px;
  padding-top: calc(88px + 38rpx);
  background: #cfa57d;
}

.trial-head-image,
.trial-head-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.trial-head-shade {
  background: linear-gradient(180deg, rgba(33, 31, 28, 0.18), rgba(33, 31, 28, 0.62));
}

.trial-head-copy {
  position: absolute;
  right: 28rpx;
  bottom: 54rpx;
  left: 28rpx;
  color: #fff;
}

.trial-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.26;
}

.trial-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.86;
}

.trial-filters {
  position: relative;
  z-index: 2;
  margin: -28rpx 0 0;
  border-radius: 26rpx;
  background: #fff;
  padding: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
}

.time-filter-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f7f3ee;
  padding: 6rpx;
}

.time-filter {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #8b857c;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
  margin: 0;
  padding: 0 4rpx;
}

.time-filter::after {
  border: 0;
}

.time-filter.active {
  background: #fff;
  color: #9a6a4b;
  box-shadow: 0 2rpx 8rpx rgba(33, 31, 28, 0.06);
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.filter-picker {
  overflow: hidden;
  border-radius: 18rpx;
  background: #f8f6f2;
  color: #211f1c;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 72rpx;
  min-height: 72rpx;
  padding: 0 18rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.06);
  padding-top: 14rpx;
  width: 100%;
}

.filter-count {
  display: flex;
  flex: 1;
  min-height: 52rpx;
  align-items: center;
  justify-content: flex-start;
  color: #8b857c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.full-toggle {
  display: inline-flex;
  width: auto;
  min-width: 116rpx;
  max-width: 136rpx;
  flex: 0 0 auto;
  height: 48rpx;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #fffaf0;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 48rpx;
  margin: 0 0 0 auto;
  padding: 0 16rpx;
}

.full-toggle.active {
  background: #f7f3ee;
  color: #8b857c;
}

.trial-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.trial-card {
  display: grid;
  grid-template-columns: 190rpx 1fr;
  gap: 22rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 26rpx;
  background: #fff;
  padding: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.trial-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.trial-card-hover {
  background: #f7f3ee;
}

.trial-cover {
  display: flex;
  width: 190rpx;
  height: 190rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f1e9e1 0%, #f7f3ee 50%, #f1e9e1 100%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.trial-cover-fallback {
  color: #9a6a4b;
  font-size: 56rpx;
  font-weight: 900;
}

.trial-body {
  min-width: 0;
  padding: 6rpx 0;
}

.trial-card-title {
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.32;
}

.trial-meta {
  margin-top: 14rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.45;
}

.trial-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.trial-fee {
  color: #9a6a4b;
  font-size: 25rpx;
  font-weight: 900;
}

.trial-action {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  padding: 10rpx 20rpx;
}

.trial-empty {
  padding-top: 180rpx;
}

.empty-button {
  margin-top: 28rpx;
  width: 320rpx;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}
