<custom-navbar title="试听" transparent="{{!navSolid}}" />
<view class="page trials-page">
  <view class="trial-head">
    <view class="trial-head-shade"></view>
    <view class="trial-head-copy">
      <view class="trial-title">选择合适的试听场次</view>
      <view class="trial-subtitle">课程由合作机构实施，提交后会确认到场时间和安排。</view>
    </view>
  </view>

  <view class="trial-filters">
    <view class="time-filter-row">
      <button
        wx:for="{{timeFilters}}"
        wx:key="key"
        class="time-filter {{activeTimeFilter == item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTimeFilterTap"
      >
        {{item.label}}
      </button>
    </view>
    <view class="filter-grid">
      <picker
        mode="selector"
        range="{{institutionOptions}}"
        range-key="label"
        value="{{selectedInstitutionIndex}}"
        bindchange="onInstitutionChange"
      >
        <view class="filter-picker">{{institutionOptions[selectedInstitutionIndex].label}}</view>
      </picker>
      <picker
        mode="selector"
        range="{{courseOptions}}"
        range-key="label"
        value="{{selectedCourseIndex}}"
        bindchange="onCourseChange"
      >
        <view class="filter-picker">{{courseOptions[selectedCourseIndex].label}}</view>
      </picker>
      <picker
        mode="selector"
        range="{{campusOptions}}"
        range-key="label"
        value="{{selectedCampusIndex}}"
        bindchange="onCampusChange"
      >
        <view class="filter-picker">{{campusOptions[selectedCampusIndex].label}}</view>
      </picker>
    </view>
    <view class="filter-footer">
      <view class="filter-count">筛选结果 {{trials.length}} 场</view>
      <view class="full-toggle {{showFull ? 'active' : ''}}" aria-role="button" bindtap="onToggleFull">
        {{showFull ? '显示已满' : '隐藏已满'}}
      </view>
    </view>
  </view>

  <skeleton wx:if="{{loading}}" variant="list" />

  <view wx:elif="{{trials.length}}" class="trial-list">
    <navigator
      wx:for="{{trials}}"
      wx:key="id"
      class="trial-card"
      url="/pages/trial-detail/index?id={{item.id}}"
      hover-class="trial-card-hover"
    >
      <image wx:if="{{item.coverThumbUrl || item.coverImageUrl}}" class="trial-cover" src="{{item.coverThumbUrl || item.coverImageUrl}}" mode="aspectFill" />
      <view wx:else class="trial-cover trial-cover-fallback">试</view>
      <view class="trial-body">
        <view class="trial-card-title">{{item.title}}</view>
        <view class="trial-provider">合作机构：{{item.providerLabel}}</view>
        <view class="trial-meta">{{item.startsAtLabel}} · 名额 {{item.capacityLabel}}</view>
        <view class="trial-foot">
          <view class="trial-fee">{{item.reservationFeeLabel}}</view>
          <view class="trial-action">试听</view>
        </view>
      </view>
    </navigator>
  </view>

  <view wx:else class="empty trial-empty">
    近期暂无固定试听场次
    <button class="btn btn-primary empty-button" bindtap="goCourses">查看预约试听</button>
  </view>
</view>
<tabbar />
