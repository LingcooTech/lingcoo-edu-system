<custom-navbar title="试听" transparent="{{!navSolid}}" />
<view class="page trials-page">
  <view class="trial-head">
    <view class="trial-head-orb trial-head-orb-one"></view>
    <view class="trial-head-orb trial-head-orb-two"></view>
    <view class="trial-head-copy">
      <view class="trial-title">预约一次真实课堂体验</view>
      <view class="trial-subtitle">选择感兴趣的课程并填写资料，老师会联系确认试听时间。</view>
    </view>
  </view>

  <skeleton wx:if="{{loading}}" variant="list" />

  <block wx:else>
    <view wx:if="{{consultant}}" class="consultant-card">
      <image
        wx:if="{{consultant.avatarUrl}}"
        class="consultant-avatar"
        src="{{consultant.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="consultant-avatar consultant-avatar-fallback">师</view>
      <view class="consultant-main">
        <view class="consultant-eyebrow">试听咨询老师</view>
        <view class="consultant-name">
          {{consultant.name}}{{consultant.title ? ' · ' + consultant.title : ''}}
        </view>
        <view class="consultant-copy">{{consultant.tagline || '课程、校区和试听时间都可以直接咨询。'}}</view>
      </view>
      <view class="consultant-actions">
        <view
          wx:if="{{consultant.wechatQrUrl}}"
          class="consultant-button consultant-button-primary"
          bindtap="previewConsultantQr"
        >
          微信咨询
        </view>
        <view
          wx:if="{{consultant.phone}}"
          class="consultant-button consultant-button-light"
          bindtap="callConsultant"
        >
          电话联系
        </view>
      </view>
    </view>

    <view class="section-heading">
      <view>
        <view class="section-title">选择试听课程</view>
        <view class="section-subtitle">提交的是试听意向，不需要现在选择固定场次</view>
      </view>
      <view class="section-count">共 {{courses.length}} 门</view>
    </view>

    <view wx:if="{{courses.length}}" class="course-list">
      <view wx:for="{{courses}}" wx:key="id" class="course-card">
        <image
          wx:if="{{item.coverUrl}}"
          class="course-cover"
          src="{{item.coverUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="course-cover course-cover-fallback">课</view>
        <view class="course-main">
          <view class="course-name">{{item.name}}</view>
          <view class="course-summary">{{item.summary}}</view>
          <view class="course-meta">
            {{item.ageRange}} · {{item.durationMinutes}}分钟 · {{item.locationLabel}}
          </view>
          <view class="course-provider">{{item.providerLabel}}</view>
          <view class="course-foot">
            <view class="course-category">{{item.category}}</view>
            <view class="course-reserve" data-id="{{item.id}}" bindtap="openTrialForm">
              预约试听
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-card">课程正在整理中，可先联系老师咨询。</view>

    <view wx:if="{{publicTrials.length}}" class="public-section">
      <view class="section-heading public-heading">
        <view>
          <view class="section-title">近期公开体验课</view>
          <view class="section-subtitle">已确定时间的公开课，可直接报名场次</view>
        </view>
      </view>
      <view class="public-list">
        <view
          wx:for="{{publicTrials}}"
          wx:key="id"
          class="public-card"
          data-id="{{item.id}}"
          bindtap="openPublicTrial"
        >
          <view>
            <view class="public-title">{{item.title}}</view>
            <view class="public-meta">
              {{item.startsAtLabel}} · {{item.campusName}} · {{item.courseName}}
            </view>
          </view>
          <view class="public-arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{showTrialForm}}" class="sheet-mask" bindtap="closeTrialForm">
    <view class="trial-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view>
          <view class="sheet-title">预约试听</view>
          <view class="sheet-course">{{selectedCourse.name}}</view>
          <view class="sheet-copy">提交后老师会联系您确认合适的试听时间。</view>
        </view>
        <view class="sheet-close" bindtap="closeTrialForm">×</view>
      </view>

      <view class="form-list">
        <picker
          wx:if="{{campusOptions.length > 1}}"
          mode="selector"
          range="{{campusOptions}}"
          range-key="label"
          value="{{selectedCampusIndex}}"
          bindchange="onCampusChange"
        >
          <view class="form-picker">{{campusOptions[selectedCampusIndex].label}}⌄</view>
        </picker>
        <view wx:elif="{{campusOptions.length}}" class="form-readonly">
          意向校区：{{campusOptions[0].label}}
        </view>
        <input
          class="form-input"
          value="{{form.guardianName}}"
          data-field="guardianName"
          bindinput="onFormInput"
          placeholder="家长姓名"
        />
        <input
          class="form-input"
          type="number"
          value="{{form.phone}}"
          data-field="phone"
          bindinput="onFormInput"
          placeholder="手机号"
        />
        <input
          class="form-input"
          value="{{form.studentName}}"
          data-field="studentName"
          bindinput="onFormInput"
          placeholder="孩子姓名"
        />
        <input
          class="form-input"
          value="{{form.grade}}"
          data-field="grade"
          bindinput="onFormInput"
          placeholder="年龄 / 年级"
        />
      </view>

      <button
        class="submit-button"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="submitTrial"
      >
        {{submitting ? '提交中...' : '提交试听意向'}}
      </button>
    </view>
  </view>
</view>
<tabbar />
