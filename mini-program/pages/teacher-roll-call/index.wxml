<custom-navbar title="点名" show-back="{{true}}" />
<view class="page roll-call-page">
  <skeleton wx:if="{{loading}}" variant="list" />

  <block wx:else>
    <view wx:if="{{error}}" class="error-card">{{error}}</view>

    <view class="session-card">
      <view class="session-date">{{dateLabel}}</view>
      <view class="session-time">{{timeLabel}}</view>
      <view class="session-title">{{className}} · {{title}}</view>
      <view class="session-meta">{{teacherName}} / {{classroomName}}</view>
      <view class="session-edit" bindtap="openSessionEdit">编辑</view>
    </view>

    <view class="lesson-row">
      <view>
        <view class="lesson-label">本次授课课时</view>
        <view class="lesson-course">{{courseName}}</view>
      </view>
      <view class="lesson-stepper {{canEditSession ? '' : 'lesson-stepper-disabled'}}">
        <view class="lesson-step" bindtap="decreaseUnits">－</view>
        <view class="lesson-value">{{lessonUnits}}</view>
        <view class="lesson-step" bindtap="increaseUnits">＋</view>
      </view>
    </view>

    <view class="roster-card">
      <view class="roster-toolbar">
        <view>
          <view class="roster-title">本课次学员</view>
          <view class="roster-count">共 {{allRows.length}} 名</view>
        </view>
        <button class="roster-manage-button" bindtap="openRosterManage">添加/移除学员</button>
      </view>

      <view class="search-box">
        <view class="search-mark">⌕</view>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜索学员姓名快速定位"
          bindinput="changeKeyword"
        />
      </view>

      <view class="roster-head">
        <view class="roster-name-head">学员姓名</view>
        <view wx:for="{{statusOptions}}" wx:key="value" class="status-head">{{item.label}}</view>
      </view>

      <view wx:if="{{rows.length}}" class="roster-list">
        <view wx:for="{{rows}}" wx:key="id" class="student-row">
          <view class="student-info">
            <view class="student-name">{{item.name}}</view>
            <view class="student-balance">剩余 {{item.balanceLabel}} 课时</view>
            <view class="student-deduct">本次扣 {{lessonUnits}} 课时</view>
          </view>
          <view
            wx:for="{{statusOptions}}"
            wx:for-item="statusItem"
            wx:key="value"
            class="status-cell"
            data-id="{{item.id}}"
            data-status="{{statusItem.value}}"
            bindtap="selectStatus"
          >
            <view class="{{item.draftStatus == statusItem.value ? 'radio radio-active' : 'radio'}}">
              <view wx:if="{{item.draftStatus == statusItem.value}}" class="radio-dot"></view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-roster">
        {{allRows.length ? '没有符合条件的学员' : '本课次暂无学员'}}
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && allRows.length}}" class="save-bar">
    <view class="save-summary">
      到课{{summary.present}} 迟到{{summary.late}} 请假{{summary.leave}} 未到{{summary.absent}}
    </view>
    <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">
      完成点名
    </button>
  </view>
</view>
