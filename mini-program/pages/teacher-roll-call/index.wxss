.roll-call-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f4f0;
  padding: calc(88px + 24rpx) 24rpx calc(138rpx + env(safe-area-inset-bottom));
}

.error-card,
.session-card,
.lesson-row,
.roster-card {
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.error-card {
  margin-bottom: 20rpx;
  background: #fff1ef;
  color: #a83f35;
  font-size: 23rpx;
  padding: 22rpx;
}

.session-card {
  position: relative;
  padding: 30rpx 76rpx 30rpx 30rpx;
  text-align: center;
}

.session-date {
  color: #8b857c;
  font-size: 23rpx;
  font-weight: 800;
}

.session-time {
  margin-top: 12rpx;
  color: #211f1c;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
}

.session-title {
  margin-top: 18rpx;
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.4;
}

.session-meta {
  margin-top: 8rpx;
  color: #6b6258;
  font-size: 23rpx;
}

.session-edit {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 850;
  padding: 12rpx;
}

.lesson-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
}

.lesson-label {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 850;
}

.lesson-course {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.lesson-stepper {
  display: grid;
  width: 226rpx;
  height: 62rpx;
  grid-template-columns: repeat(3, 1fr);
  border: 1rpx solid #ded8d0;
  border-radius: 16rpx;
  overflow: hidden;
}

.lesson-stepper-disabled {
  opacity: 0.5;
}

.lesson-step,
.lesson-value {
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #ded8d0;
  color: #332e29;
  font-size: 27rpx;
}

.lesson-step:last-child {
  border-right: 0;
}

.lesson-value {
  font-weight: 900;
}

.roster-card {
  margin-top: 20rpx;
  overflow: hidden;
}

.roster-toolbar {
  display: grid;
  min-height: 72rpx;
  grid-template-columns: minmax(0, 1fr) 190rpx;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 18rpx 10rpx;
}

.roster-title {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 900;
}

.roster-count {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 20rpx;
}

.roster-manage-button {
  display: flex;
  width: 190rpx;
  min-width: 0;
  max-width: 190rpx;
  height: 52rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  justify-self: end;
  overflow: hidden;
  border: 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1;
  margin: 0;
  padding: 0;
  white-space: nowrap;
}

.roster-manage-button:active {
  opacity: 0.82;
}

.roster-head,
.student-row {
  display: grid;
  grid-template-columns: 230rpx 1fr 1fr 1fr 1fr;
  align-items: center;
}

.roster-head {
  color: #6b6258;
  font-size: 22rpx;
  font-weight: 850;
  padding: 10rpx 18rpx 12rpx;
  text-align: center;
}

.roster-name-head {
  text-align: left;
}

.search-box {
  display: flex;
  height: 72rpx;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 18rpx 6rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  padding: 0 20rpx;
}

.search-mark {
  color: #9a948b;
  font-size: 32rpx;
}

.search-input {
  height: 72rpx;
  flex: 1;
  color: #211f1c;
  font-size: 23rpx;
}

.student-row {
  min-height: 150rpx;
  border-top: 1rpx solid #eeeae5;
  padding: 14rpx 18rpx;
}

.student-info {
  min-width: 0;
}

.student-name {
  overflow: hidden;
  color: #211f1c;
  font-size: 25rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-balance,
.student-deduct {
  margin-top: 7rpx;
  color: #8b857c;
  font-size: 19rpx;
}

.student-deduct {
  color: #9a6a4b;
}

.status-cell {
  display: flex;
  min-width: 0;
  min-height: 90rpx;
  align-items: center;
  justify-content: center;
}

.radio {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #d1cbc4;
  border-radius: 999rpx;
}

.radio-active {
  border-color: #9a6a4b;
}

.radio-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: #9a6a4b;
}

.empty-roster {
  min-height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a948b;
  font-size: 23rpx;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: grid;
  min-height: 98rpx;
  grid-template-columns: minmax(0, 1fr) 260rpx;
  align-items: stretch;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(33, 31, 28, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
}

.save-summary {
  display: flex;
  min-width: 0;
  align-items: center;
  color: #332e29;
  font-size: 21rpx;
  font-weight: 800;
  padding: 0 22rpx;
  white-space: nowrap;
}

.save-button {
  display: flex;
  width: 100%;
  height: 98rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 0;
  background: #9a6a4b;
  color: #fff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.save-button::after {
  border: 0;
}
