.back-button {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.back-button::after {
  border: 0;
}

.empty-state {
  display: grid;
  justify-items: center;
  gap: 28rpx;
  padding: 80rpx 0;
  text-align: center;
}

.empty-button {
  width: 320rpx;
}

.story-detail-page {
  padding-right: 42rpx;
  padding-left: 42rpx;
  padding-bottom: 130rpx;
  background: #f5f3ef;
}

.story-hero {
  overflow: hidden;
  margin: 0 -42rpx;
  background: transparent;
}

.story-cover {
  display: block;
  width: 100%;
  height: 430rpx;
  background: #f1e9e1;
}

.story-title {
  margin-top: 34rpx;
  color: #211f1c;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.34;
}

.story-title-first {
  margin-top: 8rpx;
}

.story-excerpt-card {
  position: relative;
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: #fffaf0;
  padding: 30rpx 32rpx 30rpx 42rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.06);
}

.story-excerpt-card::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #9a6a4b;
  content: '';
}

.story-excerpt {
  color: #4c4037;
  font-size: 28rpx;
  line-height: 1.8;
}

.story-body {
  margin-top: 48rpx;
  overflow: hidden;
}

.story-rich {
  color: #3f3b35;
  font-size: 30rpx;
  line-height: 1.9;
}
