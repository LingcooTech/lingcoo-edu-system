.back-button {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.back-button::after {
  border: 0;
}

.empty-state {
  display: grid;
  justify-items: center;
  gap: 28rpx;
  padding: 80rpx 0;
  text-align: center;
}

.empty-button {
  width: 320rpx;
}

.story-detail-page {
  padding-right: 40rpx;
  padding-left: 40rpx;
  padding-bottom: 130rpx;
  background: #fff;
}

.story-hero {
  overflow: hidden;
  margin: -32rpx -40rpx 0;
  background: transparent;
}

.story-cover {
  display: block;
  width: 100%;
  min-height: 520rpx;
  background: #f1e9e1;
}

.story-title {
  margin-top: 44rpx;
  color: #211f1c;
  font-size: 46rpx;
  font-weight: 400;
  line-height: 1.42;
  letter-spacing: 0;
}

.story-title-first {
  margin-top: 8rpx;
}

.story-excerpt-card {
  position: relative;
  margin-top: 34rpx;
  border-radius: 18rpx;
  background: #fbf8f2;
  padding: 28rpx 32rpx 28rpx 42rpx;
}

.story-excerpt-card::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #9a6a4b;
  content: '';
}

.story-excerpt {
  color: #4d4a45;
  font-size: 32rpx;
  line-height: 1.85;
}

.story-body {
  margin-top: 54rpx;
  overflow: hidden;
}

.story-rich {
  color: #3f3b35;
  font-size: 34rpx;
  line-height: 2;
}
