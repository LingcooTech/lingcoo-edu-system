.back-button {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.back-button::after {
  border: 0;
}

.empty-state {
  display: grid;
  justify-items: center;
  gap: 28rpx;
  padding: 80rpx 0;
  text-align: center;
}

.empty-button {
  width: 320rpx;
}

.story-header {
  overflow: hidden;
}

.story-cover {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #f1e9e1;
}

.story-copy {
  padding: 30rpx;
}

.story-meta {
  margin-bottom: 12rpx;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
}

.story-excerpt {
  margin-top: 18rpx;
}

.story-body {
  margin-top: 24rpx;
  padding: 30rpx;
  overflow: hidden;
}
