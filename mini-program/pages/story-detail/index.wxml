<custom-navbar title="成长故事" show-back="{{true}}" />
<view class="page story-detail-page">
  <skeleton wx:if="{{loading}}" variant="detail" />

  <view wx:elif="{{notFound}}" class="empty-state">
    <view class="section-title">内容不存在或已下线</view>
    <button class="btn btn-outline empty-button" bindtap="goBack">返回</button>
  </view>

  <block wx:else>
    <view wx:if="{{story.coverUrl}}" class="story-hero">
      <image class="story-cover" src="{{story.coverUrl}}" mode="widthFix" />
    </view>

    <view class="story-title {{story.coverUrl ? '' : 'story-title-first'}}">{{story.title}}</view>

    <view wx:if="{{story.excerpt}}" class="story-excerpt-card">
      <view class="story-excerpt">{{story.excerpt}}</view>
    </view>

    <view class="story-body">
      <block-renderer wx:if="{{blocks.length}}" blocks="{{blocks}}" variant="reading" />
      <block wx:elif="{{htmlSegments.length}}">
        <block wx:for="{{htmlSegments}}" wx:key="index" wx:for-item="segment">
          <rich-text wx:if="{{segment.type == 'html'}}" class="story-rich" nodes="{{segment.html}}" />
          <scroll-view wx:else class="story-image-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <image
              wx:for="{{segment.urls}}"
              wx:key="*this"
              wx:for-item="url"
              class="story-scroll-image"
              src="{{url}}"
              mode="aspectFill"
            />
          </scroll-view>
        </block>
      </block>
      <view wx:else class="empty compact-empty">暂无正文</view>
    </view>
  </block>
</view>
