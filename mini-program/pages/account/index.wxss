.account-card,
.bind-card,
.panel {
  padding: 32rpx;
}

.account-heading {
  align-items: flex-start;
}

.account-title {
  margin-top: 14rpx;
}

.account-desc {
  margin-top: 18rpx;
}

.account-phone {
  margin-top: 10rpx;
  font-size: 26rpx;
}

.text-button,
.mini-button {
  width: auto;
  height: 52rpx;
  border: 0;
  border-radius: 999rpx;
  background: #eef5f1;
  color: #1f6f5b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  padding: 0 20rpx;
}

.text-button::after,
.mini-button::after {
  border: 0;
}

.password-note {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.login-button {
  margin-top: 28rpx;
  width: 100%;
}

.account-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.account-actions .btn {
  width: 100%;
  min-width: 0;
  padding: 0 18rpx;
  font-size: 26rpx;
}

.bind-hint {
  margin: 10rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.bind-button {
  margin-top: 22rpx;
}

.test-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
  color: #8a948e;
  font-size: 23rpx;
}

.test-divider::before,
.test-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(31, 43, 36, 0.1);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.stat-card {
  min-height: 116rpx;
  border: 1rpx solid rgba(31, 43, 36, 0.08);
  border-radius: 18rpx;
  background: #fff;
  padding: 20rpx 10rpx;
  text-align: center;
}

.stat-value {
  color: #1f2b24;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
}

.stat-label {
  margin-top: 8rpx;
  color: #6c766f;
  font-size: 22rpx;
}

.item-list {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.info-row,
.stack-row,
.notification-row {
  border-top: 1rpx solid rgba(31, 43, 36, 0.08);
  padding-top: 18rpx;
}

.item-list > .info-row:first-child,
.item-list > .stack-row:first-child,
.item-list > .notification-row:first-child {
  border-top: 0;
  padding-top: 0;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.row-title {
  color: #1f2b24;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.row-meta,
.row-side {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.45;
}

.row-side {
  max-width: 220rpx;
  margin-top: 0;
  text-align: right;
}

.balance-pill,
.order-status,
.attendance-status,
.notice-status,
.seat-status {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.balance-pill {
  background: #e9f4ef;
  color: #1f6f5b;
}

.order-status,
.attendance-status,
.notice-status,
.seat-status {
  background: #f2f0ea;
  color: #5d655f;
}

.order-status.pending,
.notice-status.unread,
.notice-status.submitted,
.seat-status.pending_payment {
  background: #fff4d8;
  color: #8a5a00;
}

.order-status.paid,
.notice-status.reviewed,
.seat-status.reserved {
  background: #e9f4ef;
  color: #1f6f5b;
}

.notice-status.needs_revision {
  background: #f8e7e7;
  color: #9a3412;
}

.seat-status.cancelled,
.seat-status.expired {
  background: #f8e7e7;
  color: #9a3412;
}

.reschedule-button {
  display: inline-block;
  margin-top: 16rpx;
}

.homework-form {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.picker-field {
  min-height: 88rpx;
  border: 1rpx solid rgba(31, 43, 36, 0.12);
  border-radius: 18rpx;
  background: #fff;
  color: #1f2b24;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 88rpx;
  padding: 0 24rpx;
}

.homework-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  line-height: 1.6;
  padding: 22rpx 24rpx;
}

.homework-textarea.small {
  min-height: 130rpx;
}

.homework-submit {
  width: 100%;
}

.homework-list {
  margin-top: 28rpx;
}

.order-line,
.notice-footer {
  margin-top: 12rpx;
}

.order-amount {
  color: #1f2b24;
  font-size: 28rpx;
  font-weight: 900;
}

.attendance-topic,
.notice-body,
.teacher-feedback {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.teacher-feedback {
  border-radius: 18rpx;
  background: #f2f0ea;
  padding: 18rpx;
}

.compact-empty {
  padding: 36rpx 0 6rpx;
}

.quick-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
