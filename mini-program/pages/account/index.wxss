.account-page {
  padding-bottom: 130rpx;
  background: #f5f3ef;
}

.hub-card {
  overflow: hidden;
  border-radius: 0 0 34rpx 34rpx;
  margin: -24rpx -24rpx 0;
  margin-top: -88px;
  padding: calc(88px + 34rpx) 30rpx 34rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 224, 143, 0.72), rgba(255, 224, 143, 0) 34%),
    linear-gradient(180deg, #f4ddc4 0%, #f7eee5 100%);
}

.hub-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hub-eyebrow {
  color: #6b6258;
  font-size: 25rpx;
  font-weight: 700;
}

.hub-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.28;
}

.profile-pill {
  display: flex;
  max-width: 310rpx;
  flex-shrink: 0;
  align-items: center;
  gap: 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  padding: 10rpx 16rpx 10rpx 10rpx;
}

.profile-avatar {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
}

.profile-info {
  min-width: 0;
}

.profile-name,
.profile-phone {
  max-width: 210rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-name {
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.profile-phone {
  margin-top: 3rpx;
  color: #8b857c;
  font-size: 20rpx;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 34rpx;
}

.hero-metric {
  min-height: 112rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  padding: 18rpx 8rpx;
  text-align: center;
}

.metric-hover {
  background: #f1e9e1;
}

.metric-value {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.08;
}

.metric-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 21rpx;
  line-height: 1.2;
}

.password-note {
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.teacher-hub {
  background:
    radial-gradient(circle at 82% 18%, rgba(196, 220, 255, 0.74), rgba(196, 220, 255, 0) 35%),
    linear-gradient(180deg, #e8f0f7 0%, #f4efe8 100%);
}

.teacher-summary {
  margin-top: 34rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  padding: 26rpx;
}

.teacher-summary-title {
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.55;
}

.teacher-main-action {
  margin-top: 24rpx;
  width: 100%;
}

.teacher-entry-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.entry-panel,
.panel,
.overview-card {
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.entry-panel:active,
.panel:active,
.overview-card:active {
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.entry-panel {
  padding: 28rpx 18rpx 20rpx;
}

.entry-title {
  padding: 0 12rpx 18rpx;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx 6rpx;
}

.entry-item {
  position: relative;
  display: flex;
  min-height: 138rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.entry-hover {
  background: #f7f3ee;
}

.entry-symbol {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f7e8dc;
  color: #9a6a4b;
  font-size: 25rpx;
  font-weight: 900;
}

.entry-label {
  margin-top: 12rpx;
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.entry-badge {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  min-width: 34rpx;
  border-radius: 999rpx;
  background: #c15c3a;
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  padding: 7rpx 10rpx;
  text-align: center;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-link,
.inline-action {
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
}

.child-list {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.child-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 18rpx;
  background: #fbfaf7;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.04);
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.child-row:active {
  background: #f7f3ee;
  transform: scale(0.99);
}

.child-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.3;
}

.child-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 23rpx;
}

.child-balance {
  min-width: 110rpx;
  text-align: right;
}

.child-balance-value {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.child-balance-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.overview-grid {
  display: grid;
  gap: 18rpx;
}

.overview-card {
  min-height: 250rpx;
}

.next-time {
  margin-top: 24rpx;
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.15;
}

.next-title,
.feedback-title {
  margin-top: 14rpx;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.next-meta,
.feedback-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.inline-action {
  display: inline-flex;
  margin-top: 22rpx;
}

.todo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  border-radius: 16rpx;
  background: #fbfaf7;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.04);
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.todo-row:active {
  background: #f7f3ee;
  transform: scale(0.99);
}

.todo-hover {
  background: #f1e9e1;
}

.todo-label {
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.todo-value {
  color: #9a6a4b;
  font-size: 30rpx;
  font-weight: 900;
}

.feedback-content {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 16rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.logout-wrap {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}

.logout-button {
  background: #ebe7df;
  color: #57534e;
}

.guest-hero {
  display: flex;
  min-height: 430rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  margin: -24rpx -24rpx 0;
  margin-top: -88px;
  padding: calc(88px + 46rpx) 30rpx 42rpx;
  background:
    radial-gradient(circle at 92% 38%, rgba(206, 222, 203, 0.72), rgba(206, 222, 203, 0) 24%),
    radial-gradient(circle at 8% 54%, rgba(232, 196, 144, 0.28), rgba(232, 196, 144, 0) 26%),
    linear-gradient(180deg, #fff0dc 0%, #f9efe4 70%, #f5f3ef 100%);
  text-align: center;
}

.guest-avatar {
  display: flex;
  width: 148rpx;
  height: 148rpx;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #fff;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.52);
  color: #9a6a4b;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.08);
}

.guest-avatar-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #d3a67c;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.guest-state {
  margin-top: 14rpx;
  border: 1rpx solid rgba(154, 106, 75, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
  padding: 9rpx 24rpx;
}

.guest-title {
  margin-top: 24rpx;
  color: #211f1c;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.guest-desc {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: #8b857c;
  font-size: 25rpx;
  line-height: 1.6;
}

.guest-login-button {
  width: 520rpx;
  max-width: 100%;
  margin-top: 30rpx;
  background: #a9704c;
  box-shadow: 0 12rpx 28rpx rgba(154, 106, 75, 0.22);
}

.guest-panel {
  margin-top: 22rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(33, 31, 28, 0.05);
  padding: 24rpx;
}

.teacher-guest-panel {
  margin-top: 18rpx;
}

.guest-panel-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.guest-title-icon {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f7e8dc;
  color: #c46f2e;
  font-size: 22rpx;
  font-weight: 900;
}

.guest-title-icon.teacher {
  background: #f1e9e1;
  color: #9a6a4b;
}

.guest-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.guest-tool {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 106rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 18rpx;
  background: #fbfaf7;
  padding: 16rpx;
}

.guest-tool-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
}

.guest-tool-icon.warm {
  background: #f6a35d;
}

.guest-tool-icon.green {
  background: #83c883;
}

.guest-tool-icon.blue {
  background: #83bdf1;
}

.guest-tool-icon.purple {
  background: #aa8ce8;
}

.guest-tool-icon.yellow {
  background: #e9bd49;
}

.guest-tool-title {
  color: #211f1c;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.guest-tool-desc {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 21rpx;
  line-height: 1.35;
}

.bind-hint {
  margin: 10rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.bind-button {
  margin-top: 22rpx;
  width: 100%;
}

.test-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
  color: #8b857c;
  font-size: 23rpx;
}

.test-divider::before,
.test-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(33, 31, 28, 0.1);
}

.sheet-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.42);
}

.login-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  margin: 0 auto 30rpx;
}

.sheet-title {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
}

.sheet-desc {
  margin-top: 12rpx;
  color: #8b857c;
  font-size: 26rpx;
  line-height: 1.55;
}

.sheet-close {
  width: 100%;
  height: 76rpx;
  margin-top: 18rpx;
  border: 0;
  background: transparent;
  color: #8b857c;
  font-size: 26rpx;
  line-height: 76rpx;
}

.sheet-close::after {
  border: 0;
}
