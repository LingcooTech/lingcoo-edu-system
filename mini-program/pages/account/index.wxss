.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 32rpx;
}

.profile-avatar {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
}

.profile-body {
  flex: 1;
  min-width: 0;
}

.profile-name {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.profile-phone {
  margin-top: 8rpx;
  font-size: 25rpx;
}

.password-note {
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.capsule-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.capsule {
  min-height: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 20rpx;
  background: #fff;
  padding: 20rpx 8rpx;
}

.capsule-hover {
  background: #f3f0ea;
}

.capsule-value {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.1;
}

.capsule-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.entry-list {
  margin-top: 24rpx;
  padding: 6rpx 28rpx;
}

.entry-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.07);
}

.entry-row:last-child {
  border-bottom: 0;
}

.entry-row-hover {
  background: #f7f5f0;
}

.entry-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f1e9e1;
  font-size: 36rpx;
}

.entry-text {
  flex: 1;
  min-width: 0;
}

.entry-label {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.entry-desc {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.4;
}

.entry-badge {
  flex-shrink: 0;
  min-width: 34rpx;
  border-radius: 999rpx;
  background: #e5484d;
  color: #fff;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  padding: 7rpx 11rpx;
  text-align: center;
}

.entry-arrow {
  flex-shrink: 0;
  color: #c2c8c1;
  font-size: 38rpx;
  line-height: 1;
}

.login-card {
  padding: 36rpx 32rpx;
}

.login-title {
  margin-top: 12rpx;
}

.login-desc {
  margin-top: 16rpx;
}

.login-button {
  margin-top: 30rpx;
  width: 100%;
}

.bind-card {
  padding: 32rpx;
}

.bind-hint {
  margin: 10rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.bind-button {
  margin-top: 22rpx;
}

.test-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
  color: #8b857c;
  font-size: 23rpx;
}

.test-divider::before,
.test-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(33, 31, 28, 0.1);
}
