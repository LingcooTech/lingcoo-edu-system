.hub-card {
  overflow: hidden;
  padding: 32rpx;
}

.hub-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hub-eyebrow {
  color: #8b857c;
  font-size: 24rpx;
  font-weight: 700;
}

.hub-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.28;
}

.profile-pill {
  display: flex;
  max-width: 310rpx;
  flex-shrink: 0;
  align-items: center;
  gap: 14rpx;
  border-radius: 999rpx;
  background: #f7f1eb;
  padding: 10rpx 16rpx 10rpx 10rpx;
}

.profile-avatar {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
}

.profile-info {
  min-width: 0;
}

.profile-name,
.profile-phone {
  max-width: 210rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-name {
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.profile-phone {
  margin-top: 3rpx;
  color: #8b857c;
  font-size: 20rpx;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 34rpx;
}

.hero-metric {
  min-height: 112rpx;
  border-radius: 18rpx;
  background: #fbfaf7;
  padding: 18rpx 8rpx;
  text-align: center;
}

.metric-hover {
  background: #f1e9e1;
}

.metric-value {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.08;
}

.metric-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 21rpx;
  line-height: 1.2;
}

.password-note {
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-card {
  position: relative;
  display: flex;
  min-height: 132rpx;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 22rpx;
  background: #fff;
  padding: 22rpx;
  box-shadow: 0 10rpx 26rpx rgba(33, 31, 28, 0.05);
}

.quick-card-hover {
  background: #f7f5f0;
}

.quick-symbol {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 25rpx;
  font-weight: 900;
}

.quick-text {
  min-width: 0;
}

.quick-label {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.25;
}

.quick-desc {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.3;
}

.quick-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  min-width: 34rpx;
  border-radius: 999rpx;
  background: #c15c3a;
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  padding: 7rpx 10rpx;
  text-align: center;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-link,
.inline-action {
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
}

.child-list {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.child-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 18rpx;
  background: #fbfaf7;
  padding: 20rpx;
}

.child-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.3;
}

.child-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 23rpx;
}

.child-balance {
  min-width: 110rpx;
  text-align: right;
}

.child-balance-value {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.child-balance-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.overview-grid {
  display: grid;
  gap: 18rpx;
}

.overview-card {
  min-height: 250rpx;
}

.next-time {
  margin-top: 24rpx;
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.15;
}

.next-title,
.feedback-title {
  margin-top: 14rpx;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.next-meta,
.feedback-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.inline-action {
  display: inline-flex;
  margin-top: 22rpx;
}

.todo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  border-radius: 16rpx;
  background: #fbfaf7;
  padding: 20rpx;
}

.todo-hover {
  background: #f1e9e1;
}

.todo-label {
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.todo-value {
  color: #9a6a4b;
  font-size: 30rpx;
  font-weight: 900;
}

.feedback-content {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 16rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.logout-wrap {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}

.logout-button {
  background: #ebe7df;
  color: #57534e;
}

.login-card {
  padding: 36rpx 32rpx;
}

.login-title {
  margin-top: 12rpx;
}

.login-desc {
  margin-top: 16rpx;
}

.login-button {
  margin-top: 30rpx;
  width: 100%;
}

.bind-card {
  padding: 32rpx;
}

.bind-hint {
  margin: 10rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.bind-button {
  margin-top: 22rpx;
}

.test-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
  color: #8b857c;
  font-size: 23rpx;
}

.test-divider::before,
.test-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(33, 31, 28, 0.1);
}
