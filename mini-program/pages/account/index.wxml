<custom-navbar title="我的" transparent="{{!navSolid}}" />
<view class="page account-page">
  <skeleton wx:if="{{booting}}" variant="hub" />
  <block wx:elif="{{account && account.role == 'admin'}}">
    <admin-dashboard-panel
      id="adminDashboard"
      can-switch-role="{{canSwitchWorkRole}}"
      switching-role="{{switchingRole}}"
      bind:switchrole="onSwitchWorkRole"
    />

    <view class="logout-wrap">
      <button class="mini-button logout-button" bindtap="onLogout">退出登录</button>
    </view>
  </block>

  <block wx:elif="{{account && account.role == 'teacher'}}">
    <view class="teacher-profile-hero">
      <view class="teacher-profile-avatar">
        <image
          wx:if="{{teacherProfile && teacherProfile.teacher.avatarUrl}}"
          src="{{teacherProfile.teacher.avatarUrl}}"
          mode="aspectFill"
        />
        <text wx:else>{{avatarText}}</text>
      </view>
      <view class="teacher-profile-name">
        {{teacherProfile ? teacherProfile.teacher.name : account.displayName || '老师'}}
      </view>
      <view class="teacher-profile-title">
        {{teacherProfile ? teacherProfile.teacher.title || '授课老师' : '授课老师'}}
        <text wx:if="{{teacherProfile && teacherProfile.institution}}"> · {{teacherProfile.institution.name}}</text>
      </view>
      <view wx:if="{{teacherProfile && teacherProfile.teacher.tagline}}" class="teacher-profile-tagline">
        {{teacherProfile.teacher.tagline}}
      </view>
    </view>

    <skeleton wx:if="{{teacherProfileLoading && !teacherProfile}}" variant="hub" />

    <block wx:if="{{teacherProfile}}">
      <view class="teacher-profile-card">
        <view class="teacher-profile-card-head">
          <view>
            <view class="teacher-profile-card-title">账号信息</view>
            <view class="teacher-profile-card-desc">账号资料由管理员统一维护</view>
          </view>
          <view class="teacher-account-status">正常</view>
        </view>
        <view class="teacher-account-row">
          <text>登录手机号</text>
          <text>{{teacherProfile.account.phone || '未绑定'}}</text>
        </view>
        <view class="teacher-account-row">
          <text>登录邮箱</text>
          <text>{{teacherProfile.account.email || '未绑定'}}</text>
        </view>
      </view>

      <view class="teacher-profile-card">
        <view class="teacher-profile-card-head">
          <view>
            <view class="teacher-profile-card-title">个人介绍</view>
            <view class="teacher-profile-card-desc">家长看到的老师公开资料</view>
          </view>
          <view class="teacher-profile-completeness">
            {{teacherProfile.teacher.avatarUrl && teacherProfile.teacher.bio ? '已完善' : '待完善'}}
          </view>
        </view>
        <view class="teacher-profile-overview">
          <view class="teacher-profile-card-avatar">
            <image
              wx:if="{{teacherProfile.teacher.avatarUrl}}"
              src="{{teacherProfile.teacher.avatarUrl}}"
              mode="aspectFill"
            />
            <text wx:else>{{avatarText}}</text>
          </view>
          <view class="teacher-profile-overview-copy">
            <view class="teacher-profile-overview-name">
              {{teacherProfile.teacher.name || '老师'}}
              <text>{{teacherProfile.teacher.title || '授课老师'}}</text>
            </view>
            <view wx:if="{{teacherProfile.teacher.bio}}" class="teacher-profile-copy">{{teacherProfile.teacher.bio}}</view>
            <view wx:else class="teacher-profile-empty">上传照片并填写介绍，让家长更快了解你</view>
          </view>
        </view>
        <view wx:if="{{teacherProfile.teacher.specialties.length}}" class="teacher-specialties">
          <view
            wx:for="{{teacherProfile.teacher.specialties}}"
            wx:key="*this"
            class="teacher-specialty"
          >{{item}}</view>
        </view>
        <view class="teacher-profile-summary">
          <view>
            <view class="teacher-profile-summary-label">教龄</view>
            <view class="teacher-profile-summary-value">
              {{teacherProfile.teacher.teachingYears || '待完善'}}
            </view>
          </view>
          <view>
            <view class="teacher-profile-summary-label">教学经历</view>
            <view class="teacher-profile-summary-value line-clamp">
              {{teacherProfile.teacher.teachingExperience || '待完善'}}
            </view>
          </view>
        </view>
        <view class="teacher-profile-actions">
          <navigator class="teacher-profile-action secondary" url="/pages/teacher-profile-edit/index">
            编辑资料
          </navigator>
          <navigator
            class="teacher-profile-action primary"
            url="/pages/teacher-detail/index?id={{teacherProfile.teacher.id}}"
          >
            预览详情
          </navigator>
        </view>
      </view>
    </block>

    <button
      wx:if="{{canSwitchWorkRole}}"
      class="mini-button teacher-role-button"
      loading="{{switchingRole}}"
      disabled="{{switchingRole}}"
      bindtap="onSwitchWorkRole"
    >切换到管理看板</button>

    <view class="logout-wrap">
      <button class="mini-button logout-button" bindtap="onLogout">退出登录</button>
    </view>
  </block>

  <block wx:elif="{{account}}">
    <view class="hub-card">
      <view class="hub-top">
        <view>
          <view class="hub-title">
            成长中心
          </view>
        </view>
        <navigator
          class="profile-pill"
          url="/pages/account-profile/index"
          hover-class="profile-hover"
        >
          <view wx:if="{{stats.unreadNotifications}}" class="profile-dot"></view>
          <view class="profile-avatar">{{avatarText}}</view>
          <view class="profile-info">
            <view class="profile-name">{{account.displayName || '用户'}}</view>
            <view wx:if="{{account.phone}}" class="profile-phone">{{account.phone}}</view>
            <view wx:else class="profile-phone muted">手机号快捷登录</view>
          </view>
        </navigator>
      </view>

      <view class="hero-metrics">
        <navigator class="hero-metric" url="/pages/account-students/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.childCount}}</view>
          <view class="metric-label">成长档案</view>
        </navigator>
        <navigator class="hero-metric" url="/pages/account-lessons/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.totalBalance}}</view>
          <view class="metric-label">课时数</view>
        </navigator>
        <navigator class="hero-metric" url="/pages/account-interactions/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.interactionStars}}</view>
          <view class="metric-label">本月星星</view>
        </navigator>
        <navigator class="hero-metric" url="/pages/account-tasks/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.pendingTasks}}</view>
          <view class="metric-label">待处理</view>
        </navigator>
      </view>
    </view>

    <view wx:if="{{defaultPassword}}" class="password-note">
      初始密码：{{defaultPassword}}。手机号账号已同步创建。
    </view>

    <navigator
      wx:if="{{reservationReminder}}"
      class="section core-panel reservation-reminder"
      url="/pages/account-trials/index"
      hover-class="core-link-hover"
    >
      <view class="reservation-head">
        <view>
          <view class="reservation-kicker">试听提醒</view>
          <view class="reservation-title">{{reservationReminder.title}}</view>
        </view>
        <view class="reservation-status">{{reservationReminder.statusLine}}</view>
      </view>
      <view class="reservation-lines">
        <view>时间：{{reservationReminder.timeLine}}</view>
        <view>课程：{{reservationReminder.courseLine}}</view>
        <view>空间：{{reservationReminder.locationLine}}</view>
      </view>
      <view class="reservation-link">查看全部试听席位</view>
    </navigator>

    <view class="section core-panel">
      <view class="core-head">
        <view class="core-title">最近安排</view>
        <navigator
          class="core-link"
          url="/pages/account-schedule/index"
          hover-class="core-link-hover"
        >
          全部课表
        </navigator>
      </view>
      <block wx:if="{{nextLesson}}">
        <view class="next-lesson-card">
          <view class="next-lesson-content">
            <view class="lesson-date-row">
              <view class="lesson-date">{{nextLesson.dateLabel}}</view>
              <view class="lesson-time">{{nextLesson.timeRangeLabel}}</view>
            </view>
            <view class="lesson-lines">
              <view class="lesson-line">课程：{{nextLesson.courseLine}}</view>
              <view class="lesson-line">班级：{{nextLesson.classLine}}</view>
              <view class="lesson-line">空间：{{nextLesson.locationLine}}</view>
            </view>
          </view>
          <view wx:if="{{nextLesson.checkedIn}}" class="attendance-status next-lesson-status">
            {{nextLesson.attendanceStatusLabel}}
          </view>
          <button
            wx:elif="{{nextLesson.canCheckIn}}"
            class="mini-button core-checkin-button"
            data-session-id="{{nextLesson.sessionId}}"
            data-student-id="{{nextLesson.student.id}}"
            data-key="{{nextLesson.checkInKey}}"
            loading="{{checkingInKey == nextLesson.checkInKey}}"
            disabled="{{checkingInKey == nextLesson.checkInKey}}"
            bindtap="onParentCheckIn"
          >
            签到
          </button>
          <view wx:else class="attendance-status disabled next-lesson-status">待开放</view>
        </view>
      </block>
      <view wx:else class="empty compact-empty core-empty">近期暂无安排</view>
    </view>

    <view class="section core-panel">
      <view class="core-head">
        <view class="core-title">成长互动</view>
        <navigator
          class="core-link"
          url="/pages/account-interactions/index"
          hover-class="core-link-hover"
        >
          查看全部
        </navigator>
      </view>
      <view class="interaction-actions">
        <navigator
          class="interaction-action"
          url="/pages/account-interactions/index"
          hover-class="interaction-action-hover"
        >
          <view class="interaction-action-icon amber">
            <image src="{{guestIcons.star}}" mode="aspectFit" />
          </view>
          <view class="interaction-action-label">课堂表现</view>
        </navigator>
        <navigator
          class="interaction-action"
          url="/pages/account-homework/index?tab=assignments"
          hover-class="interaction-action-hover"
        >
          <view class="interaction-action-icon green">
            <image src="{{guestIcons.check}}" mode="aspectFit" />
          </view>
          <view class="interaction-action-label">查看作业</view>
          <view wx:if="{{stats.homeworkAssignments}}" class="interaction-action-badge">
            {{stats.homeworkAssignments}}
          </view>
        </navigator>
        <navigator
          class="interaction-action"
          url="/pages/account-homework/index?tab=checkin"
          hover-class="interaction-action-hover"
        >
          <view class="interaction-action-icon blue">
            <image src="{{guestIcons.message}}" mode="aspectFit" />
          </view>
          <view class="interaction-action-label">快捷打卡</view>
        </navigator>
        <navigator
          class="interaction-action"
          url="/pages/account-homework/index?tab=records"
          hover-class="interaction-action-hover"
        >
          <view class="interaction-action-icon violet">
            <image src="{{guestIcons.clock}}" mode="aspectFit" />
          </view>
          <view class="interaction-action-label">打卡记录</view>
        </navigator>
        <navigator
          class="interaction-action"
          url="/pages/account-gallery/index"
          hover-class="interaction-action-hover"
        >
          <view class="interaction-action-icon rose">
            <image src="{{guestIcons.calendar}}" mode="aspectFit" />
          </view>
          <view class="interaction-action-label">作品展示</view>
        </navigator>
        <navigator
          class="interaction-action"
          url="/pages/account-growth-report/index"
          hover-class="interaction-action-hover"
        >
          <view class="interaction-action-icon teal">
            <image src="{{guestIcons.users}}" mode="aspectFit" />
          </view>
          <view class="interaction-action-label">成长报告</view>
        </navigator>
      </view>
    </view>

    <view class="logout-wrap">
      <button class="mini-button logout-button" bindtap="onLogout">退出登录</button>
    </view>
  </block>

  <block wx:else>
    <view class="guest-hero">
      <view class="guest-avatar">
        <image class="guest-avatar-icon" src="{{guestIcons.avatar}}" mode="aspectFit" />
      </view>
      <view class="guest-state">未登录</view>
      <view class="guest-title">一起见证成长</view>
      <view class="guest-desc">使用手机号快捷登录，查看成长与课程服务。</view>
      <button
        class="btn btn-primary guest-login-button"
        open-type="getPhoneNumber"
        bindgetphonenumber="onWechatLogin"
        loading="{{loading}}"
        disabled="{{loading || binding}}"
      >
        <view wx:if="{{loading || binding}}">登录中...</view>
        <view wx:else class="phone-login-content">
          <view>手机号快捷登录</view>
        </view>
      </button>
    </view>

    <view class="guest-panel">
      <view class="guest-panel-title">
        <view class="guest-title-icon">
          <image class="guest-title-image" src="{{guestIcons.parent}}" mode="aspectFit" />
        </view>
        <view>成长中心</view>
      </view>
      <view class="guest-grid">
        <view class="guest-tool">
          <view class="guest-tool-icon warm">
            <image class="guest-tool-image" src="{{guestIcons.calendar}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">课表</view>
            <view class="guest-tool-desc">查看课程安排</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon green">
            <image class="guest-tool-image" src="{{guestIcons.clock}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">服务记录</view>
            <view class="guest-tool-desc">了解次数与明细</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon blue">
            <image class="guest-tool-image" src="{{guestIcons.headset}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">预约试听</view>
            <view class="guest-tool-desc">管理预约与报名</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon purple">
            <image class="guest-tool-image" src="{{guestIcons.message}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">成长反馈</view>
            <view class="guest-tool-desc">接收服务通知</view>
          </view>
        </view>
      </view>
    </view>

    <view class="guest-panel teacher-guest-panel">
      <view class="guest-panel-title">
        <view class="guest-title-icon teacher">
          <image class="guest-title-image" src="{{guestIcons.teacher}}" mode="aspectFit" />
        </view>
        <view>老师工作台</view>
      </view>
      <view class="guest-grid">
        <view class="guest-tool">
          <view class="guest-tool-icon yellow">
            <image class="guest-tool-image" src="{{guestIcons.calendarCheck}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">课表</view>
            <view class="guest-tool-desc">查看当天安排</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon green">
            <image class="guest-tool-image" src="{{guestIcons.users}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">成员管理</view>
            <view class="guest-tool-desc">查看成员信息</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon blue">
            <image class="guest-tool-image" src="{{guestIcons.check}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">签到管理</view>
            <view class="guest-tool-desc">处理现场签到</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon purple">
            <image class="guest-tool-image" src="{{guestIcons.star}}" mode="aspectFit" />
          </view>
          <view>
            <view class="guest-tool-title">互动反馈</view>
            <view class="guest-tool-desc">记录现场表现</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{loginSheetVisible}}" class="sheet-mask" bindtap="closeLoginSheet">
    <view class="login-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">授权手机号</view>
      <view class="sheet-desc">当前账号还未绑定手机号，授权后将自动进入成长中心、老师工作台或管理看板。</view>
      <button
        class="btn btn-primary bind-button"
        open-type="getPhoneNumber"
        bindgetphonenumber="onPhoneAuth"
        loading="{{binding}}"
        disabled="{{binding || loading}}"
      >
        {{binding ? '授权中...' : '授权手机号并登录'}}
      </button>
      <button class="sheet-close" bindtap="closeLoginSheet">稍后再说</button>
    </view>
  </view>
</view>
<tabbar role="{{account.role}}" />
