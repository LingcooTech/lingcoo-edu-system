<custom-navbar title="我的" transparent="{{!navSolid}}" />
<view class="page account-page">
  <skeleton wx:if="{{booting}}" variant="hub" />
  <block wx:elif="{{account && account.role == 'teacher'}}">
    <teacher-workbench-panel id="teacherWorkbench" />

    <view class="logout-wrap">
      <button class="mini-button logout-button" bindtap="onLogout">退出登录</button>
    </view>
  </block>

  <block wx:elif="{{account}}">
    <view class="hub-card">
      <view class="hub-top">
        <view>
          <view class="hub-eyebrow">我的</view>
          <view class="hub-title">
            {{childSummaries[0] ? childSummaries[0].name + ' 的学习近况' : '学习近况'}}
          </view>
        </view>
        <view class="profile-pill">
          <view class="profile-avatar">{{avatarText}}</view>
          <view class="profile-info">
            <view class="profile-name">{{account.displayName || '家长'}}</view>
            <view wx:if="{{account.phone}}" class="profile-phone">{{account.phone}}</view>
            <view wx:else class="profile-phone muted">微信登录</view>
          </view>
        </view>
      </view>

      <view class="hero-metrics">
        <navigator class="hero-metric" url="/pages/account-students/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.childCount}}</view>
          <view class="metric-label">孩子</view>
        </navigator>
        <navigator class="hero-metric" url="/pages/account-students/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.totalBalance}}</view>
          <view class="metric-label">剩余课时</view>
        </navigator>
        <navigator class="hero-metric" url="/pages/account-attendance/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.pendingCheckIns}}</view>
          <view class="metric-label">待签到</view>
        </navigator>
        <navigator class="hero-metric" url="/pages/account-orders/index" hover-class="metric-hover">
          <view class="metric-value">{{stats.pendingTasks}}</view>
          <view class="metric-label">待处理</view>
        </navigator>
      </view>
    </view>

    <view wx:if="{{defaultPassword}}" class="password-note">
      初始密码：{{defaultPassword}}。手机号账号已同步创建。
    </view>

    <view wx:for="{{entryGroups}}" wx:key="title" class="section entry-panel">
      <view class="entry-title">{{item.title}}</view>
      <view class="entry-grid">
        <navigator
          wx:for="{{item.entries}}"
          wx:for-item="entry"
          wx:key="key"
          class="entry-item"
          url="{{entry.url}}"
          hover-class="entry-hover"
        >
          <view class="entry-symbol">{{entry.symbol}}</view>
          <view class="entry-label">{{entry.label}}</view>
          <view wx:if="{{entry.badge}}" class="entry-badge">{{entry.badge}}</view>
        </navigator>
      </view>
    </view>

    <view class="section panel">
      <view class="section-head">
        <view class="section-title">孩子与课时</view>
        <navigator class="section-link" url="/pages/account-students/index">全部</navigator>
      </view>
      <view wx:if="{{childSummaries.length}}" class="child-list">
        <view wx:for="{{childSummaries}}" wx:key="id" class="child-row">
          <view>
            <view class="child-name">{{item.name}}</view>
            <view class="child-meta">{{item.meta}}</view>
          </view>
          <view class="child-balance">
            <view class="child-balance-value">{{item.balance}}</view>
            <view class="child-balance-label">课时</view>
          </view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">暂未关联孩子，请联系机构绑定学员档案。</view>
    </view>

    <view class="section overview-grid">
      <view class="panel overview-card">
        <view class="section-title">下一节课</view>
        <block wx:if="{{nextLesson}}">
          <view class="next-time">{{nextLesson.startsAtLabel}}</view>
          <view class="next-title">{{nextLesson.courseName}} · {{nextLesson.title}}</view>
          <view class="next-meta">
            {{nextLesson.student.name}} · {{nextLesson.class.name}} · {{nextLesson.classroomName}}
          </view>
          <navigator class="inline-action" url="/pages/account-attendance/index">查看课程</navigator>
        </block>
        <view wx:else class="empty compact-empty">近期暂无正式课程安排</view>
      </view>

      <view class="panel overview-card">
        <view class="section-title">待办</view>
        <navigator
          wx:for="{{todoItems}}"
          wx:key="key"
          class="todo-row"
          url="{{item.url}}"
          hover-class="todo-hover"
        >
          <view class="todo-label">{{item.label}}</view>
          <view class="todo-value">{{item.value}}</view>
        </navigator>
      </view>
    </view>

    <view class="section panel">
      <view class="section-head">
        <view class="section-title">最新点评</view>
        <navigator class="section-link" url="/pages/account-feedbacks/index">全部</navigator>
      </view>
      <block wx:if="{{latestFeedback}}">
        <view class="feedback-title">
          {{latestFeedback.studentName}} · {{latestFeedback.courseName}}
        </view>
        <view class="feedback-meta">{{latestFeedback.teacherName}} · {{latestFeedback.createdAtLabel}}</view>
        <view class="feedback-content">{{latestFeedback.content}}</view>
      </block>
      <view wx:else class="empty compact-empty">暂无课后点评</view>
    </view>

    <view class="logout-wrap">
      <button class="mini-button logout-button" bindtap="onLogout">退出登录</button>
    </view>
  </block>

  <block wx:else>
    <view class="guest-hero">
      <view class="guest-avatar">
        <view class="guest-avatar-icon">人</view>
      </view>
      <view class="guest-state">未登录</view>
      <view class="guest-title">登录后使用更多服务</view>
      <view class="guest-desc">家长和老师均可使用微信登录</view>
      <button
        class="btn btn-primary guest-login-button"
        open-type="getPhoneNumber"
        bindgetphonenumber="onWechatLogin"
        loading="{{loading}}"
        disabled="{{loading || binding}}"
      >
        {{loading || binding ? '登录中...' : '微信一键登录'}}
      </button>
    </view>

    <view class="guest-panel">
      <view class="guest-panel-title">
        <view class="guest-title-icon">家</view>
        <view>家长常用</view>
      </view>
      <view class="guest-grid">
        <view class="guest-tool">
          <view class="guest-tool-icon warm">表</view>
          <view>
            <view class="guest-tool-title">孩子课表</view>
            <view class="guest-tool-desc">查看上课安排</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon green">时</view>
          <view>
            <view class="guest-tool-title">课时记录</view>
            <view class="guest-tool-desc">了解余额与明细</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon blue">试</view>
          <view>
            <view class="guest-tool-title">预约试听</view>
            <view class="guest-tool-desc">管理试听与报名</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon purple">信</view>
          <view>
            <view class="guest-tool-title">成长反馈</view>
            <view class="guest-tool-desc">接收老师通知</view>
          </view>
        </view>
      </view>
    </view>

    <view class="guest-panel teacher-guest-panel">
      <view class="guest-panel-title">
        <view class="guest-title-icon teacher">师</view>
        <view>老师常用</view>
      </view>
      <view class="guest-grid">
        <view class="guest-tool">
          <view class="guest-tool-icon yellow">课</view>
          <view>
            <view class="guest-tool-title">今日课表</view>
            <view class="guest-tool-desc">查看当天课程</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon green">员</view>
          <view>
            <view class="guest-tool-title">学员管理</view>
            <view class="guest-tool-desc">查看学员信息</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon blue">点</view>
          <view>
            <view class="guest-tool-title">点名</view>
            <view class="guest-tool-desc">处理课堂签到</view>
          </view>
        </view>
        <view class="guest-tool">
          <view class="guest-tool-icon purple">评</view>
          <view>
            <view class="guest-tool-title">课后反馈</view>
            <view class="guest-tool-desc">记录课堂表现</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{loginSheetVisible}}" class="sheet-mask" bindtap="closeLoginSheet">
    <view class="login-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">授权手机号</view>
      <view class="sheet-desc">当前微信还未绑定账号，授权手机号后将自动进入家长中心或老师工作台。</view>
      <button
        class="btn btn-primary bind-button"
        open-type="getPhoneNumber"
        bindgetphonenumber="onPhoneAuth"
        loading="{{binding}}"
        disabled="{{binding || loading}}"
      >
        {{binding ? '授权中...' : '授权手机号并登录'}}
      </button>
      <button class="sheet-close" bindtap="closeLoginSheet">稍后再说</button>
    </view>
  </view>
</view>
<tabbar />
