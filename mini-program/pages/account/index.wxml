<view class="page">
  <skeleton wx:if="{{booting}}" variant="hub" />
  <block wx:elif="{{account}}">
    <view class="card profile-card">
      <view class="profile-avatar">{{avatarText}}</view>
      <view class="profile-body">
        <view class="profile-name">{{account.displayName || '家长'}}</view>
        <view wx:if="{{account.phone}}" class="profile-phone">{{account.phone}}</view>
        <view wx:else class="profile-phone muted">已用微信登录</view>
      </view>
      <button class="mini-button" bindtap="onLogout">退出</button>
    </view>

    <view wx:if="{{defaultPassword}}" class="password-note">
      初始密码：{{defaultPassword}}。手机号账号已同步创建。
    </view>

    <view class="capsule-grid">
      <navigator class="capsule" url="/pages/account-students/index" hover-class="capsule-hover">
        <view class="capsule-value">{{stats.childCount}}</view>
        <view class="capsule-label">孩子</view>
      </navigator>
      <navigator class="capsule" url="/pages/account-students/index" hover-class="capsule-hover">
        <view class="capsule-value">{{stats.totalBalance}}</view>
        <view class="capsule-label">课时</view>
      </navigator>
      <navigator class="capsule" url="/pages/account-orders/index" hover-class="capsule-hover">
        <view class="capsule-value">{{stats.pendingOrders}}</view>
        <view class="capsule-label">待付</view>
      </navigator>
      <navigator class="capsule" url="/pages/account-notifications/index" hover-class="capsule-hover">
        <view class="capsule-value">{{stats.unreadNotifications}}</view>
        <view class="capsule-label">未读</view>
      </navigator>
    </view>

    <view class="card entry-list">
      <navigator
        wx:for="{{entries}}"
        wx:key="key"
        class="entry-row"
        url="{{item.url}}"
        hover-class="entry-row-hover"
      >
        <view class="entry-icon">{{item.icon}}</view>
        <view class="entry-text">
          <view class="entry-label">{{item.label}}</view>
          <view class="entry-desc">{{item.desc}}</view>
        </view>
        <view wx:if="{{item.key == 'notifications' && stats.unreadNotifications}}" class="entry-badge">
          {{stats.unreadNotifications}}
        </view>
        <view class="entry-arrow">›</view>
      </navigator>
    </view>
  </block>

  <block wx:else>
    <view class="card login-card">
      <view class="title login-title">登录家长中心</view>
      <view class="body-text login-desc">
        微信登录后可查看孩子、课时余额、订单、签到、作业和通知。
      </view>
      <button
        class="btn btn-primary login-button"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="onWechatLogin"
      >
        {{loading ? '登录中...' : '微信登录'}}
      </button>
    </view>

    <form wx:if="{{bindToken}}" class="section card bind-card" bindsubmit="onBindSubmit">
      <view class="section-title">绑定手机号</view>
      <view class="muted bind-hint">正式环境使用微信手机号授权；本地测试可手动填写。</view>
      <button
        class="btn btn-primary bind-button"
        open-type="getPhoneNumber"
        bindgetphonenumber="onPhoneAuth"
        loading="{{binding}}"
        disabled="{{binding}}"
      >
        微信授权手机号
      </button>
      <view class="test-divider">本地测试</view>
      <view class="form-gap">
        <input class="form-field" name="phone" type="number" placeholder="手机号" />
        <input class="form-field" name="displayName" placeholder="家长称呼（选填）" />
      </view>
      <button
        class="btn btn-outline bind-button"
        form-type="submit"
        loading="{{binding}}"
        disabled="{{binding}}"
      >
        {{binding ? '绑定中...' : '手动绑定'}}
      </button>
    </form>
  </block>
</view>
