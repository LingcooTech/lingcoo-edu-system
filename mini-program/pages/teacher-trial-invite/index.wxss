.trial-invite-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 100rpx;
  background: #f6f4f0;
}

.intro-card,
.form-card,
.result-card,
.error-card {
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  padding: 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(65, 45, 31, 0.06);
}

.intro-card {
  background: linear-gradient(145deg, #a87552, #8d5e40);
  color: #fff;
}

.intro-title,
.section-title,
.result-title {
  font-size: 32rpx;
  font-weight: 900;
}

.intro-copy {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.65;
}

.section-title,
.result-title {
  color: #211f1c;
}

.field {
  min-width: 0;
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6b6258;
  font-size: 23rpx;
  font-weight: 800;
}

.picker-value,
.text-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  border: 1rpx solid #e3ded7;
  border-radius: 18rpx;
  background: #fbfaf8;
  color: #211f1c;
  font-size: 25rpx;
  line-height: 78rpx;
  padding: 0 22rpx;
}

.two-columns {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  width: 100%;
  height: 86rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1;
  padding: 0;
}

.primary-button {
  background: #9a6a4b;
  color: #fff;
}

.secondary-button {
  margin-top: 16rpx;
  background: #f1e9e1;
  color: #9a6a4b;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.error-card {
  background: #fff1ef;
  color: #a83f35;
  font-size: 24rpx;
  line-height: 1.55;
}

.result-card {
  text-align: center;
}

.result-mark {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  margin: 4rpx auto 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #9a6a4b;
  color: #fff;
  font-size: 40rpx;
  font-weight: 900;
}

.share-preview {
  margin: 28rpx 0 22rpx;
  border: 1rpx solid rgba(154, 106, 75, 0.2);
  border-radius: 24rpx;
  background: #fbf7f2;
  padding: 28rpx;
  text-align: left;
}

.share-preview-eyebrow {
  color: #9a6a4b;
  font-size: 21rpx;
  font-weight: 850;
}

.share-preview-title {
  margin: 10rpx 0 16rpx;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
}

.share-preview-meta,
.result-copy {
  color: #7f776f;
  font-size: 23rpx;
  line-height: 1.65;
}

.result-copy {
  margin-bottom: 28rpx;
}
