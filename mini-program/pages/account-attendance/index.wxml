<custom-navbar title="上课签到" show-back="{{true}}" />
<view class="page">
  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{needLogin}}" class="empty login-empty">
    请先在“我的”登录
    <button class="btn btn-primary login-empty-btn" bindtap="goLogin">去登录</button>
  </view>
  <block wx:else>
    <view class="card panel">
      <view class="section-title">待签到课次</view>
      <view wx:if="{{checkInSessions.length}}" class="item-list">
        <view wx:for="{{checkInSessions}}" wx:key="checkInKey" class="stack-row">
          <view class="row-between">
            <view>
              <view class="row-title">{{item.courseName}} · {{item.topic}}</view>
              <view class="row-meta">{{item.student.name}} · {{item.class.name}}</view>
            </view>
            <view wx:if="{{item.checkedIn}}" class="attendance-status">{{item.attendanceStatusLabel}}</view>
            <button
              wx:else
              class="mini-button"
              data-session-id="{{item.sessionId}}"
              data-student-id="{{item.student.id}}"
              data-key="{{item.checkInKey}}"
              loading="{{checkingInKey == item.checkInKey}}"
              disabled="{{checkingInKey == item.checkInKey || !item.canCheckIn}}"
              bindtap="onParentCheckIn"
            >
              签到
            </button>
          </view>
          <view class="row-meta">{{item.startsAtLabel}} · {{item.classroomName}}</view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">暂无可签到课次</view>
    </view>

    <view class="section card panel">
      <view class="section-title">签到记录</view>
      <view wx:if="{{attendance.length}}" class="item-list">
        <view wx:for="{{attendance}}" wx:key="id" class="stack-row">
          <view class="row-between">
            <view class="row-title">{{item.courseName}}</view>
            <view class="attendance-status">{{item.statusLabel}}</view>
          </view>
          <view class="row-meta">{{item.studentName}} · {{item.className}} · {{item.startsAtLabel}}</view>
          <view wx:if="{{item.topic}}" class="attendance-topic">{{item.topic}}</view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">暂无签到记录</view>
    </view>
  </block>
</view>
