/* Uses shared list primitives from app.wxss (panel / info-row / row-* / balance-pill). */

.student-card {
  border-radius: 22rpx;
  background: #fbfaf7;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  padding: 22rpx;
}

.student-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  padding: 11rpx 16rpx;
}

.student-course-list {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.student-course {
  border-radius: 18rpx;
  background: #fff;
  padding: 16rpx 18rpx;
}

.student-course-title {
  min-width: 0;
  color: #211f1c;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.student-course-line {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.4;
}

.empty-row {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.35;
  padding: 18rpx;
}
