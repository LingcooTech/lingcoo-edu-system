<custom-navbar title="成长档案" show-back="{{true}}" />
<view class="page">
  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{needLogin}}" class="empty login-empty">
    请先在“我的”登录
    <button class="btn btn-primary login-empty-btn" bindtap="goLogin">去登录</button>
  </view>
  <block wx:else>
    <view class="card panel">
      <view class="section-title">成长档案</view>
      <view wx:if="{{children.length}}" class="item-list">
        <view wx:for="{{children}}" wx:key="id" class="student-card">
          <view class="student-head">
            <view>
              <view class="row-title">{{item.name}}</view>
              <view class="row-meta">{{item.meta}}</view>
            </view>
            <view class="status-pill">{{item.statusLabel}}</view>
          </view>
          <view wx:if="{{item.courses.length}}" class="student-course-list">
            <view
              wx:for="{{item.courses}}"
              wx:for-item="course"
              wx:key="key"
              class="student-course"
            >
              <view class="student-course-title">{{course.courseName}}</view>
              <view class="student-course-line">空间：{{course.campusName}}</view>
              <view class="student-course-line">活动组：{{course.className}}</view>
              <view class="student-course-line">机构导师：{{course.teacherName}}</view>
            </view>
          </view>
          <view wx:else class="empty-row">{{item.emptyCourseText}}</view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">还没有绑定成长档案</view>
    </view>
  </block>
</view>
