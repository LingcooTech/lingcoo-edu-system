.profile-page {
  background:
    radial-gradient(circle at 86% 10%, rgba(255, 224, 143, 0.5), rgba(255, 224, 143, 0) 26%),
    linear-gradient(180deg, #f8ead8 0%, #f5f3ef 42%);
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 34rpx rgba(33, 31, 28, 0.06);
  padding: 28rpx;
}

.profile-avatar-large {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 42rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 24rpx rgba(154, 106, 75, 0.16);
}

.profile-copy {
  min-width: 0;
}

.profile-role {
  color: #8b857c;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.3;
}

.profile-name-large {
  margin-top: 6rpx;
  color: #211f1c;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.25;
}

.profile-phone-large {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.35;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.profile-stat {
  display: flex;
  min-height: 122rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.04);
  padding: 14rpx 8rpx;
  text-align: center;
}

.profile-stat-value {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.profile-stat-label {
  margin-top: 10rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.2;
}

.profile-panel {
  padding: 28rpx 24rpx;
}

.profile-actions {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.profile-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 20rpx;
  background: #fbfaf7;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  padding: 22rpx;
}

.profile-action-title {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.profile-action-desc {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.35;
}

.profile-action-side {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  padding: 12rpx 18rpx;
}

.profile-hover {
  background: #f7f3ee;
}

.logout-wrap {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.logout-button {
  background: #ebe7df;
  color: #57534e;
}
