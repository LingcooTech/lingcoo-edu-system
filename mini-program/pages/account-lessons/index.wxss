.lessons-page {
  background: #f5f3ef;
}

.lesson-account-list {
  display: grid;
  gap: 22rpx;
}

.lesson-account-card {
  padding: 26rpx;
}

.lesson-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-course {
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.lesson-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.4;
}

.lesson-balance {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  padding: 13rpx 18rpx;
}

.renewal-alert {
  position: relative;
  margin-top: 22rpx;
  border: 1rpx solid rgba(164, 95, 58, 0.16);
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff8ef 0%, #fbfaf7 100%);
  padding: 22rpx 96rpx 22rpx 22rpx;
}

.renewal-close {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(154, 106, 75, 0.1);
  color: #9a6a4b;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 48rpx;
  padding: 0;
}

.renewal-close::after,
.renewal-action::after {
  border: 0;
}

.renewal-title {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.renewal-desc {
  margin-top: 8rpx;
  color: #a45f3a;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.renewal-package {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.4;
}

.renewal-action {
  position: absolute;
  right: 18rpx;
  bottom: 22rpx;
  display: flex;
  width: 112rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
  padding: 0;
}

.lesson-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.lesson-summary-item {
  border-radius: 20rpx;
  background: #fbfaf7;
  padding: 18rpx;
  text-align: center;
}

.summary-value {
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  margin-top: 10rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.2;
}

.record-title {
  margin-top: 26rpx;
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.record-list {
  display: grid;
  gap: 12rpx;
  margin-top: 16rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 18rpx;
  background: #fbfaf7;
  padding: 18rpx;
}

.record-main {
  min-width: 0;
}

.record-time {
  color: #211f1c;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.record-topic,
.record-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
  line-height: 1.35;
}

.record-status {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  padding: 11rpx 16rpx;
}

.record-status.pending {
  background: #edf3ea;
  color: #52704a;
}
