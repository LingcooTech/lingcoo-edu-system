.home-page {
  padding-top: 0;
  padding-bottom: 130rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  margin: 0 -24rpx -104rpx;
  padding: 0;
  background: #f6f4f0;
}

.custom-nav {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  left: 0;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  min-width: 0;
}

.nav-logo {
  display: block;
  flex: 0 1 auto;
  width: auto;
  max-width: 100%;
}

.nav-logo-text {
  max-width: 100%;
  overflow: hidden;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 2rpx 8rpx rgba(33, 31, 28, 0.28);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1;
  height: 620rpx;
  background: linear-gradient(
    180deg,
    rgba(33, 31, 28, 0.26) 0%,
    rgba(33, 31, 28, 0.08) 34%,
    rgba(246, 244, 240, 0) 64%,
    rgba(246, 244, 240, 0.86) 100%
  );
  pointer-events: none;
}

.hero-title {
  margin-top: 10rpx;
  color: #211f1c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -0.8px;
}

.hero-subtitle {
  max-width: 640rpx;
  margin-top: 14rpx;
  color: #57534e;
  font-size: 27rpx;
  line-height: 1.6;
  letter-spacing: 0;
}

.hero-swiper-wrap {
  position: relative;
  width: 100%;
  margin-top: 0;
}

.hero-swiper {
  width: 100%;
  height: 620rpx;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: none;
  border: 0;
}

.hero-indicators {
  position: absolute;
  right: 0;
  bottom: 136rpx;
  left: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  pointer-events: none;
}

.hero-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  transition: all 0.2s ease;
}

.hero-indicator.active {
  width: 42rpx;
  background: #fff;
}

.hero-image {
  width: 100%;
  height: 620rpx;
}

.hero-fallback {
  min-height: 620rpx;
  margin-top: 0;
  border-radius: 0 0 36rpx 36rpx;
  background: linear-gradient(180deg, #cfa57d 0%, #ead7c3 66%, #f6f4f0 100%);
  padding: 180rpx 36rpx 120rpx;
  border: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.quick-panel {
  display: flex;
  flex-wrap: nowrap;
  position: relative;
  z-index: 3;
  margin-top: 0;
  border-radius: 28rpx;
  background: #fff;
  padding: 16rpx 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  animation: slide-in-bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.1s both;
}

.quick-action {
  display: flex;
  width: 20%;
  min-width: 0;
  max-width: 20%;
  min-height: 128rpx;
  flex: 0 0 20%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  margin: 0;
  padding: 12rpx 4rpx;
  line-height: 1.1;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-action::after {
  border: 0;
}

.quick-action:active {
  transform: scale(0.95);
}

.quick-action:active .quick-icon-wrap {
  transform: scale(1.05);
}

.quick-action.active {
  background: transparent;
}

.quick-action.active .quick-label {
  color: #9a6a4b;
  font-weight: 800;
}

.quick-icon-wrap {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: transparent;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-icon {
  width: 42rpx;
  height: 42rpx;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-label {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-content {
  margin-top: 18rpx;
  animation: slide-in-bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.intro-sections {
  display: grid;
  gap: 24rpx;
}

.intro-section {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
  padding: 34rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.intro-platform-section {
  background: linear-gradient(180deg, #fff 0%, #fbf8f4 100%);
}

.intro-institution-section {
  background: #fff;
}

.intro-section-title {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
  letter-spacing: 0;
}

.intro-section-text {
  margin-top: 20rpx;
  color: #57534e;
}

.intro-paragraph {
  color: #57534e;
  font-size: 27rpx;
  line-height: 1.82;
}

.intro-paragraph + .intro-paragraph {
  margin-top: 22rpx;
}

.institution-list {
  display: grid;
  gap: 18rpx;
  margin-top: 30rpx;
}

.institution-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  border-radius: 20rpx;
  background: #f8f5f0;
  padding: 20rpx;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.institution-card:active {
  opacity: 0.7;
}

.institution-logo-row {
  display: flex;
  align-items: center;
}

.institution-logo {
  width: 156rpx;
  height: 64rpx;
  flex: 0 0 auto;
  border-radius: 0;
  background: transparent;
}

.institution-body {
  width: 100%;
}

.institution-intro {
  margin-top: 0;
}

.institution-paragraph {
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.78;
}

.institution-paragraph + .institution-paragraph {
  margin-top: 18rpx;
}

.institution-contact {
  margin-top: 14rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-line;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-card {
  border-radius: 18rpx;
  background: #fff;
  padding: 20rpx;
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.stat-card:active {
  transform: scale(0.96);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.highlights {
  display: grid;
  gap: 18rpx;
}

.highlight-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 148rpx;
  padding: 24rpx;
  background-position: center;
  background-size: cover;
  text-align: center;
  border-radius: 24rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.highlight-card:active {
  transform: scale(0.98);
}

.highlight-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 26rpx;
  font-weight: 800;
}

.highlight-card-image {
  border-color: rgba(255, 255, 255, 0.24);
}

.highlight-card-image .highlight-icon {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.highlight-title {
  margin-top: 16rpx;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.highlight-card-image .highlight-text {
  color: #fff;
}

.highlight-card-image .highlight-title {
  color: #fff;
}

.highlight-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.55;
  font-weight: 600;
}

.section-head {
  margin-bottom: 18rpx;
}

.text-button {
  display: inline-flex;
  width: auto;
  height: 60rpx;
  align-items: center;
  border: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 60rpx;
  padding: 0;
}

.text-button::after {
  border: 0;
}

.learning-band {
  margin-right: -24rpx;
  margin-left: -24rpx;
  margin-top: 28rpx;
  padding: 34rpx 24rpx;
  background: #f1ebe3;
}

.learning-section + .learning-section {
  margin-top: 38rpx;
}

.course-list,
.trial-list,
.story-scroll {
  margin-top: 18rpx;
}

.course-card,
.trial-card,
.story-card {
  overflow: hidden;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.course-card:active,
.trial-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.course-cover {
  display: block;
  width: calc(100% + 44rpx);
  height: 230rpx;
  margin: -22rpx -22rpx 20rpx;
  background: #f1e9e1;
}

.course-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
}

.course-price {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.course-meta,
.trial-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.trial-fee {
  margin-top: 10rpx;
  color: #a15c12;
  font-size: 24rpx;
  font-weight: 700;
}

.course-summary {
  margin-top: 12rpx;
}

.trust-teacher-scroll {
  width: 100%;
  white-space: nowrap;
}

.trust-teacher-list {
  display: grid;
  gap: 18rpx;
}

.trust-teacher-card {
  position: relative;
  display: inline-block;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #211f1c;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.08);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  vertical-align: top;
  white-space: normal;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.trust-teacher-card:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 12rpx rgba(33, 31, 28, 0.06);
}

.teacher-section {
  overflow: hidden;
}

.trust-teacher-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.trust-teacher-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 96rpx;
  font-weight: 800;
}

.trust-teacher-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(33, 31, 28, 0.08), rgba(33, 31, 28, 0.88));
}

.trust-teacher-body {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx;
  color: #fff;
}

.trust-teacher-title {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}

.trust-teacher-name {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.trust-teacher-tagline {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.65;
}

.trust-chip {
  display: inline-flex;
  max-width: 100%;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
}

.story-cover {
  display: block;
  width: calc(100% + 44rpx);
  height: 230rpx;
  margin: -22rpx -22rpx 20rpx;
  background: #f1e9e1;
}

.story-meta {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
}

.story-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: -0.3px;
}

.story-summary {
  margin-top: 12rpx;
  color: #57534e;
  line-height: 1.7;
  font-size: 26rpx;
}

.campus-card {
  border-radius: 28rpx;
  background: #fff;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.campus-card:active {
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.campus-card + .campus-card {
  margin-top: 20rpx;
}

.campus-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.campus-title-mark {
  width: 12rpx;
  height: 32rpx;
  flex: 0 0 12rpx;
  border-radius: 999rpx;
  background: #9a6a4b;
}

.campus-title {
  min-width: 0;
  flex: 1;
}

.campus-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  padding-top: 20rpx;
}

.campus-line:first-of-type {
  border-top: 0;
}

.campus-line-clickable:active {
  opacity: 0.72;
}

.campus-address-icon {
  display: flex;
  width: 30rpx;
  height: 34rpx;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  padding-top: 2rpx;
}

.campus-address-pin {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #9a6a4b;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.campus-address-pin::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #9a6a4b;
  content: '';
  transform: translate(-50%, -50%);
}

.campus-value {
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.campus-images {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.campus-image {
  width: 100%;
  height: 210rpx;
  border-radius: 18rpx;
  background: #f1e9e1;
}

.story-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.story-card {
  overflow: hidden;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.story-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.contact-card {
  border-radius: 28rpx;
  background: #211f1c;
  padding: 30rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.contact-card:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 12rpx rgba(33, 31, 28, 0.06);
}

.contact-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: -0.3px;
}

.contact-copy {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  line-height: 1.7;
}

.contact-steps {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx 18rpx;
  margin-top: 28rpx;
}

.contact-step {
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  padding-top: 16rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.contact-step-index {
  margin-bottom: 6rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  font-weight: 800;
}

.contact-row {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.6;
}

.contact-btn {
  margin-top: 28rpx;
  background: #fff;
  color: #211f1c;
}

/* ──────────────────────────────────────────────────────────────── */
/* Loading & Placeholder Animations */
/* ──────────────────────────────────────────────────────────────── */

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

@keyframes pulse-scale {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.02);
    opacity: 0.8;
  }
}

.course-cover,
.story-cover,
.campus-image,
.trust-teacher-cover-fallback {
  background: linear-gradient(90deg, #f1e9e1 0%, #f7f3ee 50%, #f1e9e1 100%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* Empty State Enhancements */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(241, 233, 225, 0.2) 100%);
  border-radius: 24rpx;
  border: 1rpx dashed rgba(33, 31, 28, 0.08);
  margin-top: 20rpx;
}

.empty::before {
  font-size: 88rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.compact-empty {
  padding: 28rpx 0;
  font-size: 26rpx;
  color: #8b857c;
}
