.hero {
  overflow: hidden;
  padding: 30rpx;
}

.hero-title {
  margin-top: 18rpx;
}

.hero-subtitle {
  margin-top: 18rpx;
}

.hero-swiper {
  width: 100%;
  height: 330rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.hero-image {
  width: 100%;
  height: 330rpx;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.hero-btn {
  width: 100%;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-card {
  border-radius: 18rpx;
  background: #fff;
  padding: 20rpx;
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.highlights {
  display: grid;
  gap: 18rpx;
}

.highlight-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 148rpx;
  padding: 24rpx;
  background-position: center;
  background-size: cover;
  text-align: center;
}

.highlight-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 26rpx;
  font-weight: 800;
}

.highlight-card-image {
  border-color: rgba(255, 255, 255, 0.24);
}

.highlight-card-image .highlight-icon {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.highlight-title {
  margin-top: 16rpx;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.highlight-card-image .highlight-text {
  color: #fff;
}

.highlight-card-image .highlight-title {
  color: #fff;
}

.highlight-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.55;
  font-weight: 600;
}

.section-head {
  margin-bottom: 18rpx;
}

.text-button {
  display: inline-flex;
  width: auto;
  height: 60rpx;
  align-items: center;
  border: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 60rpx;
  padding: 0;
}

.text-button::after {
  border: 0;
}

.learning-band {
  margin-right: -24rpx;
  margin-left: -24rpx;
  padding: 34rpx 24rpx;
  background: #eee8de;
}

.learning-section + .learning-section {
  margin-top: 38rpx;
}

.course-list,
.trial-list,
.story-scroll {
  margin-top: 18rpx;
}

.course-card,
.trial-card,
.story-card {
  overflow: hidden;
  padding: 22rpx;
}

.course-cover {
  display: block;
  width: calc(100% + 44rpx);
  height: 230rpx;
  margin: -22rpx -22rpx 20rpx;
  background: #f1e9e1;
}

.course-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
}

.course-price {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.course-meta,
.trial-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.trial-fee {
  margin-top: 10rpx;
  color: #a15c12;
  font-size: 24rpx;
  font-weight: 700;
}

.course-summary {
  margin-top: 12rpx;
}

.trust-teacher-scroll {
  width: 100%;
  white-space: nowrap;
}

.trust-teacher-card {
  position: relative;
  display: inline-block;
  width: 430rpx;
  height: 560rpx;
  margin-right: 18rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #211f1c;
  box-shadow: 0 16rpx 42rpx rgba(33, 31, 28, 0.16);
  vertical-align: top;
  white-space: normal;
}

.trust-teacher-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.trust-teacher-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 96rpx;
  font-weight: 800;
}

.trust-teacher-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(33, 31, 28, 0.08), rgba(33, 31, 28, 0.88));
}

.trust-teacher-body {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx;
  color: #fff;
}

.trust-teacher-title {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  font-weight: 700;
}

.trust-teacher-name {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.trust-teacher-tagline {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.6;
}

.trust-chip {
  display: inline-flex;
  max-width: 100%;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
}

.story-cover {
  display: block;
  width: calc(100% + 44rpx);
  height: 230rpx;
  margin: -22rpx -22rpx 20rpx;
  background: #f1e9e1;
}

.story-meta {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
}

.story-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.story-summary {
  margin-top: 12rpx;
}

.contact-card {
  border-radius: 28rpx;
  background: #211f1c;
  padding: 30rpx;
  color: #fff;
  box-shadow: 0 18rpx 48rpx rgba(33, 31, 28, 0.18);
}

.contact-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.contact-copy {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  line-height: 1.65;
}

.contact-steps {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx 18rpx;
  margin-top: 28rpx;
}

.contact-step {
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  padding-top: 16rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.contact-step-index {
  margin-bottom: 6rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  font-weight: 800;
}

.contact-row {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.6;
}

.contact-btn {
  margin-top: 28rpx;
  background: #fff;
  color: #211f1c;
}
