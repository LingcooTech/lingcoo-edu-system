.home-page {
  padding-top: 0;
}

.hero {
  position: relative;
  overflow: hidden;
  margin: 0 -24rpx;
  padding: 96px 24rpx 34rpx;
  background: linear-gradient(180deg, #cfa57d 0%, #ead7c3 72%, #f6f4f0 100%);
}

.custom-nav {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  left: 0;
  padding-left: 28rpx;
  box-sizing: border-box;
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  min-width: 0;
}

.nav-logo {
  display: block;
  flex: 0 1 auto;
  max-width: 100%;
}

.nav-logo-text {
  max-width: 100%;
  overflow: hidden;
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-title {
  margin-top: 10rpx;
  color: #211f1c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.18;
}

.hero-subtitle {
  max-width: 640rpx;
  margin-top: 14rpx;
  color: #57534e;
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-swiper {
  width: 100%;
  height: 430rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow: 0 24rpx 54rpx rgba(33, 31, 28, 0.18);
}

.hero-image {
  width: 100%;
  height: 430rpx;
}

.hero-fallback {
  min-height: 300rpx;
  margin-top: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.68);
  padding: 36rpx;
}

.quick-panel {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 20rpx 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
}

.quick-action {
  display: flex;
  width: 100%;
  min-height: 126rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  margin: 0;
  padding: 10rpx 6rpx;
  line-height: 1.2;
}

.quick-action::after {
  border: 0;
}

.quick-action:active {
  background: #f7f3ee;
}

.quick-action.active {
  background: #fbf5ef;
}

.quick-icon-wrap {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #f7e8dc;
}

.quick-icon {
  width: 36rpx;
  height: 36rpx;
}

.quick-label {
  margin-top: 10rpx;
  color: #211f1c;
  font-size: 22rpx;
  font-weight: 800;
}

.quick-action.active .quick-label {
  color: #9a6a4b;
}

.tab-content {
  margin-top: 28rpx;
}

.about-card,
.about-blocks {
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
}

.about-image {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #f1e9e1;
}

.about-copy {
  padding: 28rpx;
}

.about-subtitle {
  margin-top: 12rpx;
}

.about-blocks {
  margin-top: 20rpx;
  padding: 28rpx;
}

.intro-sections {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.intro-section {
  border-radius: 24rpx;
  background: #fff;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
}

.intro-section-title {
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 900;
}

.intro-section-text {
  margin-top: 14rpx;
  white-space: pre-line;
}

.institution-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.institution-card {
  display: flex;
  gap: 18rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  padding-top: 18rpx;
}

.institution-logo {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 16rpx;
  background: #f7f3ee;
}

.institution-body {
  min-width: 0;
  flex: 1;
}

.institution-name {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
}

.institution-intro {
  margin-top: 8rpx;
  white-space: pre-line;
}

.institution-contact {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: pre-line;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-card {
  border-radius: 18rpx;
  background: #fff;
  padding: 20rpx;
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.highlights {
  display: grid;
  gap: 18rpx;
}

.highlight-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 148rpx;
  padding: 24rpx;
  background-position: center;
  background-size: cover;
  text-align: center;
}

.highlight-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 26rpx;
  font-weight: 800;
}

.highlight-card-image {
  border-color: rgba(255, 255, 255, 0.24);
}

.highlight-card-image .highlight-icon {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.highlight-title {
  margin-top: 16rpx;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.highlight-card-image .highlight-text {
  color: #fff;
}

.highlight-card-image .highlight-title {
  color: #fff;
}

.highlight-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.55;
  font-weight: 600;
}

.section-head {
  margin-bottom: 18rpx;
}

.text-button {
  display: inline-flex;
  width: auto;
  height: 60rpx;
  align-items: center;
  border: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 60rpx;
  padding: 0;
}

.text-button::after {
  border: 0;
}

.learning-band {
  margin-right: -24rpx;
  margin-left: -24rpx;
  margin-top: 28rpx;
  padding: 34rpx 24rpx;
  background: #f1ebe3;
}

.learning-section + .learning-section {
  margin-top: 38rpx;
}

.course-list,
.trial-list,
.story-scroll {
  margin-top: 18rpx;
}

.course-card,
.trial-card,
.story-card {
  overflow: hidden;
  padding: 22rpx;
}

.course-cover {
  display: block;
  width: calc(100% + 44rpx);
  height: 230rpx;
  margin: -22rpx -22rpx 20rpx;
  background: #f1e9e1;
}

.course-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
}

.course-price {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.course-meta,
.trial-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.trial-fee {
  margin-top: 10rpx;
  color: #a15c12;
  font-size: 24rpx;
  font-weight: 700;
}

.course-summary {
  margin-top: 12rpx;
}

.trust-teacher-scroll {
  width: 100%;
  white-space: nowrap;
}

.trust-teacher-list {
  display: grid;
  gap: 18rpx;
}

.trust-teacher-card {
  position: relative;
  display: inline-block;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #211f1c;
  box-shadow: 0 16rpx 42rpx rgba(33, 31, 28, 0.16);
  vertical-align: top;
  white-space: normal;
}

.teacher-section {
  overflow: hidden;
}

.trust-teacher-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.trust-teacher-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 96rpx;
  font-weight: 800;
}

.trust-teacher-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(33, 31, 28, 0.08), rgba(33, 31, 28, 0.88));
}

.trust-teacher-body {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx;
  color: #fff;
}

.trust-teacher-title {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  font-weight: 700;
}

.trust-teacher-name {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.trust-teacher-tagline {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.6;
}

.trust-chip {
  display: inline-flex;
  max-width: 100%;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
}

.story-cover {
  display: block;
  width: calc(100% + 44rpx);
  height: 230rpx;
  margin: -22rpx -22rpx 20rpx;
  background: #f1e9e1;
}

.story-meta {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
}

.story-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.story-summary {
  margin-top: 12rpx;
}

.campus-card {
  border-radius: 28rpx;
  background: #fff;
  padding: 30rpx;
  box-shadow: 0 12rpx 34rpx rgba(33, 31, 28, 0.05);
}

.campus-card + .campus-card {
  margin-top: 20rpx;
}

.campus-line {
  display: grid;
  grid-template-columns: 92rpx 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  padding-top: 20rpx;
}

.campus-line:first-of-type {
  border-top: 0;
}

.campus-label {
  color: #8b857c;
  font-size: 24rpx;
  font-weight: 800;
}

.campus-value {
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.campus-images {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.campus-image {
  width: 100%;
  height: 210rpx;
  border-radius: 18rpx;
  background: #f1e9e1;
}

.story-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.contact-card {
  border-radius: 28rpx;
  background: #211f1c;
  padding: 30rpx;
  color: #fff;
  box-shadow: 0 18rpx 48rpx rgba(33, 31, 28, 0.18);
}

.contact-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.contact-copy {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  line-height: 1.65;
}

.contact-steps {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx 18rpx;
  margin-top: 28rpx;
}

.contact-step {
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  padding-top: 16rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.contact-step-index {
  margin-bottom: 6rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  font-weight: 800;
}

.contact-row {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.6;
}

.contact-btn {
  margin-top: 28rpx;
  background: #fff;
  color: #211f1c;
}
