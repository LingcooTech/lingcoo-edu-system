<view class="page home-page">
  <skeleton wx:if="{{loading}}" variant="home" />

  <block wx:else>
    <view class="hero" style="{{heroStyle}}">
      <view class="custom-nav" style="{{customNavStyle}}">
        <view class="custom-nav-inner" style="{{customNavInnerStyle}}">
          <image wx:if="{{logoUrl}}" class="nav-logo" style="{{navLogoStyle}}" src="{{logoUrl}}" mode="heightFix" />
          <view wx:else class="nav-logo-text">{{brandName || organizationName || logoInitial}}</view>
        </view>
      </view>
      <view class="hero-mask"></view>
      <view wx:if="{{bannerImages.length}}" class="hero-swiper-wrap">
        <swiper
          class="hero-swiper"
          autoplay="{{bannerImages.length > 1}}"
          circular="{{bannerImages.length > 1}}"
          indicator-dots="{{false}}"
          bindchange="onBannerChange"
        >
          <swiper-item wx:for="{{bannerImages}}" wx:key="*this">
            <image class="hero-image" src="{{item}}" mode="aspectFill" />
          </swiper-item>
        </swiper>
        <view wx:if="{{bannerImages.length > 1}}" class="hero-indicators">
          <view
            wx:for="{{bannerImages}}"
            wx:key="*this"
            class="hero-indicator {{currentBannerIndex == index ? 'active' : ''}}"
          ></view>
        </view>
      </view>
      <view class="hero-fallback" wx:else>
        <view class="hero-title">{{bannerTitle}}</view>
        <view class="hero-subtitle">{{bannerSubtitle}}</view>
      </view>
    </view>

    <view class="quick-panel">
      <button
        wx:for="{{quickActions}}"
        wx:key="key"
        class="quick-action {{activeHomeTab == item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onQuickAction"
      >
        <view class="quick-icon-wrap">
          <image class="quick-icon" src="{{activeHomeTab == item.key ? item.activeIconUrl : item.iconUrl}}" mode="aspectFit" />
        </view>
        <view class="quick-label">{{item.label}}</view>
      </button>
    </view>

    <view wx:if="{{activeHomeTab == 'intro'}}" class="tab-content">
      <view class="intro-sections">
        <view class="intro-section intro-platform-section">
          <view class="intro-section-title">{{aboutPlatformTitle}}</view>
          <view class="intro-section-text">
            <view
              wx:for="{{aboutPlatformIntroParagraphs}}"
              wx:key="*this"
              class="body-text intro-paragraph"
            >
              {{item}}
            </view>
          </view>
        </view>
        <view class="intro-section intro-institution-section">
          <view class="intro-section-title">{{aboutTeachingTitle}}</view>
          <view class="intro-section-text">
            <view
              wx:for="{{aboutTeachingIntroParagraphs}}"
              wx:key="*this"
              class="body-text intro-paragraph"
            >
              {{item}}
            </view>
          </view>
          <view wx:if="{{institutions.length}}" class="institution-list">
            <view wx:for="{{institutions}}" wx:key="id" class="institution-card">
              <view wx:if="{{item.logoUrl}}" class="institution-logo-row">
                <image class="institution-logo" src="{{item.logoUrl}}" mode="aspectFit" />
              </view>
              <view class="institution-body">
                <view class="institution-intro">
                  <view
                    wx:for="{{item.introParagraphs}}"
                    wx:for-item="paragraph"
                    wx:key="*this"
                    class="body-text institution-paragraph"
                  >
                    {{paragraph}}
                  </view>
                </view>
                <view wx:if="{{item.contact}}" class="institution-contact">{{item.contact}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeHomeTab == 'advantages'}}" class="tab-content">
      <view wx:if="{{stats.length}}" class="section stats">
        <view wx:for="{{stats}}" wx:key="*this" class="stat-card">{{item}}</view>
      </view>
      <view wx:if="{{highlights.length}}" class="section highlights">
        <view
          wx:for="{{highlights}}"
          wx:key="text"
          class="card highlight-card {{item.imageUrl ? 'highlight-card-image' : ''}}"
          style="{{item.backgroundStyle}}"
        >
          <view class="highlight-icon">{{item.iconText}}</view>
          <view class="highlight-title">{{item.title || item.text}}</view>
          <view wx:if="{{item.showDescription}}" class="body-text highlight-text">
            {{item.text}}
          </view>
        </view>
      </view>

      <view wx:if="{{growthLoopTitle}}" class="section contact-card">
        <view class="contact-title">{{growthLoopTitle}}</view>
        <view wx:if="{{growthLoopSummary}}" class="contact-copy">{{growthLoopSummary}}</view>
        <view class="contact-steps">
          <view wx:for="{{growthLoopSteps}}" wx:key="title" class="contact-step">
            <view class="contact-step-index">{{item.indexLabel}}</view>
            <view>{{item.title}}</view>
          </view>
        </view>
        <button class="btn contact-btn" bindtap="onGrowthPrimaryCta">{{growthLoopPrimaryCtaText}}</button>
      </view>

      <view wx:if="{{!stats.length && !highlights.length && !growthLoopTitle}}" class="empty compact-empty">核心优势整理中</view>
    </view>

    <view wx:if="{{activeHomeTab == 'teachers'}}" class="tab-content teacher-section">
      <view wx:if="{{trustTeachers.length}}" class="trust-teacher-list">
        <navigator
          wx:for="{{trustTeachers}}"
          wx:key="id"
          class="trust-teacher-card"
          url="/pages/teacher-detail/index?id={{item.id}}"
        >
          <image wx:if="{{item.avatarUrl}}" class="trust-teacher-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="trust-teacher-avatar trust-teacher-avatar-fallback">{{item.initial}}</view>
          <view class="trust-teacher-body">
            <view class="trust-teacher-row">
              <view class="trust-teacher-name">{{item.name}}</view>
              <view class="trust-teacher-title">{{item.title}}</view>
            </view>
            <view wx:if="{{item.metaText}}" class="trust-teacher-meta">{{item.metaText}}</view>
            <view class="trust-teacher-tagline">{{item.tagline}}</view>
          </view>
        </navigator>
        <button class="more-row" bindtap="goTeachers">
          <text>查看全部教师</text>
          <text class="more-arrow">›</text>
        </button>
      </view>
      <view wx:else class="empty">师资信息整理中</view>
    </view>

    <view wx:if="{{activeHomeTab == 'campuses'}}" class="tab-content campus-list">
      <view wx:if="{{campuses.length}}">
        <view wx:for="{{campuses}}" wx:key="id" class="campus-card">
          <view class="campus-title-row">
            <view class="campus-title-mark"></view>
            <view class="section-title campus-title">{{item.name}}</view>
          </view>
          <view
            wx:if="{{item.address}}"
            class="campus-line {{item.hasLocation ? 'campus-line-clickable' : ''}}"
            data-name="{{item.name}}"
            data-address="{{item.address}}"
            data-latitude="{{item.latitude}}"
            data-longitude="{{item.longitude}}"
            bindtap="onOpenCampusLocation"
          >
            <view class="campus-address-icon">
              <view class="campus-address-pin"></view>
            </view>
            <view class="campus-value">{{item.address}}</view>
          </view>
          <view wx:if="{{item.imageUrls.length}}" class="campus-images">
            <image
              wx:for="{{item.imageUrls}}"
              wx:for-item="image"
              wx:key="*this"
              class="campus-image"
              src="{{image}}"
              mode="aspectFill"
              data-url="{{image}}"
              data-urls="{{item.imageUrls}}"
              bindtap="onPreviewCampusImage"
            />
          </view>
          <view wx:else class="empty compact-empty">校区环境图片待补充</view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">校区环境整理中</view>
    </view>

    <view wx:if="{{activeHomeTab == 'stories'}}" class="tab-content stories">
      <view wx:if="{{studentStories.length}}" class="story-list">
        <navigator wx:for="{{studentStories}}" wx:key="slug" class="story-card" url="/pages/story-detail/index?slug={{item.slug}}">
          <image wx:if="{{item.coverImageUrl}}" class="story-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
          <view wx:else class="story-cover story-cover-fallback">文</view>
          <view class="story-body">
            <view class="story-title">{{item.title}}</view>
            <view class="story-summary">{{item.excerpt}}</view>
            <view wx:if="{{item.studentName}}" class="story-meta">{{item.studentName}}</view>
          </view>
        </navigator>
        <button class="more-row" bindtap="goStories">
          <text>查看全部成长故事</text>
          <text class="more-arrow">›</text>
        </button>
      </view>
      <view wx:else class="empty compact-empty">成长故事整理中</view>
    </view>

  </block>
</view>
<tabbar />
