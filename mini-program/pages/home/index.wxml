<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:else>
    <view class="hero card">
      <view class="eyebrow">{{eyebrow}}</view>
      <view class="title hero-title">{{bannerTitle}}</view>
      <view class="body-text hero-subtitle">{{bannerSubtitle}}</view>
      <swiper
        wx:if="{{bannerImages.length}}"
        class="hero-swiper"
        autoplay="{{bannerImages.length > 1}}"
        circular="{{bannerImages.length > 1}}"
        indicator-dots="{{bannerImages.length > 1}}"
        indicator-color="rgba(255,255,255,0.55)"
        indicator-active-color="#ffffff"
      >
        <swiper-item wx:for="{{bannerImages}}" wx:key="*this">
          <image class="hero-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <view class="hero-actions">
        <button class="btn btn-primary hero-btn" bindtap="onPrimaryCta">{{ctaText}}</button>
        <button class="btn btn-outline hero-btn" bindtap="goCourses">浏览课程</button>
      </view>
    </view>

    <view wx:if="{{stats.length}}" class="section stats">
      <view wx:for="{{stats}}" wx:key="*this" class="stat-card">{{item}}</view>
    </view>

    <view wx:if="{{highlights.length}}" class="section highlights">
      <view
        wx:for="{{highlights}}"
        wx:key="text"
        class="card highlight-card {{item.imageUrl ? 'highlight-card-image' : ''}}"
        style="{{item.backgroundStyle}}"
      >
        <view class="highlight-icon">{{item.iconText}}</view>
        <view class="highlight-title">{{item.title || item.text}}</view>
        <view wx:if="{{item.showDescription}}" class="body-text highlight-text">
          {{item.text}}
        </view>
      </view>
    </view>

    <view class="section learning-band">
      <view class="learning-section">
        <view class="row-between section-head">
          <view>
            <view class="section-title">推荐课程</view>
          </view>
          <button class="text-button" bindtap="goCourses">全部</button>
        </view>

        <view wx:if="{{courses.length}}" class="course-list">
          <navigator wx:for="{{courses}}" wx:key="id" class="card course-card" url="/pages/course-detail/index?slug={{item.slug}}">
            <image wx:if="{{item.coverImageUrl}}" class="course-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
            <view class="row-between">
              <view class="course-name">{{item.name}}</view>
              <view class="course-price">{{item.priceLabel}}</view>
            </view>
            <view class="muted course-meta">{{item.category}} · {{item.ageRange}}</view>
            <view class="body-text course-summary">{{item.summary}}</view>
          </navigator>
        </view>
        <view wx:else class="empty">课程即将上线</view>
      </view>

      <view class="learning-section">
        <view class="section-title">本周公开课</view>
        <view wx:if="{{trialSessions.length}}" class="trial-list">
          <navigator wx:for="{{trialSessions}}" wx:key="id" class="card trial-card" url="/pages/trial-detail/index?id={{item.id}}">
            <image wx:if="{{item.coverImageUrl}}" class="course-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
            <view class="course-name">{{item.title}}</view>
            <view class="muted trial-meta">{{item.startsAtLabel}} · 已报名 {{item.bookedCount}}/{{item.capacity}}</view>
            <view wx:if="{{item.reservationFeeLabel}}" class="trial-fee">{{item.reservationFeeLabel}}</view>
          </navigator>
        </view>
        <view wx:else class="empty">近期暂无公开课，可直接预约心仪课程的试听。</view>
      </view>
    </view>

    <view wx:if="{{trustVisible}}" class="section">
      <view class="row-between section-head">
        <view>
          <view class="section-title">教师团队</view>
        </view>
        <button class="text-button" bindtap="goTeachers">全部</button>
      </view>

      <scroll-view wx:if="{{trustTeachers.length}}" class="trust-teacher-scroll" scroll-x enable-flex>
        <navigator
          wx:for="{{trustTeachers}}"
          wx:key="id"
          class="trust-teacher-card"
          url="/pages/teacher-detail/index?id={{item.id}}"
        >
          <image wx:if="{{item.avatarUrl}}" class="trust-teacher-cover" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="trust-teacher-cover trust-teacher-cover-fallback">{{item.initial}}</view>
          <view class="trust-teacher-shade"></view>
          <view class="trust-teacher-body">
            <view class="trust-teacher-name">{{item.name}}</view>
            <view class="trust-teacher-title">{{item.title}}</view>
            <view class="trust-teacher-tagline">{{item.tagline}}</view>
            <view wx:if="{{item.specialtiesText}}" class="trust-chip">{{item.specialtiesText}}</view>
          </view>
        </navigator>
      </scroll-view>
    </view>

    <view wx:if="{{studentStories.length}}" class="section stories">
      <view class="section-title">成长故事</view>
      <view wx:for="{{studentStories}}" wx:key="title" class="card story-card">
        <image wx:if="{{item.coverImageUrl}}" class="story-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
        <view wx:if="{{item.studentName}}" class="story-meta">{{item.studentName}}</view>
        <view class="story-title">{{item.title}}</view>
        <view class="body-text story-summary">{{item.excerpt}}</view>
      </view>
    </view>

    <view class="section contact-card">
      <view class="contact-kicker">班型匹配</view>
      <view class="contact-title">不确定选哪门课？先做一次班型匹配</view>
      <view class="contact-copy">告诉我们孩子年龄、基础和可上课时间，老师会先筛选合适课程，再安排试听或到店沟通。</view>
      <view class="contact-steps">
        <view wx:for="{{matchSteps}}" wx:key="*this" class="contact-step">
          <view class="contact-step-index">0{{index + 1}}</view>
          <view>{{item}}</view>
        </view>
      </view>
      <view wx:if="{{address}}" class="contact-row">地址：{{address}}</view>
      <view wx:if="{{phone}}" class="contact-row">电话：{{phone}}</view>
      <view wx:if="{{businessHours}}" class="contact-row">{{businessHours}}</view>
      <button class="btn contact-btn" bindtap="onPrimaryCta">预约班型匹配</button>
    </view>

    <view class="section quick-nav">
      <button class="btn btn-outline" bindtap="goCourses">课程</button>
      <button class="btn btn-outline" bindtap="goTeachers">老师</button>
      <button class="btn btn-outline" bindtap="goAccount">我的</button>
    </view>
  </block>
</view>
