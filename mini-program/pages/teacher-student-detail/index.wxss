.student-detail-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f6f4f0;
}

.profile-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(208, 225, 255, 0.72), rgba(208, 225, 255, 0) 36%),
    linear-gradient(180deg, #ffffff 0%, #f8f3ed 100%);
  padding: 34rpx 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
}

.profile-eyebrow {
  color: #6b6258;
  font-size: 25rpx;
  font-weight: 800;
}

.profile-name {
  margin-top: 10rpx;
  color: #211f1c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-meta {
  margin-top: 10rpx;
  color: #8b857c;
  font-size: 25rpx;
  line-height: 1.45;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, 82rpx);
  gap: 12rpx;
  flex-shrink: 0;
  text-align: center;
}

.profile-stats > view {
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.76);
  padding: 16rpx 8rpx;
}

.stat-value {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.stat-label {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.section-title {
  margin: 34rpx 0 16rpx;
  color: #211f1c;
  font-size: 33rpx;
  font-weight: 900;
}

.detail-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  padding: 8rpx;
}

.detail-tab {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #57534e;
  font-size: 24rpx;
  font-weight: 850;
}

.detail-tab-active {
  background: #211f1c;
  color: #fff;
}

.list {
  display: grid;
  gap: 18rpx;
}

.card {
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(33, 31, 28, 0.05);
}

.row-card,
.text-card {
  padding: 28rpx;
}

.row-card,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.row-title {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.4;
}

.row-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.45;
}

.balance,
.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 850;
  padding: 10rpx 18rpx;
}

.text-content,
.teacher-feedback {
  margin-top: 18rpx;
  border-radius: 18rpx;
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.65;
  padding: 18rpx;
}

.text-content {
  background: #fbfaf7;
}

.teacher-feedback {
  background: #fff7e6;
  color: #7a4f00;
}

.empty-card {
  padding: 34rpx;
  color: #8b857c;
  font-size: 26rpx;
}
