.student-detail-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f6f4f0;
}

.profile-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(208, 225, 255, 0.72), rgba(208, 225, 255, 0) 36%),
    linear-gradient(180deg, #ffffff 0%, #f8f3ed 100%);
  padding: 34rpx 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(33, 31, 28, 0.06);
}

.profile-info {
  min-width: 0;
  flex: 1;
}

.profile-eyebrow {
  color: #6b6258;
  font-size: 25rpx;
  font-weight: 800;
}

.identity-pill {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #9a4b15;
  font-size: 22rpx;
  font-weight: 700;
}

.profile-name {
  margin-top: 10rpx;
  color: #211f1c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-meta {
  margin-top: 10rpx;
  color: #8b857c;
  font-size: 25rpx;
  line-height: 1.45;
}

.profile-stats {
  display: grid;
  width: 340rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  flex-shrink: 0;
  text-align: center;
}

.profile-stats > view {
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.76);
  padding: 16rpx 6rpx;
}

.stat-value {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.stat-label {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 20rpx;
  white-space: nowrap;
}

.section-title {
  margin: 34rpx 0 16rpx;
  color: #211f1c;
  font-size: 33rpx;
  font-weight: 900;
}

.detail-tabs {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  padding: 8rpx;
}

.detail-tab {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #57534e;
  font-size: 22rpx;
  font-weight: 850;
}

.detail-tab-active {
  background: #211f1c;
  color: #fff;
}

.list {
  display: grid;
  gap: 18rpx;
}

.card {
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(33, 31, 28, 0.05);
}

.row-card,
.text-card {
  padding: 28rpx;
}

.class-option-card {
  padding: 28rpx;
}

.row-card,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.row-title {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.4;
}

.row-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.45;
}

.balance,
.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 850;
  padding: 10rpx 18rpx;
}

.text-content,
.teacher-feedback {
  margin-top: 18rpx;
  border-radius: 18rpx;
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.65;
  padding: 18rpx;
}

.text-content {
  background: #fbfaf7;
}

.teacher-feedback {
  background: #fff7e6;
  color: #7a4f00;
}

.empty-card {
  padding: 34rpx;
  color: #8b857c;
  font-size: 26rpx;
}

.class-option-stats {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
  color: #8b857c;
  font-size: 23rpx;
  font-weight: 800;
}

.class-enroll-button {
  width: 100%;
  margin-top: 20rpx;
  background: #211f1c;
  color: #fff;
}

.class-enroll-button[disabled] {
  background: #eee9e2;
  color: #9a948b;
}

.work-publish-card {
  display: grid;
  gap: 18rpx;
}

.work-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  line-height: 1.6;
  padding: 22rpx 24rpx;
}

.work-image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.work-image-cell {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}

.work-image-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #eef1ee;
}

.work-image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(33, 31, 28, 0.78);
  color: #fff;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
}

.work-image-add {
  display: flex;
  width: 150rpx;
  height: 150rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(33, 31, 28, 0.22);
  border-radius: 16rpx;
  background: #fbfaf7;
  color: #8b857c;
}

.work-image-add-plus {
  font-size: 48rpx;
  line-height: 1;
}

.work-image-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.work-submit-button {
  width: 100%;
  background: #211f1c;
  color: #fff;
}

.student-works-scroll {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.student-works-row {
  display: inline-flex;
  gap: 18rpx;
  padding-bottom: 8rpx;
  padding-right: 30rpx;
}

.student-work-card {
  display: inline-flex;
  width: 702rpx;
  flex: 0 0 702rpx;
  flex-direction: column;
  overflow: hidden;
  white-space: normal;
}

.student-work-cover {
  display: block;
  width: 100%;
  height: 248rpx;
  background: #ece8df;
}

.student-work-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx;
}

.student-work-head {
  display: grid;
  gap: 4rpx;
}

.student-work-desc {
  display: -webkit-box;
  margin-top: 16rpx;
  overflow: hidden;
  color: #57534e;
  font-size: 24rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
