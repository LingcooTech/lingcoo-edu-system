<custom-navbar title="课后点评" show-back="{{true}}" />
<view class="page">
  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{needLogin}}" class="empty login-empty">
    请先在“我的”登录
    <button class="btn btn-primary login-empty-btn" bindtap="goLogin">去登录</button>
  </view>
  <block wx:else>
    <view class="page-head">
      <view class="section-title">课后点评</view>
      <view class="row-meta">查看老师对课堂表现、练习重点和后续建议的记录。</view>
    </view>

    <view wx:if="{{lessonFeedbacks.length}}" class="feedback-list">
      <view wx:for="{{lessonFeedbacks}}" wx:key="id" class="card panel feedback-card">
        <view class="row-between">
          <view>
            <view class="row-title">{{item.studentName}} · {{item.courseName}}</view>
            <view class="row-meta">{{item.teacherName}} · {{item.createdAtLabel}}</view>
          </view>
          <view wx:if="{{item.class}}" class="feedback-class">{{item.class.name}}</view>
        </view>
        <view class="feedback-rating">{{item.ratingLabel}}</view>
        <view class="feedback-content">{{item.content}}</view>
        <view wx:if="{{item.homeworkAssignment}}" class="assignment-note">
          <view class="assignment-note-title">
            {{item.homeworkAssignment.isPersonal ? '个人作业' : '课后作业'}}
          </view>
          <view class="assignment-note-content">{{item.homeworkAssignment.content}}</view>
        </view>
        <view wx:if="{{item.imageUrls.length}}" class="feedback-images">
          <image
            wx:for="{{item.imageUrls}}"
            wx:for-item="url"
            wx:key="*this"
            class="feedback-image"
            src="{{url}}"
            mode="aspectFill"
            data-url="{{url}}"
            data-urls="{{item.imageUrls}}"
            bindtap="onPreviewImage"
          />
        </view>
      </view>
    </view>
    <view wx:else class="empty compact-empty">暂无课后点评</view>
  </block>
</view>
