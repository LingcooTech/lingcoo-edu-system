.schedule-page {
  min-height: 100vh;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
  background: #f5f3ef;
}

.schedule-hero {
  margin: -24rpx -24rpx 0;
  margin-top: -88px;
  border-radius: 0 0 36rpx 36rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 224, 143, 0.56), rgba(255, 224, 143, 0) 34%),
    linear-gradient(180deg, #f0d7bd 0%, #f7eee5 100%);
  padding: calc(88px + 34rpx) 30rpx 38rpx;
}

.calendar-panel {
  overflow: hidden;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.06);
  padding: 20rpx 18rpx 18rpx;
}

.calendar-panel.collapsed {
  padding-top: 22rpx;
}

.week-grid,
.weekday-row,
.month-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.week-grid {
  gap: 8rpx;
}

.month-grid {
  gap: 6rpx;
  margin-top: 8rpx;
}

.day-cell {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.week-grid .day-cell {
  min-height: 132rpx;
  border-radius: 32rpx;
}

.month-grid .day-cell {
  min-height: 86rpx;
  border-radius: 18rpx;
  padding: 6rpx 2rpx;
}

.weekday {
  color: #6b6258;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.weekday-row .weekday {
  color: #8b857c;
  font-size: 22rpx;
  line-height: 42rpx;
}

.week-grid .day-number {
  margin-top: 22rpx;
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.month-grid .day-number {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
}

.day-cell.muted {
  opacity: 0.36;
}

.day-cell.today:not(.selected) {
  background: rgba(154, 106, 75, 0.08);
}

.day-cell.selected {
  background: #9a6a4b;
  opacity: 1;
  box-shadow: 0 8rpx 18rpx rgba(154, 106, 75, 0.18);
}

.day-cell.selected .weekday,
.day-cell.selected .day-number,
.day-cell.selected .day-count {
  color: #fff;
}

.day-count {
  min-height: 22rpx;
  margin-top: 8rpx;
  color: #9a6a4b;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
}

.day-dots {
  display: flex;
  height: 8rpx;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  margin-top: 10rpx;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #9a6a4b;
}

.day-dot.trial {
  background: #2bc980;
}

.day-dot.mine {
  background: #c15c3a;
}

.day-cell.selected .day-dot {
  background: #fff;
}

.date-toggle {
  display: flex;
  width: 360rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #4d4339;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 58rpx;
  margin: 14rpx auto 0;
  padding: 0 26rpx;
}

.date-toggle::after,
.month-toolbar button::after,
.month-current::after {
  border: 0;
}

.date-toggle-label {
  display: block;
  height: 58rpx;
  line-height: 58rpx;
}

.toggle-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  box-sizing: border-box;
  transform: translateY(-4rpx) rotate(45deg);
}

.toggle-chevron.up {
  transform: translateY(4rpx) rotate(225deg);
}

.month-toolbar {
  display: grid;
  grid-template-columns: 132rpx 1fr 132rpx;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.month-toolbar button,
.month-current {
  display: block;
  width: 100%;
  min-width: 0;
  height: 56rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 999rpx;
  background: #f7f3ee;
  color: #8b5e42;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
}

.month-title {
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.month-current {
  width: 180rpx;
  margin: 16rpx auto 0;
}

.schedule-body {
  min-height: 820rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #211f1c;
  font-size: 33rpx;
  font-weight: 900;
}

.selected-date {
  flex: 0 0 auto;
  color: #8b857c;
  font-size: 24rpx;
  font-weight: 800;
}

.schedule-empty {
  display: flex;
  min-height: 560rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-mark {
  display: flex;
  width: 154rpx;
  height: 154rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f2f0ea;
  color: #c8c2b8;
  font-size: 42rpx;
  font-weight: 900;
}

.empty-text {
  margin-top: 28rpx;
  color: #8b857c;
  font-size: 27rpx;
}

.event-list {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.event-card {
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #f8f6f2;
  padding: 24rpx;
}

.event-card.is-trial {
  background: #f7fbf8;
}

.event-card.is-mine {
  border-color: rgba(154, 106, 75, 0.42);
  background: #fff7ed;
}

.event-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.event-time {
  color: #9a6a4b;
  font-size: 26rpx;
  font-weight: 900;
}

.event-badge {
  flex: 0 0 auto;
  border-radius: 999rpx;
  background: rgba(154, 106, 75, 0.1);
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  padding: 10rpx 16rpx;
}

.event-card.is-trial .event-badge {
  background: rgba(43, 201, 128, 0.12);
  color: #188858;
}

.event-card.is-mine .event-badge {
  background: #9a6a4b;
  color: #fff;
}

.event-title {
  margin-top: 12rpx;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.event-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.45;
}

.event-students {
  margin-top: 12rpx;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}
