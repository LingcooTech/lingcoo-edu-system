<custom-navbar title="成长互动" show-back="{{true}}" />
<view class="page interaction-page">
  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{needLogin}}" class="empty login-empty">
    请先在“我的”登录
    <button class="btn btn-primary login-empty-btn" bindtap="goLogin">去登录</button>
  </view>
  <block wx:else>
    <view wx:if="{{showStudentFilter}}" class="student-filter">
      <button
        class="student-filter-chip {{selectedStudentId == 'all' ? 'active' : ''}}"
        data-id="all"
        bindtap="onSelectStudent"
      >
        全部
      </button>
      <button
        wx:for="{{studentFilters}}"
        wx:key="id"
        class="student-filter-chip {{selectedStudentId == item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectStudent"
      >
        {{item.label}}
      </button>
    </view>

    <view class="card interaction-summary">
      <view class="summary-main">
        <view class="summary-label">本月星星</view>
        <view class="summary-value">{{stats.monthStars}}</view>
      </view>
      <view class="summary-grid">
        <view>
          <view class="summary-small-value">{{stats.feedbackCount}}</view>
          <view class="summary-small-label">活动表现</view>
        </view>
        <view>
          <view class="summary-small-value">{{stats.homeworkCount}}</view>
          <view class="summary-small-label">打卡记录</view>
        </view>
        <view>
          <view class="summary-small-value">{{stats.assignmentCount}}</view>
          <view class="summary-small-label">布置任务</view>
        </view>
      </view>
    </view>

    <view class="interaction-tabs">
      <view
        class="interaction-tab {{activeTab == 'feedbacks' ? 'active' : ''}}"
        data-tab="feedbacks"
        bindtap="onTabChange"
      >
        活动表现
      </view>
      <view
        class="interaction-tab {{activeTab == 'homework' ? 'active' : ''}}"
        data-tab="homework"
        bindtap="onTabChange"
      >
        打卡记录
      </view>
      <view
        class="interaction-tab {{activeTab == 'assignments' ? 'active' : ''}}"
        data-tab="assignments"
        bindtap="onTabChange"
      >
        布置任务
      </view>
    </view>

    <block wx:if="{{activeTab == 'feedbacks'}}">
      <view wx:if="{{visibleFeedbacks.length}}" class="interaction-list">
        <view wx:for="{{visibleFeedbacks}}" wx:key="id" class="card interaction-card">
          <view class="card-head">
            <view>
              <view class="row-title">{{item.studentName}} · {{item.courseName}}</view>
              <view class="row-meta">{{item.teacherName}} · {{item.createdAtLabel}}</view>
            </view>
            <view class="star-display">
              <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="starIndex" wx:key="*this" class="star {{starIndex <= (item.rating || 0) ? 'star-active' : ''}}">★</text>
            </view>
          </view>
          <view wx:if="{{item.class}}" class="row-meta class-meta">{{item.class.name}}</view>
          <view class="interaction-content">{{item.content}}</view>
          <view wx:if="{{item.homeworkAssignment}}" class="assignment-note">
            <view class="assignment-note-title">
              {{item.homeworkAssignment.isPersonal ? '个人任务' : '活动组任务'}}
            </view>
            <view class="assignment-note-content">{{item.homeworkAssignment.content}}</view>
          </view>
          <view wx:if="{{item.imageUrls.length}}" class="image-strip">
            <image
              wx:for="{{item.imageUrls}}"
              wx:for-item="url"
              wx:key="*this"
              class="interaction-image"
              src="{{url}}"
              mode="aspectFill"
              data-url="{{url}}"
              data-urls="{{item.imageUrls}}"
              bindtap="onPreviewFeedbackImage"
            />
          </view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">暂无成长互动</view>
    </block>

    <block wx:elif="{{activeTab == 'homework'}}">
      <view wx:if="{{visibleHomework.length}}" class="interaction-list">
        <view wx:for="{{visibleHomework}}" wx:key="id" class="card interaction-card">
          <view class="card-head">
            <view>
              <view class="row-title">{{item.studentName}} · {{item.courseName}}</view>
              <view class="row-meta">{{item.createdAtLabel}}</view>
            </view>
            <view class="status-pill {{item.reviewStatus}}">{{item.reviewStatusLabel}}</view>
          </view>
          <view wx:if="{{item.content}}" class="interaction-content">{{item.content}}</view>
          <view wx:if="{{item.imageUrls.length}}" class="image-strip">
            <image
              wx:for="{{item.imageUrls}}"
              wx:for-item="url"
              wx:key="*this"
              class="interaction-image"
              src="{{url}}"
              mode="aspectFill"
              data-url="{{url}}"
              data-urls="{{item.imageUrls}}"
              bindtap="onPreviewHomeworkImage"
            />
          </view>
          <view wx:if="{{item.teacherFeedback}}" class="teacher-feedback">{{item.teacherFeedback}}</view>
          <view class="star-display inline">
            <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="starIndex" wx:key="*this" class="star {{starIndex <= (item.rating || 0) ? 'star-active' : ''}}">★</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">暂无打卡记录</view>
    </block>

    <block wx:else>
      <view wx:if="{{visibleAssignments.length}}" class="interaction-list">
        <view wx:for="{{visibleAssignments}}" wx:key="id" class="card interaction-card">
          <view class="card-head">
            <view>
              <view class="row-title">{{item.studentName}} · {{item.courseName}}</view>
              <view class="row-meta">{{item.teacherName}} · {{item.createdAtLabel}}</view>
            </view>
            <view class="status-pill">{{item.assignmentScopeLabel}}</view>
          </view>
          <view wx:if="{{item.class}}" class="row-meta class-meta">{{item.class.name}}</view>
          <view class="interaction-content">{{item.content}}</view>
        </view>
      </view>
      <view wx:else class="empty compact-empty">暂无布置任务</view>
    </block>
  </block>
</view>
