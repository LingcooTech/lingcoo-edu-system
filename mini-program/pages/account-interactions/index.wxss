.interaction-page {
  background: #f5f3ef;
}

.student-filter {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding: 0 2rpx 18rpx;
  white-space: nowrap;
}

.student-filter-chip {
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 58rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #7d776f;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 58rpx;
  padding: 0 24rpx;
}

.student-filter-chip.active {
  border-color: #9a6a4b;
  background: #9a6a4b;
  color: #fff;
}

.student-filter-chip::after {
  border: 0;
}

.interaction-summary {
  display: grid;
  gap: 22rpx;
  padding: 28rpx;
}

.summary-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.summary-label {
  color: #7d776f;
  font-size: 25rpx;
  font-weight: 800;
}

.summary-value {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-grid > view {
  border-radius: 18rpx;
  background: #fbfaf7;
  padding: 18rpx 12rpx;
  text-align: center;
}

.summary-small-value {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-small-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.interaction-tabs {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  width: 100%;
  margin: 22rpx 0;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  overflow: hidden;
  padding: 6rpx;
}

.interaction-tab {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: transparent;
  color: #7d776f;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  padding: 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-word;
}

.interaction-tab.active {
  background: #211f1c;
  color: #fff;
}

.interaction-list {
  display: grid;
  gap: 18rpx;
}

.interaction-card {
  padding: 24rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.star-pill,
.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  padding: 10rpx 16rpx;
}

.star-display {
  display: flex;
  gap: 4rpx;
  align-items: center;
  flex-shrink: 0;
}

.star {
  font-size: 24rpx;
  color: #d4af37;
  opacity: 0.3;
}

.star.star-active {
  opacity: 1;
}

.star-pill.inline {
  display: inline-flex;
  margin-top: 16rpx;
}

.star-display.inline {
  display: inline-flex;
  margin-top: 16rpx;
}

.status-pill.reviewed {
  background: #edf3ea;
  color: #52704a;
}

.status-pill.needs_revision {
  background: #fff0e7;
  color: #a45f3a;
}

.class-meta {
  margin-top: 10rpx;
}

.interaction-content {
  margin-top: 18rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.assignment-note,
.teacher-feedback {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.assignment-note-title {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 900;
}

.assignment-note-content {
  margin-top: 8rpx;
}

.image-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.interaction-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #eef1ee;
}
