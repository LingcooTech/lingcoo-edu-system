<custom-navbar title="成长报告" show-back="{{true}}" />
<view class="page report-page">
  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{needLogin}}" class="empty login-empty">
    请先在“我的”登录
    <button class="btn btn-primary login-empty-btn" bindtap="goLogin">去登录</button>
  </view>
  <block wx:else>
    <view class="report-hero card">
      <view>
        <view class="report-kicker">本月成长</view>
        <view class="report-title">{{stats.monthStars}} 颗星</view>
      </view>
      <view class="report-meta">{{stats.childCount}} 份成长档案 · 剩余 {{stats.totalBalance}} 次</view>
    </view>

    <view class="report-grid">
      <view class="report-stat">
        <view class="report-stat-value">{{stats.attendanceCount}}</view>
        <view class="report-stat-label">到场记录</view>
      </view>
      <view class="report-stat">
        <view class="report-stat-value">{{stats.feedbackCount}}</view>
        <view class="report-stat-label">课程表现</view>
      </view>
      <view class="report-stat">
        <view class="report-stat-value">{{stats.homeworkCount}}</view>
        <view class="report-stat-label">打卡记录</view>
      </view>
      <view class="report-stat">
        <view class="report-stat-value">{{stats.assignmentCount}}</view>
        <view class="report-stat-label">布置任务</view>
      </view>
    </view>

    <view wx:if="{{reports.length}}" class="section report-list">
      <view wx:for="{{reports}}" wx:key="id" class="card report-card">
        <view class="report-card-head">
          <view>
            <view class="report-child-name">{{item.name}}</view>
            <view class="report-child-meta">{{item.meta}}</view>
          </view>
          <view class="report-star-pill">{{item.monthStars}} 星</view>
        </view>
        <view class="report-card-grid">
          <view>
            <view class="report-small-value">{{item.balance}}</view>
            <view class="report-small-label">剩余次数</view>
          </view>
          <view>
            <view class="report-small-value">{{item.attendanceCount}}</view>
            <view class="report-small-label">到场</view>
          </view>
          <view>
            <view class="report-small-value">{{item.feedbackCount}}</view>
            <view class="report-small-label">表现</view>
          </view>
          <view>
            <view class="report-small-value">{{item.homeworkCount}}</view>
            <view class="report-small-label">打卡</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="card panel empty compact-empty">暂无成长数据</view>
  </block>
</view>
