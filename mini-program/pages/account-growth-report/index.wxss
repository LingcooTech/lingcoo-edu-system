.report-page {
  background: #f5f3ef;
}

.report-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 84% 18%, rgba(255, 224, 143, 0.5), rgba(255, 224, 143, 0) 34%),
    #fff;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.06);
  padding: 30rpx;
}

.report-kicker {
  color: #8b857c;
  font-size: 24rpx;
  font-weight: 800;
}

.report-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.report-meta {
  max-width: 300rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
}

.report-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.report-stat {
  display: flex;
  min-height: 116rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(33, 31, 28, 0.05);
  padding: 12rpx 6rpx;
}

.report-stat-value {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.report-stat-label {
  margin-top: 9rpx;
  color: #8b857c;
  font-size: 20rpx;
  line-height: 1.2;
}

.report-list {
  display: grid;
  gap: 18rpx;
}

.report-card {
  padding: 26rpx;
}

.report-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.report-child-name {
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.report-child-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 23rpx;
}

.report-star-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  padding: 10rpx 16rpx;
}

.report-card-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 22rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  padding-top: 20rpx;
  text-align: center;
}

.report-small-value {
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.report-small-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 20rpx;
}
