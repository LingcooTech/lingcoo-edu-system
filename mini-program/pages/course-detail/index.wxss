.course-detail-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.back-button {
  width: auto;
  height: 58rpx;
  border: 0;
  background: transparent;
  color: #8b857c;
  font-size: 26rpx;
  line-height: 58rpx;
  padding: 0;
  text-align: left;
}

.back-button::after {
  border: 0;
}

.header {
  margin-top: 8rpx;
  padding: 26rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.course-title {
  margin-top: 18rpx;
}

.summary {
  margin-top: 14rpx;
}

.course-cover {
  display: block;
  width: 100%;
  height: 330rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #f1e9e1;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
  color: #8b857c;
  font-size: 24rpx;
}

.block-card {
  padding: 28rpx;
}

.info-card {
  display: grid;
  gap: 14rpx;
  padding: 28rpx;
}

.info-row {
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.5;
}

.notice-block {
  margin-top: 10rpx;
}

.package-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.package-card {
  padding: 24rpx;
}

.package-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
}

.package-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.package-price {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 800;
}

.package-price-wrap {
  flex-shrink: 0;
  text-align: right;
}

.original-price {
  margin-top: 4rpx;
  font-size: 22rpx;
  text-decoration: line-through;
}

.package-desc {
  margin-top: 14rpx;
}

.package-button {
  display: flex;
  width: 100%;
  margin-top: 18rpx;
  min-height: 82rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #211f1c 0%, #5a3a26 100%);
  color: #fff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 82rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 0 28rpx;
  box-shadow: 0 12rpx 26rpx rgba(90, 58, 38, 0.22);
}

.package-button::after {
  border: 0;
}

.package-button:active {
  background: linear-gradient(135deg, #3a342e 0%, #6a432a 100%);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.12);
  transform: scale(0.98);
}

.checkout-heading {
  position: relative;
  align-items: flex-start;
  gap: 16rpx;
  padding-right: 76rpx;
}

.close-button {
  position: absolute;
  top: -2rpx;
  right: 0;
  display: flex;
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  max-height: 56rpx;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  border-radius: 50%;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 52rpx;
  overflow: hidden;
  text-align: center;
}

.close-button:active {
  background: #eadbce;
}

.checkout-hint {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fbfaf7;
  padding: 18rpx;
  color: #6b6258;
  font-size: 24rpx;
  line-height: 1.6;
}

.child-profile-form {
  margin-top: 20rpx;
}

.checkout-submit {
  margin-top: 22rpx;
}

.order-result {
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #f7faf8;
  padding: 22rpx;
}

.order-no {
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.order-status {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f2f0ea;
  color: #5d655f;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.order-status.pending {
  background: #fff4d8;
  color: #8a5a00;
}

.order-status.paid {
  background: #f1e9e1;
  color: #9a6a4b;
}

.order-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.password-note {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.form-hint {
  margin: 10rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.trial-submit {
  margin-top: 22rpx;
}

.sticky-cta {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin: 0;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  background: rgba(255, 255, 255, 0.96);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(33, 31, 28, 0.08);
}

.sticky-button {
  width: 260rpx;
  min-height: 76rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.sticky-button.secondary {
  color: #211f1c;
}

.empty-state {
  padding-top: 120rpx;
  text-align: center;
}

.empty-button {
  margin-top: 28rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.42);
}

.bottom-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  transition: transform 0.18s ease;
}

.bottom-sheet.dragging {
  transition: none;
}

.sheet-handle {
  width: 78rpx;
  height: 32rpx;
  border-radius: 999rpx;
  margin: 0 auto 14rpx;
  position: relative;
}

.sheet-handle::after {
  position: absolute;
  top: 12rpx;
  left: 0;
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  content: '';
}
