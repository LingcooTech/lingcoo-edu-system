.back-button {
  width: auto;
  height: 58rpx;
  border: 0;
  background: transparent;
  color: #6c766f;
  font-size: 26rpx;
  line-height: 58rpx;
  padding: 0;
  text-align: left;
}

.back-button::after {
  border: 0;
}

.header {
  margin-top: 8rpx;
  padding: 30rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.course-title {
  margin-top: 18rpx;
}

.summary {
  margin-top: 14rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
  color: #6c766f;
  font-size: 24rpx;
}

.block-card {
  padding: 28rpx;
}

.info-card {
  display: grid;
  gap: 14rpx;
  padding: 28rpx;
}

.info-row {
  color: #4f5a53;
  font-size: 25rpx;
  line-height: 1.5;
}

.notice-block {
  margin-top: 10rpx;
}

.package-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.package-card {
  padding: 28rpx;
}

.package-name {
  color: #1f2b24;
  font-size: 29rpx;
  font-weight: 800;
}

.package-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.package-price {
  color: #1f2b24;
  font-size: 28rpx;
  font-weight: 800;
}

.package-desc {
  margin-top: 14rpx;
}

.package-button {
  margin-top: 18rpx;
}

.checkout-form {
  padding: 28rpx;
}

.checkout-heading {
  align-items: flex-start;
  gap: 16rpx;
}

.close-button {
  width: auto;
  height: 52rpx;
  border: 0;
  border-radius: 999rpx;
  background: #eef5f1;
  color: #1f6f5b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  padding: 0 20rpx;
}

.close-button::after {
  border: 0;
}

.checkout-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.checkout-submit {
  margin-top: 22rpx;
}

.order-result {
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #f7faf8;
  padding: 22rpx;
}

.order-no {
  color: #1f2b24;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.order-status {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f2f0ea;
  color: #5d655f;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.order-status.pending {
  background: #fff4d8;
  color: #8a5a00;
}

.order-status.paid {
  background: #e9f4ef;
  color: #1f6f5b;
}

.order-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.password-note {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.trial-form {
  padding: 28rpx;
}

.form-hint {
  margin: 10rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.trial-submit {
  margin-top: 22rpx;
}

.sticky-cta {
  position: sticky;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  align-items: center;
  margin: 36rpx -28rpx -28rpx;
  border-top: 1rpx solid rgba(31, 43, 36, 0.1);
  background: rgba(246, 243, 237, 0.96);
  padding: 18rpx 28rpx;
}

.sticky-note {
  color: #6c766f;
  font-size: 22rpx;
}

.sticky-button {
  width: 100%;
}

.empty-state {
  padding-top: 120rpx;
  text-align: center;
}

.empty-button {
  margin-top: 28rpx;
}
