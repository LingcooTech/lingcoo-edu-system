<custom-navbar title="课程详情" show-back="{{true}}" />
<view class="page course-detail-page">
  <skeleton wx:if="{{loading}}" variant="detail" />

  <view wx:elif="{{notFound}}" class="empty-state">
    <view class="section-title">课程不存在或已下架</view>
    <button class="btn btn-outline empty-button" bindtap="goCourses">查看全部课程</button>
  </view>

  <block wx:else>
    <view class="header card">
      <view class="chips">
        <text class="chip">{{course.category}}</text>
        <text class="chip">{{course.ageRange}}</text>
      </view>
      <view class="title course-title">{{course.name}}</view>
      <view class="body-text summary">{{course.summary}}</view>
      <image wx:if="{{course.coverImageUrl}}" class="course-cover" src="{{course.coverImageUrl}}" mode="aspectFill" />
      <view class="meta-row">
        <text>{{course.durationMinutes}} 分钟/次</text>
        <text>{{packages.length ? packages.length + (onlinePackageSalesAllowed ? ' 个服务包' : ' 个参考方案') : '暂未上架服务包'}}</text>
      </view>
    </view>

    <view class="section card info-card">
      <view class="info-row">合作机构：{{providerLabel}}</view>
      <view class="info-row">指导老师：{{teacherLabel}}</view>
      <view class="info-row">空间：{{locationLabel}}</view>
      <view wx:if="{{receiverLabel}}" class="info-row">收款方：{{receiverLabel}}</view>
    </view>

    <view wx:if="{{contentBlocks.length}}" class="section card block-card">
      <block-renderer blocks="{{contentBlocks}}" />
    </view>

    <view wx:if="{{studentWorks.length}}" class="section">
      <view class="section-title">学员作品</view>
      <scroll-view scroll-x class="works-scroll" show-scrollbar="{{false}}">
        <view class="works-row">
          <view wx:for="{{studentWorks}}" wx:key="id" class="card course-work-card">
            <image
              class="course-work-image"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              data-url="{{item.coverUrl}}"
              data-urls="{{item.imageUrls}}"
              bindtap="onPreviewWork"
            />
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="section">
      <view class="section-title">{{onlinePackageSalesAllowed ? '服务包' : '常规课程参考方案'}}</view>
      <view wx:if="{{packages.length}}" class="package-list">
        <view wx:for="{{packages}}" wx:key="id" class="card package-card">
          <view class="row-between">
            <view>
              <view class="package-name">{{item.name}}</view>
              <view class="muted package-meta">{{item.lessonLabel}}</view>
            </view>
            <view class="package-price-wrap">
              <view class="package-price">{{item.priceLabel}}</view>
              <view wx:if="{{item.originalPriceLabel}}" class="muted original-price">{{item.originalPriceLabel}}</view>
            </view>
          </view>
          <view wx:if="{{item.description}}" class="body-text package-desc">{{item.description}}</view>
          <button wx:if="{{onlinePackageSalesAllowed}}" class="package-button" data-id="{{item.id}}" bindtap="onBuyTap">
            <text>购买服务包</text>
          </button>
        </view>
      </view>
      <view wx:else class="empty">{{onlinePackageSalesAllowed ? '服务包暂未上架，可先预约试听。' : '暂无常规课程参考方案，可先预约试听。'}}</view>
    </view>

    <view wx:if="{{trialNotice}}" class="section card info-card">
      <view class="section-title">预约试听说明</view>
      <view class="body-text package-desc">{{trialNotice}}</view>
    </view>

    <view class="sticky-cta app-bottom-bar">
      <button class="btn btn-outline sticky-button secondary" bindtap="onPhoneTap">电话联系</button>
      <button class="btn btn-primary sticky-button" bindtap="onTrialTap">预约试听</button>
    </view>

    <view wx:if="{{showCheckoutForm && selectedPackage}}" class="sheet-mask" bindtap="closeCheckout">
      <view class="bottom-sheet {{checkoutSheetDragging ? 'dragging' : ''}}" style="transform: translateY({{checkoutSheetOffset}}px);" catchtap="noop">
        <view
          class="sheet-handle"
          bindtouchstart="onCheckoutSheetTouchStart"
          bindtouchmove="onCheckoutSheetTouchMove"
          bindtouchend="onCheckoutSheetTouchEnd"
          bindtouchcancel="onCheckoutSheetTouchEnd"
        ></view>
        <view class="row-between checkout-heading">
          <view>
            <view class="section-title">购买服务包</view>
            <view class="muted form-hint">{{selectedPackage.name}} · {{selectedPackage.lessonLabel}} · {{selectedPackage.priceLabel}}</view>
          </view>
          <view class="close-button" aria-role="button" aria-label="关闭" bindtap="closeCheckout">×</view>
        </view>

        <block wx:if="{{checkoutOrder && childProfileRequired}}">
          <view class="order-result">
            <view class="row-between">
              <view class="order-no">{{checkoutOrder.orderNo}}</view>
              <view class="order-status paid">已支付</view>
            </view>
            <view class="muted order-meta">{{checkoutOrder.amountLabel}} · {{checkoutOrder.lessonCount}} 次</view>
          </view>
          <form class="form-gap child-profile-form" bindsubmit="onCompleteCheckoutStudent">
            <input class="form-field" name="studentName" placeholder="孩子姓名" />
            <input class="form-field" name="grade" placeholder="年级 / 年龄（选填）" />
            <button class="btn btn-primary checkout-submit" form-type="submit" loading="{{completingChildProfile}}" disabled="{{completingChildProfile}}">
              {{completingChildProfile ? '保存中...' : '开通服务'}}
            </button>
          </form>
        </block>

        <block wx:elif="{{checkoutOrder}}">
          <view class="order-result">
            <view class="row-between">
              <view class="order-no">{{checkoutOrder.orderNo}}</view>
              <view class="order-status {{checkoutOrder.status}}">{{checkoutOrder.statusLabel}}</view>
            </view>
            <view class="muted order-meta">{{checkoutOrder.amountLabel}} · {{checkoutOrder.lessonCount}} 次</view>
            <view wx:if="{{checkoutDefaultPassword}}" class="password-note">
              初始密码：{{checkoutDefaultPassword}}。后续可用手机号登录家长中心。
            </view>
            <button wx:if="{{checkoutOrder.status == 'pending'}}" class="btn btn-primary checkout-submit" loading="{{payingOrder}}" disabled="{{payingOrder}}" bindtap="onContinuePay" data-order-no="{{checkoutOrder.orderNo}}">
              {{payingOrder ? '支付中...' : '继续支付'}}
            </button>
          </view>
        </block>

        <block wx:else>
          <view class="checkout-hint">授权微信手机号后将创建订单并发起支付，支付完成后再完善孩子信息。</view>
          <button
            class="btn btn-primary checkout-submit"
            open-type="getPhoneNumber"
            bindgetphonenumber="onCheckoutPhoneAuth"
            loading="{{submittingOrder || payingOrder}}"
            disabled="{{submittingOrder || payingOrder}}"
          >
            {{submittingOrder || payingOrder ? '处理中...' : '微信授权并支付'}}
          </button>
        </block>
      </view>
    </view>

    <view wx:if="{{showTrialForm}}" class="sheet-mask" bindtap="closeTrial">
      <form class="bottom-sheet trial-sheet {{trialSheetDragging ? 'dragging' : ''}}" style="transform: translateY({{trialSheetOffset}}px);" catchtap="noop" bindsubmit="onTrialSubmit">
        <view
          class="sheet-handle"
          bindtouchstart="onTrialSheetTouchStart"
          bindtouchmove="onTrialSheetTouchMove"
          bindtouchend="onTrialSheetTouchEnd"
          bindtouchcancel="onTrialSheetTouchEnd"
        ></view>
        <view class="row-between checkout-heading">
          <view>
            <view class="section-title">预约试听</view>
            <view class="muted form-hint">提交后工作人员会电话确认试听时间。</view>
          </view>
          <view class="close-button" aria-role="button" aria-label="关闭" bindtap="closeTrial">×</view>
        </view>
        <view class="form-gap">
          <input class="form-field" name="guardianName" placeholder="家长姓名" />
          <input class="form-field" name="phone" type="number" placeholder="手机号" />
          <input class="form-field" name="studentName" placeholder="孩子姓名" />
          <input class="form-field" name="grade" placeholder="年级 / 年龄" />
        </view>
        <button class="btn btn-primary trial-submit" form-type="submit" loading="{{submittingTrial}}" disabled="{{submittingTrial}}">
          {{submittingTrial ? '提交中...' : '提交预约'}}
        </button>
      </form>
    </view>
  </block>
</view>
