<custom-navbar title="课堂互动" show-back="{{true}}" />
<view class="page feedback-page">
  <skeleton wx:if="{{loading}}" variant="list" />

  <block wx:else>
    <view wx:if="{{error}}" class="error-card">{{error}}</view>

    <view wx:if="{{detail}}" class="session-card">
      <view class="session-date">{{dateLabel}}</view>
      <view class="session-time">{{timeLabel}}</view>
      <view class="session-title">{{className}} · {{title}}</view>
      <view class="session-meta">{{teacherName}} / {{classroomName}}</view>
    </view>

    <view wx:if="{{rows.length}}" class="batch-card">
      <view class="card-title">批量设置</view>
      <view class="card-hint">先统一设置，再为个别学员单独调整。</view>
      <view class="batch-row">
        <view class="batch-label">统一评分</view>
        <view class="star-row">
          <view
            wx:for="{{starOptions}}"
            wx:key="*this"
            class="star {{batchRating >= item ? 'active' : ''}}"
            data-rating="{{item}}"
            bindtap="applyAllRating"
          >
            ★
          </view>
        </view>
      </view>
      <view class="template-list">
        <view
          wx:for="{{feedbackTemplates}}"
          wx:key="*this"
          class="template-chip"
          data-value="{{item}}"
          bindtap="applyFeedbackTemplate"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view wx:if="{{rows.length}}" class="assignment-card">
      <view class="card-title">班级统一任务</view>
      <view class="template-list compact">
        <view
          wx:for="{{assignmentTemplates}}"
          wx:key="*this"
          class="template-chip"
          data-value="{{item}}"
          bindtap="applyAssignmentTemplate"
        >
          {{item}}
        </view>
      </view>
      <textarea
        class="feedback-input assignment-input"
        value="{{classAssignmentContent}}"
        bindinput="updateClassAssignment"
        placeholder="不填写则不布置班级统一任务"
        maxlength="2000"
      />
    </view>

    <view wx:if="{{rows.length}}" class="student-list">
      <view wx:for="{{rows}}" wx:key="id" class="student-card">
        <view class="student-head">
          <view>
            <view class="student-name">{{item.name}}</view>
            <view class="student-grade">{{item.grade || '年级未填写'}}</view>
          </view>
          <view class="rating-label">{{item.rating ? item.rating + ' 星' : '待评价'}}</view>
        </view>

        <view class="star-row student-stars">
          <view
            wx:for="{{starOptions}}"
            wx:for-item="ratingItem"
            wx:key="*this"
            class="star {{item.rating >= ratingItem ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-rating="{{ratingItem}}"
            bindtap="selectRating"
          >
            ★
          </view>
        </view>

        <textarea
          class="feedback-input"
          value="{{item.content}}"
          data-id="{{item.id}}"
          bindinput="updateContent"
          placeholder="课堂表现、掌握情况和后续建议"
          maxlength="2000"
        />

        <view class="image-row">
          <view
            wx:for="{{item.imageUrls}}"
            wx:for-item="imageUrl"
            wx:for-index="imageIndex"
            wx:key="*this"
            class="image-item"
          >
            <image
              class="feedback-image"
              src="{{imageUrl}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              data-url="{{imageUrl}}"
              bindtap="previewImage"
            />
            <view
              class="image-remove"
              data-id="{{item.id}}"
              data-index="{{imageIndex}}"
              catchtap="removeImage"
            >
              ×
            </view>
          </view>
          <view
            wx:if="{{item.imageUrls.length < 6}}"
            class="image-add"
            data-id="{{item.id}}"
            bindtap="chooseImages"
          >
            <view class="image-add-mark">＋</view>
            <view>{{uploadingStudentId == item.id ? '上传中' : '课堂照片'}}</view>
          </view>
        </view>

        <view
          class="personal-toggle {{item.personalAssignmentEnabled ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="togglePersonalAssignment"
        >
          {{item.personalAssignmentEnabled ? '取消个人任务' : '添加个人任务'}}
        </view>
        <textarea
          wx:if="{{item.personalAssignmentEnabled}}"
          class="feedback-input assignment-input"
          value="{{item.assignmentContent}}"
          data-id="{{item.id}}"
          bindinput="updatePersonalAssignment"
          placeholder="该学员的个人任务，将覆盖班级统一任务"
          maxlength="2000"
        />
      </view>
    </view>

    <view wx:else class="empty-card">本课次暂无学员，暂时不能填写互动。</view>
  </block>

  <view wx:if="{{!loading && rows.length}}" class="save-bar">
    <button class="save-button secondary" loading="{{saving && saveMode == 'save'}}" disabled="{{saving}}" bindtap="saveDraft">
      {{hasExistingFeedback ? '保存修改' : '仅保存'}}
    </button>
    <button class="save-button primary" loading="{{saving && saveMode == 'notify'}}" disabled="{{saving}}" bindtap="saveAndNotify">
      保存并通知家长
    </button>
  </view>
</view>
