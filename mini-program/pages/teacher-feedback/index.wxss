.feedback-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  background: #f6f4f0;
}

.error-card,
.session-card,
.batch-card,
.assignment-card,
.student-card,
.empty-card {
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.07);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(65, 45, 31, 0.05);
}

.error-card {
  background: #fff0ed;
  color: #a9453b;
  font-size: 23rpx;
  line-height: 1.5;
  padding: 20rpx 24rpx;
}

.session-card {
  position: relative;
  padding: 28rpx;
  text-align: center;
}

.session-date {
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 800;
}

.session-time {
  margin-top: 4rpx;
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
}

.session-title {
  margin-top: 10rpx;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 900;
}

.session-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.batch-card,
.assignment-card,
.student-card {
  padding: 26rpx;
}

.card-title {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
}

.card-hint {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.batch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
}

.batch-label {
  color: #57534e;
  font-size: 22rpx;
  font-weight: 800;
}

.star-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.star {
  color: #d8d1ca;
  font-size: 34rpx;
  line-height: 1;
}

.star.active,
.student-stars .star.active {
  color: #a87552;
}

.template-list {
  display: flex;
  margin-top: 20rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.template-list.compact {
  margin-top: 14rpx;
}

.template-chip {
  border-radius: 999rpx;
  background: #f2ebe5;
  color: #8f6043;
  font-size: 20rpx;
  line-height: 1.35;
  padding: 10rpx 16rpx;
}

.feedback-input {
  width: 100%;
  min-height: 128rpx;
  margin-top: 18rpx;
  border: 1rpx solid #e4ded7;
  border-radius: 18rpx;
  background: #fbfaf8;
  color: #211f1c;
  font-size: 23rpx;
  line-height: 1.55;
  padding: 18rpx;
}

.assignment-input {
  min-height: 104rpx;
}

.student-list {
  display: grid;
  gap: 18rpx;
}

.student-card {
  margin-bottom: 0;
}

.student-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.student-name {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 900;
}

.student-grade {
  margin-top: 2rpx;
  color: #8b857c;
  font-size: 20rpx;
}

.rating-label {
  border-radius: 999rpx;
  background: #f2ebe5;
  color: #9a6a4b;
  font-size: 20rpx;
  font-weight: 800;
  padding: 8rpx 14rpx;
}

.student-stars {
  margin-top: 18rpx;
}

.image-row {
  display: flex;
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item,
.image-add {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  border-radius: 16rpx;
}

.feedback-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-remove {
  position: absolute;
  top: -9rpx;
  right: -9rpx;
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(33, 31, 28, 0.82);
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}

.image-add {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1rpx dashed #cfc5bc;
  background: #fbfaf8;
  color: #8b857c;
  font-size: 18rpx;
}

.image-add-mark {
  color: #9a6a4b;
  font-size: 34rpx;
  line-height: 1;
}

.personal-toggle {
  display: inline-flex;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #f6f4f0;
  color: #756e67;
  font-size: 20rpx;
  font-weight: 800;
  padding: 9rpx 15rpx;
}

.personal-toggle.active {
  background: #f2e7dd;
  color: #9a6a4b;
}

.empty-card {
  color: #8b857c;
  font-size: 24rpx;
  padding: 50rpx 28rpx;
  text-align: center;
}

.save-bar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 14rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  background: rgba(255, 255, 255, 0.96);
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  backdrop-filter: blur(18rpx);
}

.save-button {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1;
  padding: 0;
}

.save-button::after {
  border: 0;
}

.save-button.secondary {
  background: #f2ebe5;
  color: #9a6a4b;
}

.save-button.primary {
  background: #9a6a4b;
  color: #fff;
}
