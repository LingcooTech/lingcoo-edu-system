.tasks-page {
  background: #f5f3ef;
}

.tasks-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 84% 18%, rgba(255, 224, 143, 0.42), rgba(255, 224, 143, 0) 34%),
    #fff;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.06);
  padding: 30rpx;
}

.tasks-kicker {
  color: #8b857c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tasks-count {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.tasks-desc {
  max-width: 390rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: right;
}

.task-link {
  display: inline-block;
  margin-top: 18rpx;
}

.task-link-hover {
  background: #f1dcc8;
}

.tasks-empty {
  display: flex;
  min-height: 520rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.tasks-empty-mark {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 54rpx;
  font-weight: 900;
}

.tasks-empty-title {
  margin-top: 28rpx;
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.tasks-empty-desc {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #8b857c;
  font-size: 25rpx;
  line-height: 1.55;
}

.tasks-empty-link {
  margin-top: 28rpx;
}
