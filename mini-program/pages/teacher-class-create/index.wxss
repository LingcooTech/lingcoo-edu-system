.teacher-class-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 180rpx;
  background: #f6f4f0;
}

.form-card,
.student-card,
.error-card {
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.error-card {
  color: #a83f35;
  background: #fff1ef;
}

.section-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.field {
  min-width: 0;
  margin-top: 24rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6b6258;
  font-size: 23rpx;
  font-weight: 750;
}

.picker-value,
.text-input,
.search-input {
  min-height: 78rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3ded7;
  border-radius: 18rpx;
  background: #fbfaf8;
  color: #211f1c;
  font-size: 27rpx;
  line-height: 78rpx;
  padding: 0 22rpx;
}

.row-between,
.search-row,
.student-row,
.submit-bar {
  display: flex;
  align-items: center;
}

.row-between,
.submit-bar {
  justify-content: space-between;
}

.hint {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.search-row {
  gap: 10rpx;
  margin-top: 22rpx;
}

.search-input {
  height: 70rpx;
  min-height: 70rpx;
  flex: 1;
  font-size: 24rpx;
  line-height: 70rpx;
  padding: 0 20rpx;
}

.search-button,
.submit-button {
  border: 0;
  border-radius: 18rpx;
  margin: 0;
}

.search-button {
  width: 108rpx;
  max-width: 108rpx;
  height: 70rpx;
  flex: 0 0 108rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 70rpx;
  padding: 0;
}

.search-button::after,
.submit-button::after {
  border: 0;
}

.student-list {
  margin-top: 16rpx;
}

.student-list-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #8b857c;
  font-size: 21rpx;
  line-height: 1.35;
}

.student-row {
  gap: 16rpx;
  border-bottom: 1rpx solid #eeeae5;
  padding: 20rpx 0;
}

.check {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c9c2b8;
  border-radius: 12rpx;
  color: #fff;
  font-size: 24rpx;
}

.check-active {
  border-color: #9a6a4b;
  background: #9a6a4b;
}

.student-info {
  min-width: 0;
  flex: 1;
}

.student-name {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 850;
}

.empty-card {
  padding: 30rpx 0;
  color: #8b857c;
  font-size: 24rpx;
  text-align: center;
}

.submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 20rpx;
  border-top: 1rpx solid #e7e1da;
  background: rgba(255, 255, 255, 0.96);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
}

.submit-summary {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #6b6258;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-button {
  min-width: 210rpx;
  height: 78rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 78rpx;
  padding: 0 28rpx;
}
