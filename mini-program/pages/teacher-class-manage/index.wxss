.teacher-class-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 80rpx;
  background: #f6f4f0;
}

.form-card,
.member-card,
.error-card {
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.error-card {
  color: #a83f35;
  background: #fff1ef;
}

.section-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.course-label {
  margin-top: 10rpx;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 750;
}

.field {
  min-width: 0;
  margin-top: 24rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6b6258;
  font-size: 23rpx;
  font-weight: 750;
}

.picker-value,
.text-input,
.search-input {
  min-height: 78rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3ded7;
  border-radius: 18rpx;
  background: #fbfaf8;
  color: #211f1c;
  font-size: 27rpx;
  line-height: 78rpx;
  padding: 0 22rpx;
}

.save-button,
.search-button,
.add-button,
.remove-button {
  border: 0;
  margin: 0;
}

.save-button::after,
.search-button::after,
.add-button::after,
.remove-button::after {
  border: 0;
}

.save-button {
  height: 76rpx;
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: #211f1c;
  color: #fff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.member-list {
  margin-top: 14rpx;
}

.member-row,
.search-row {
  display: flex;
  align-items: center;
}

.member-row {
  gap: 18rpx;
  border-bottom: 1rpx solid #eeeae5;
  padding: 20rpx 0;
}

.member-info {
  min-width: 0;
  flex: 1;
}

.student-name {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 850;
}

.hint {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.add-button,
.remove-button {
  min-width: 104rpx;
  height: 56rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
}

.add-button {
  background: #e7f1e8;
  color: #386a41;
}

.remove-button {
  background: #fff0ee;
  color: #a83f35;
}

.search-row {
  gap: 12rpx;
  margin-top: 22rpx;
}

.search-input {
  flex: 1;
}

.search-button {
  width: 116rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #211f1c;
  color: #fff;
  font-size: 24rpx;
  line-height: 76rpx;
  padding: 0;
}

.empty-card {
  padding: 30rpx 0;
  color: #8b857c;
  font-size: 24rpx;
  text-align: center;
}
