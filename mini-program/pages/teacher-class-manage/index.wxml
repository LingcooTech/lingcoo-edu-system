<custom-navbar title="管理班级" show-back="{{true}}" />
<view class="page teacher-class-page">
  <skeleton wx:if="{{loading}}" variant="hub" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-card">{{error}}</view>

    <view wx:if="{{classGroup && options}}" class="form-card">
      <view class="section-title">班级设置</view>
      <view class="course-label">{{classGroup.course.name || '课程'}}</view>
      <view class="field">
        <view class="field-label">班级名称</view>
        <input class="text-input" value="{{name}}" maxlength="160" bindinput="changeName" />
      </view>
      <view class="field">
        <view class="field-label">教室</view>
        <picker range="{{options.classrooms}}" range-key="name" value="{{classroomIndex}}" bindchange="changeClassroom">
          <view class="picker-value">{{options.classrooms[classroomIndex].name}} ›</view>
        </picker>
      </view>
      <view class="field-row">
        <view class="field">
          <view class="field-label">容量</view>
          <input class="text-input" type="number" value="{{capacity}}" bindinput="changeCapacity" />
        </view>
        <view class="field">
          <view class="field-label">状态</view>
          <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus">
            <view class="picker-value">{{statusOptions[statusIndex].label}} ›</view>
          </picker>
        </view>
      </view>
      <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveClass">保存班级设置</button>
    </view>

    <view wx:if="{{classGroup}}" class="member-card">
      <view class="section-title">当前成员（{{classGroup.students.length}}/{{classGroup.capacity}}）</view>
      <view wx:if="{{classGroup.students.length}}" class="member-list">
        <view wx:for="{{classGroup.students}}" wx:key="id" class="member-row">
          <view class="member-info">
            <view class="student-name">{{item.name}}</view>
            <view class="hint">{{item.grade}}{{item.school ? ' · ' + item.school : ''}} · 余额 {{item.lessonBalance == null ? '-' : item.lessonBalance}}</view>
          </view>
          <button
            class="remove-button"
            loading="{{memberSavingId == item.id}}"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            bindtap="removeStudent"
          >移出</button>
        </view>
      </view>
      <view wx:else class="empty-card">当前是空班。</view>
    </view>

    <view wx:if="{{classGroup && options && options.permissions.viewAllStudents && options.permissions.enrollStudents}}" class="member-card">
      <view class="section-title">添加学员</view>
      <view class="hint">仅展示拥有“{{classGroup.course.name}}”课时账户的学员。</view>
      <view class="search-row">
        <input class="search-input" value="{{keyword}}" bindinput="changeKeyword" confirm-type="search" bindconfirm="searchCandidates" placeholder="搜索姓名、年级或学校" />
        <button class="search-button" loading="{{studentLoading}}" bindtap="searchCandidates">搜索</button>
      </view>
      <view wx:if="{{candidates.length}}" class="member-list">
        <view wx:for="{{candidates}}" wx:key="id" class="member-row">
          <view class="member-info">
            <view class="student-name">{{item.name}}</view>
            <view class="hint">{{item.grade}}{{item.school ? ' · ' + item.school : ''}}</view>
          </view>
          <button class="add-button" loading="{{memberSavingId == item.id}}" data-id="{{item.id}}" bindtap="addStudent">入班</button>
        </view>
      </view>
      <view wx:else class="empty-card">{{studentLoading ? '正在加载学员…' : '没有可添加的学员'}}</view>
    </view>
  </block>
</view>
