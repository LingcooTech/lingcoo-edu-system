.schedule-create-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 180rpx;
  background: #f6f4f0;
}

.form-card,
.student-card,
.error-card {
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.error-card {
  color: #a83f35;
  background: #fff1ef;
}

.section-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.field {
  min-width: 0;
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6b6258;
  font-size: 23rpx;
  font-weight: 750;
}

.picker-value,
.text-input,
.search-input {
  min-height: 78rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3ded7;
  border-radius: 18rpx;
  background: #fbfaf8;
  color: #211f1c;
  font-size: 27rpx;
  line-height: 78rpx;
  padding: 0 22rpx;
}

.time-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.unit-stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-button {
  width: 72rpx;
  height: 64rpx;
  border: 0;
  border-radius: 18rpx;
  background: #f1e8df;
  color: #714b35;
  font-size: 34rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
}

.step-button::after,
.search-button::after,
.mode-button::after,
.submit-button::after {
  border: 0;
}

.unit-value {
  min-width: 60rpx;
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
  text-align: center;
}

.student-head,
.student-main,
.student-row,
.search-row,
.submit-bar {
  display: flex;
  align-items: center;
}

.student-head,
.student-row,
.submit-bar {
  justify-content: space-between;
}

.hint {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.search-row {
  gap: 12rpx;
  margin-top: 22rpx;
}

.search-input {
  flex: 1;
}

.search-button {
  width: 116rpx;
  height: 76rpx;
  border: 0;
  border-radius: 18rpx;
  background: #211f1c;
  color: #fff;
  font-size: 24rpx;
  line-height: 76rpx;
  margin: 0;
  padding: 0;
}

.student-list {
  margin-top: 16rpx;
}

.student-row {
  gap: 12rpx;
  border-bottom: 1rpx solid #eeeae5;
  padding: 20rpx 0;
}

.student-main {
  min-width: 0;
  flex: 1;
  gap: 16rpx;
}

.check {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c9c2b8;
  border-radius: 12rpx;
  color: #fff;
  font-size: 24rpx;
}

.check-active {
  border-color: #9a6a4b;
  background: #9a6a4b;
}

.student-info {
  min-width: 0;
}

.student-name {
  color: #211f1c;
  font-size: 27rpx;
  font-weight: 850;
}

.mode-button {
  min-width: 130rpx;
  height: 54rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f3f0ec;
  color: #6b6258;
  font-size: 20rpx;
  line-height: 54rpx;
  margin: 0;
  padding: 0 16rpx;
}

.mode-button-active {
  background: #e7f1e8;
  color: #386a41;
}

.empty-card {
  padding: 30rpx 0;
  color: #8b857c;
  font-size: 24rpx;
  text-align: center;
}

.submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 20rpx;
  border-top: 1rpx solid #e7e1da;
  background: rgba(255, 255, 255, 0.96);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
}

.submit-summary {
  flex: 1;
  color: #6b6258;
  font-size: 23rpx;
}

.submit-button {
  min-width: 220rpx;
  height: 78rpx;
  border: 0;
  border-radius: 22rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 78rpx;
  margin: 0;
  padding: 0 30rpx;
}
