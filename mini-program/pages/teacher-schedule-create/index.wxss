.schedule-create-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 180rpx;
  background: #f6f4f0;
}

.schedule-edit-page {
  padding-bottom: 250rpx;
}

.form-card,
.student-card,
.error-card {
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.error-card {
  color: #a83f35;
  background: #fff1ef;
}

.section-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.field {
  min-width: 0;
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6b6258;
  font-size: 23rpx;
  font-weight: 750;
}

.picker-value,
.text-input,
.search-input {
  min-height: 78rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3ded7;
  border-radius: 18rpx;
  background: #fbfaf8;
  color: #211f1c;
  font-size: 27rpx;
  line-height: 78rpx;
  padding: 0 22rpx;
}

.time-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.unit-stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-button {
  width: 72rpx;
  height: 64rpx;
  border: 0;
  border-radius: 18rpx;
  background: #f1e8df;
  color: #714b35;
  font-size: 34rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
}

.step-button::after,
.search-button::after,
.mode-button::after,
.submit-button::after {
  border: 0;
}

.unit-value {
  min-width: 60rpx;
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
  text-align: center;
}

.student-head,
.student-section-head,
.class-student-row,
.class-student-main,
.student-main,
.student-row,
.search-row,
.student-list-summary,
.submit-actions,
.submit-bar {
  display: flex;
  align-items: center;
}

.student-head,
.student-section-head,
.class-student-main,
.student-list-summary,
.submit-bar {
  justify-content: space-between;
}

.hint {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.search-row {
  gap: 10rpx;
  margin-top: 18rpx;
}

.search-input {
  height: 70rpx;
  min-height: 70rpx;
  flex: 1;
  font-size: 24rpx;
  line-height: 70rpx;
  padding: 0 20rpx;
}

.search-button {
  width: 108rpx;
  max-width: 108rpx;
  height: 70rpx;
  flex: 0 0 108rpx;
  border: 0;
  border-radius: 18rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 70rpx;
  margin: 0;
  padding: 0;
}

.student-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.student-row {
  min-width: 0;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.06);
  border-radius: 18rpx;
  background: #fbfaf8;
  padding: 16rpx 14rpx;
}

.student-row-active {
  border-color: rgba(154, 106, 75, 0.28);
  background: #f1e9e1;
}

.student-row-disabled {
  opacity: 0.55;
}

.student-main {
  width: 100%;
  min-width: 0;
  flex: 1;
  gap: 10rpx;
}

.check {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c9c2b8;
  border-radius: 12rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.check-active {
  border-color: #9a6a4b;
  background: #9a6a4b;
}

.student-info {
  min-width: 0;
  flex: 1;
}

.student-name {
  overflow: hidden;
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-row .hint,
.class-student-row .hint {
  overflow: hidden;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mode-button {
  align-self: flex-end;
  min-width: 112rpx;
  height: 44rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f3f0ec;
  color: #6b6258;
  font-size: 18rpx;
  line-height: 44rpx;
  margin: 0;
  padding: 0 14rpx;
}

.mode-button-active {
  background: #e7f1e8;
  color: #386a41;
}

.student-section-head {
  gap: 20rpx;
  margin-top: 24rpx;
}

.student-section-title {
  color: #332e29;
  font-size: 25rpx;
  font-weight: 850;
}

.student-section-count {
  flex-shrink: 0;
  color: #8b857c;
  font-size: 21rpx;
}

.other-student-head {
  margin-top: 30rpx;
  border-top: 1rpx solid #eeeae5;
  padding-top: 26rpx;
}

.class-student-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.class-student-row {
  min-width: 0;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  border: 1rpx solid rgba(154, 106, 75, 0.18);
  border-radius: 18rpx;
  background: #f8f2ec;
  padding: 14rpx;
}

.class-student-main {
  min-width: 0;
  gap: 10rpx;
}

.class-student-row-removed {
  border-color: rgba(33, 31, 28, 0.06);
  background: #fbfaf8;
  opacity: 0.65;
}

.roster-button {
  display: flex;
  width: 76rpx;
  max-width: 76rpx;
  height: 44rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.roster-remove-button {
  background: #fff0ee;
  color: #a83f35;
}

.roster-add-button {
  background: #9a6a4b;
  color: #fff;
}

.roster-button::after {
  border: 0;
}

.billing-picker {
  overflow: hidden;
  border-radius: 12rpx;
  background: rgba(154, 106, 75, 0.09);
  color: #714b35;
  font-size: 18rpx;
  line-height: 1.35;
  padding: 10rpx 12rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.billing-picker-empty {
  background: #f1efec;
  color: #99928a;
}

.student-list-summary {
  margin-top: 14rpx;
  color: #8b857c;
  font-size: 21rpx;
  line-height: 1.35;
}

.empty-card {
  padding: 30rpx 0;
  color: #8b857c;
  font-size: 24rpx;
  text-align: center;
}

.compact-empty {
  padding: 24rpx 0 8rpx;
}

.submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 20rpx;
  border-top: 1rpx solid #e7e1da;
  background: rgba(255, 255, 255, 0.96);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
}

.submit-summary {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #6b6258;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-actions {
  flex-shrink: 0;
  gap: 12rpx;
}

.submit-bar-edit {
  flex-wrap: wrap;
  gap: 14rpx;
}

.submit-bar-edit .submit-summary {
  width: 100%;
  flex: 0 0 100%;
  line-height: 1.4;
}

.submit-bar-edit .submit-actions {
  width: 100%;
}

.submit-button {
  min-width: 220rpx;
  height: 78rpx;
  border: 0;
  border-radius: 22rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 78rpx;
  margin: 0;
  padding: 0 30rpx;
}

.cancel-session-button {
  width: 142rpx;
  height: 66rpx;
  border: 0;
  border-radius: 18rpx;
  background: #fff0ee;
  color: #a83f35;
  font-size: 21rpx;
  font-weight: 850;
  line-height: 66rpx;
  margin: 0;
  padding: 0;
}

.submit-bar-edit .cancel-session-button,
.submit-bar-edit .submit-button {
  width: auto;
  min-width: 0;
  height: 70rpx;
  flex: 1;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 70rpx;
}

.submit-bar-edit .submit-button {
  flex: 1.15;
  padding: 0 20rpx;
}

.cancel-session-button::after {
  border: 0;
}

.readonly-label {
  color: #8b857c;
  font-size: 21rpx;
}
