<custom-navbar title="{{editing ? '编辑课次' : '添加课次'}}" show-back="{{true}}" />
<view class="page schedule-create-page">
  <skeleton wx:if="{{loading}}" variant="hub" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-card">{{error}}</view>

    <view wx:if="{{options}}" class="form-card">
      <view class="section-title">课程信息</view>
      <view class="field">
        <view class="field-label">排课类型</view>
        <picker disabled="{{editing}}" range="{{modeOptions}}" range-key="label" value="{{modeIndex}}" bindchange="changeMode">
          <view class="picker-value">{{modeOptions[modeIndex].label}} ›</view>
        </picker>
      </view>

      <view wx:if="{{modeOptions[modeIndex].key == 'class'}}" class="field">
        <view class="field-label">正式班级</view>
        <picker disabled="{{editing}}" range="{{options.classes}}" range-key="name" value="{{classIndex}}" bindchange="changeClass">
          <view class="picker-value">
            {{editing ? classDisplayName : options.classes[classIndex].name}} ›
          </view>
        </picker>
      </view>
      <view wx:else class="field">
        <view class="field-label">课程</view>
        <picker disabled="{{editing}}" range="{{options.courses}}" range-key="name" value="{{courseIndex}}" bindchange="changeCourse">
          <view class="picker-value">
            {{editing ? courseDisplayName : options.courses[courseIndex].name}} ›
          </view>
        </picker>
      </view>

      <view class="field">
        <view class="field-label">教室</view>
        <picker disabled="{{editing && !editable}}" range="{{options.classrooms}}" range-key="name" value="{{classroomIndex}}" bindchange="changeClassroom">
          <view class="picker-value">
            {{editing && !editable ? classroomDisplayName : options.classrooms[classroomIndex].name}} ›
          </view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">日期</view>
        <picker disabled="{{editing && !editable}}" mode="date" value="{{date}}" bindchange="changeDate">
          <view class="picker-value">{{date}} ›</view>
        </picker>
      </view>
      <view class="time-row">
        <view class="field">
          <view class="field-label">上课</view>
          <picker disabled="{{editing && !editable}}" mode="time" value="{{startTime}}" bindchange="changeStartTime">
            <view class="picker-value">{{startTime}} ›</view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">下课</view>
          <picker disabled="{{editing && !editable}}" mode="time" value="{{endTime}}" bindchange="changeEndTime">
            <view class="picker-value">{{endTime}} ›</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <view class="field-label">课程内容</view>
        <input class="text-input" disabled="{{editing && !editable}}" value="{{topic}}" maxlength="200" bindinput="changeTopic" placeholder="例如：色彩基础练习" />
      </view>
      <view class="field">
        <view class="field-label">本次扣减课时</view>
        <view class="unit-stepper">
          <button class="step-button" disabled="{{!options.permissions.setLessonUnits || (editing && !editable)}}" bindtap="decreaseUnits">−</button>
          <view class="unit-value">{{lessonUnits}}</view>
          <button class="step-button" disabled="{{!options.permissions.setLessonUnits || (editing && !editable)}}" bindtap="increaseUnits">＋</button>
        </view>
        <view wx:if="{{!options.permissions.setLessonUnits}}" class="hint">当前固定扣 1 课时</view>
      </view>
    </view>

    <view wx:if="{{options}}" class="student-card">
      <view class="student-head">
        <view>
          <view class="section-title">
            {{modeOptions[modeIndex].key == 'class' ? '本课次学员' : '选择学员'}}
          </view>
          <view class="hint">已选 {{selectedCount}} 人</view>
        </view>
      </view>

      <block wx:if="{{modeOptions[modeIndex].key == 'class'}}">
        <view class="student-section-head">
          <view>
            <view class="student-section-title">班级已有学员</view>
            <view class="hint">默认加入本课次；添加或移出只影响本次名单</view>
          </view>
          <view class="student-section-count">
            {{selectedClassStudentIds.length}}/{{classStudents.length}} 人
          </view>
        </view>
        <view wx:if="{{classStudents.length}}" class="class-student-list">
          <view
            wx:for="{{classStudents}}"
            wx:key="id"
            class="class-student-row {{item.selected ? '' : 'class-student-row-removed'}}"
          >
            <view class="class-student-main">
              <view class="student-info">
                <view class="student-name">{{item.name}}</view>
                <view class="hint">
                  {{item.grade}}{{item.school ? ' · ' + item.school : ''}}
                </view>
              </view>
              <button
                disabled="{{(editing && !editable) || (item.selected && !item.canRemove)}}"
                class="{{item.selected ? 'roster-button roster-remove-button' : 'roster-button roster-add-button'}}"
                data-id="{{item.id}}"
                bindtap="toggleClassStudent"
              >
                {{item.selected ? '移出' : '添加'}}
              </button>
            </view>
            <picker
              wx:if="{{item.billingOptions.length}}"
              disabled="{{(editing && !editable) || !item.canRemove}}"
              range="{{item.billingOptions}}"
              range-key="label"
              value="{{item.billingIndex}}"
              data-id="{{item.id}}"
              bindchange="changeClassStudentBilling"
            >
              <view class="billing-picker">扣课课包：{{item.billingOptions[item.billingIndex].label}} ›</view>
            </picker>
            <view wx:else class="billing-picker billing-picker-empty">暂无可扣课档案</view>
          </view>
        </view>
        <view wx:else class="empty-card compact-empty">当前班级暂无学员，可从下方增加其他学员。</view>

        <view class="student-section-head other-student-head">
          <view>
            <view class="student-section-title">增加其他学员</view>
            <view class="hint">从全部学员中选择，班级已有学员已自动排除</view>
          </view>
        </view>
      </block>

      <view wx:if="{{options.permissions.viewAllStudents}}" class="search-row">
        <input class="search-input" value="{{keyword}}" bindinput="changeKeyword" confirm-type="search" bindconfirm="applyStudentSearch" placeholder="搜索姓名、年级或学校" />
        <button class="search-button" loading="{{studentLoading}}" bindtap="applyStudentSearch">搜索</button>
      </view>
      <view wx:if="{{options.permissions.viewAllStudents}}" class="student-list-summary">
        <text>显示 {{students.length}}/{{totalStudents}} 名学员</text>
        <text>已增加 {{selectedOtherStudentIds.length}} 名</text>
      </view>
      <view wx:if="{{!options.permissions.viewAllStudents}}" class="empty-card">当前账号未开通查看全部学员权限。</view>
      <view wx:elif="{{students.length}}" class="student-list">
        <view
          wx:for="{{students}}"
          wx:key="id"
          class="student-row {{item.selected ? 'student-row-active' : ''}} {{item.selectable ? '' : 'student-row-disabled'}}"
        >
          <view class="student-main" data-id="{{item.id}}" bindtap="toggleStudent">
            <view class="{{item.selected ? 'check check-active' : 'check'}}">{{item.selected ? '✓' : ''}}</view>
            <view class="student-info">
              <view class="student-name">{{item.name}}</view>
              <view class="hint">
                {{item.grade}}{{item.school ? ' · ' + item.school : ''}}
              </view>
            </view>
          </view>
          <button
            wx:if="{{item.selected && modeOptions[modeIndex].key == 'class' && options.permissions.enrollStudents}}"
            disabled="{{(editing && !editable) || !item.canRemove}}"
            class="{{item.enrollmentMode == 'class' ? 'mode-button mode-button-active' : 'mode-button'}}"
            data-id="{{item.id}}"
            bindtap="toggleEnrollmentMode"
          >
            {{item.enrollmentMode == 'class' ? '正式入班' : '仅本课次'}}
          </button>
          <picker
            wx:if="{{item.selected && item.billingOptions.length}}"
            disabled="{{(editing && !editable) || !item.canRemove}}"
            range="{{item.billingOptions}}"
            range-key="label"
            value="{{item.billingIndex}}"
            data-id="{{item.id}}"
            bindchange="changeStudentBilling"
          >
            <view class="billing-picker">扣课课包：{{item.billingOptions[item.billingIndex].label}} ›</view>
          </picker>
          <view wx:elif="{{!item.billingOptions.length}}" class="billing-picker billing-picker-empty">
            暂无可扣课档案
          </view>
        </view>
      </view>
      <view wx:else class="empty-card">
        {{studentLoading ? '正在加载学员…' : '没有符合条件的其他学员'}}
      </view>
    </view>

    <view class="submit-bar">
      <view class="submit-summary">共 {{selectedCount}} 名学员 · 扣 {{lessonUnits}} 课时</view>
      <button
        wx:if="{{editing && editable}}"
        class="cancel-session-button"
        disabled="{{saving}}"
        bindtap="cancelSession"
      >取消课次</button>
      <button
        wx:if="{{!editing || editable}}"
        class="submit-button"
        loading="{{saving}}"
        disabled="{{saving}}"
        bindtap="submit"
      >{{editing ? '保存修改' : '确认排课'}}</button>
      <view wx:else class="readonly-label">已完成或已取消，仅可查看</view>
    </view>
  </block>
</view>
