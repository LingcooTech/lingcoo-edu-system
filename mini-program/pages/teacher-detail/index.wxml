<custom-navbar title="老师详情" show-back="{{true}}" />
<view class="page teacher-detail-page">
  <skeleton wx:if="{{loading}}" variant="detail" />

  <view wx:elif="{{notFound}}" class="empty-state">
    <view class="section-title">老师不存在或已下线</view>
    <button class="btn btn-outline empty-button" bindtap="goTeachers">返回教师团队</button>
  </view>

  <block wx:else>
    <view class="header">
      <view class="header-grid">
        <view class="teacher-main">
          <view wx:if="{{institution && institution.logoUrl}}" class="teacher-logo-row">
            <image
              class="teacher-kicker-logo"
              src="{{institution.logoUrl}}"
              mode="aspectFit"
            />
          </view>
          <view wx:if="{{teacher.title}}" class="teacher-kicker">
            <text>{{teacher.title}}</text>
          </view>
          <view class="teacher-name">{{teacher.name}}</view>
          <view wx:if="{{teacher.tagline}}" class="tagline">{{teacher.tagline}}</view>
        </view>
        <image wx:if="{{teacher.avatarUrl}}" class="avatar" src="{{teacher.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar fallback">师</view>
      </view>

      <scroll-view wx:if="{{teacher.specialties.length}}" class="specialties" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="specialties-track">
          <text wx:for="{{teacher.specialties}}" wx:for-item="spec" wx:key="*this" class="chip">{{spec}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="stats-shell">
      <view wx:if="{{statItems.length}}" class="stats">
        <view wx:for="{{statItems}}" wx:key="label" class="stat-card">
          <view class="stat-value">{{item.value}}</view>
          <view class="stat-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{teacher.teachingPhilosophy}}" class="card profile-card">
      <view class="section-title">教学理念</view>
      <view class="profile-text profile-quote">{{teacher.teachingPhilosophy}}</view>
    </view>

    <view class="card profile-card">
      <view class="section-title">教学经历与资质</view>
      <view wx:if="{{profileSections.length}}" class="profile-list">
        <view wx:for="{{profileSections}}" wx:key="key" class="profile-section">
          <view class="profile-label">{{item.label}}</view>
          <view wx:if="{{item.isList}}" class="profile-list-lines">
            <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this" class="profile-list-line">
              <text class="profile-list-dot"></text>
              <text class="profile-list-text">{{line}}</text>
            </view>
          </view>
          <view wx:else class="profile-text">{{item.text}}</view>
        </view>
      </view>
      <view wx:else class="muted profile-empty">老师介绍待补充。</view>
    </view>

    <view wx:if="{{courses.length}}" class="card profile-card">
      <view class="section-title">主讲课程</view>
      <view class="course-list">
        <navigator
          wx:for="{{courses}}"
          wx:key="id"
          class="course-card"
          url="/pages/course-detail/index?slug={{item.slug}}"
        >
          <view class="course-name">{{item.name}}</view>
          <view class="muted course-meta">{{item.category}} · {{item.ageRange}} · {{item.durationMinutes}}分钟</view>
          <view class="course-summary">{{item.summary}}</view>
        </navigator>
      </view>
    </view>

    <view wx:if="{{teacher.classPhotoUrls.length}}" class="card profile-card">
      <view class="section-title">课堂实拍</view>
      <scroll-view class="photo-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="photo-track">
          <image
            wx:for="{{teacher.classPhotoUrls}}"
            wx:key="*this"
            class="photo photo-slide"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            data-type="class"
            bindtap="previewPhoto"
          />
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{teacher.studentWorkUrls.length}}" class="card profile-card">
      <view class="section-title">学员作品</view>
      <scroll-view class="photo-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="photo-track">
          <image
            wx:for="{{teacher.studentWorkUrls}}"
            wx:key="*this"
            class="photo photo-slide"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            data-type="work"
            bindtap="previewPhoto"
          />
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{teacher.parentTestimonials.length}}" class="card profile-card">
      <view class="section-title">家长评价</view>
      <view class="quote-list">
        <view wx:for="{{teacher.parentTestimonials}}" wx:key="*this" class="quote-card">“{{item}}”</view>
      </view>
    </view>

    <view class="teacher-bottom-bar {{teacher.wechatQrUrl ? '' : 'single'}}">
      <button wx:if="{{teacher.wechatQrUrl}}" class="btn btn-outline bottom-btn" bindtap="previewQr">微信咨询</button>
      <button class="btn btn-primary bottom-btn" bindtap="goCourses">预约试听</button>
    </view>

    <view wx:if="{{coursePickerVisible}}" class="course-picker-mask" bindtap="closeCoursePicker">
      <view class="course-picker" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="course-picker-title">选择试听课程</view>
        <view class="course-picker-list">
          <view
            wx:for="{{courses}}"
            wx:key="id"
            class="course-picker-item"
            data-slug="{{item.slug}}"
            bindtap="onCourseChoiceTap"
          >
            <view class="course-picker-name">{{item.name}}</view>
            <view class="course-picker-meta">{{item.category}} · {{item.ageRange}}</view>
          </view>
        </view>
        <button class="course-picker-cancel" bindtap="closeCoursePicker">取消</button>
      </view>
    </view>
  </block>
</view>
