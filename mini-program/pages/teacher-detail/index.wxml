<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{notFound}}" class="empty-state">
    <view class="section-title">老师不存在或已下线</view>
    <button class="btn btn-outline empty-button" bindtap="goTeachers">返回教师团队</button>
  </view>

  <block wx:else>
    <button class="back-button" bindtap="goTeachers">‹ 教师团队</button>

    <view class="header card">
      <view class="header-main">
        <view class="teacher-head">
          <image wx:if="{{teacher.avatarUrl}}" class="avatar" src="{{teacher.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar fallback">师</view>
          <view class="teacher-main">
            <view class="teacher-name">{{teacher.name}}</view>
            <view wx:if="{{teacher.title}}" class="muted teacher-title">{{teacher.title}}</view>
            <view
              wx:if="{{institution}}"
              class="{{institution.logoUrl ? 'institution-logo-only' : 'institution'}}"
            >
              <image
                wx:if="{{institution.logoUrl}}"
                class="institution-logo"
                src="{{institution.logoUrl}}"
                mode="aspectFit"
              />
              <text wx:else>{{institution.name}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{teacher.wechatQrUrl}}" class="qr-top">
          <view class="qr-title">加老师微信</view>
          <image class="qr-top-image" src="{{teacher.wechatQrUrl}}" mode="aspectFit" bindtap="previewQr" />
        </view>
      </view>

      <view wx:if="{{teacher.tagline}}" class="tagline">{{teacher.tagline}}</view>

      <view wx:if="{{statItems.length}}" class="stats">
        <view wx:for="{{statItems}}" wx:key="label" class="stat-card">
          <view class="stat-value">{{item.value}}</view>
          <view class="stat-label">{{item.label}}</view>
        </view>
      </view>

      <view wx:if="{{teacher.specialties.length}}" class="specialties">
        <text wx:for="{{teacher.specialties}}" wx:for-item="spec" wx:key="*this" class="chip">{{spec}}</text>
      </view>

      <view class="action-row">
        <button class="btn btn-primary action-btn" bindtap="goCourses">预约试听</button>
        <button wx:if="{{teacher.wechatQrUrl}}" class="btn btn-outline action-btn" bindtap="previewQr">微信咨询</button>
      </view>
    </view>

    <view wx:if="{{teacher.teachingPhilosophy}}" class="card profile-card">
      <view class="section-title">教学理念</view>
      <view class="profile-text profile-quote">{{teacher.teachingPhilosophy}}</view>
    </view>

    <view wx:if="{{courses.length}}" class="card profile-card">
      <view class="section-title">主讲课程</view>
      <view class="course-list">
        <navigator
          wx:for="{{courses}}"
          wx:key="id"
          class="course-card"
          url="/pages/course-detail/index?slug={{item.slug}}"
        >
          <view class="course-name">{{item.name}}</view>
          <view class="muted course-meta">{{item.category}} · {{item.ageRange}} · {{item.durationMinutes}}分钟</view>
          <view class="course-summary">{{item.summary}}</view>
        </navigator>
      </view>
    </view>

    <view wx:if="{{teacher.classPhotoUrls.length}}" class="card profile-card">
      <view class="section-title">课堂实拍</view>
      <view class="photo-grid">
        <image wx:for="{{teacher.classPhotoUrls}}" wx:key="*this" class="photo" src="{{item}}" mode="aspectFill" />
      </view>
    </view>

    <view wx:if="{{teacher.studentWorkUrls.length}}" class="card profile-card">
      <view class="section-title">学员作品</view>
      <view class="photo-grid">
        <image wx:for="{{teacher.studentWorkUrls}}" wx:key="*this" class="photo" src="{{item}}" mode="aspectFill" />
      </view>
    </view>

    <view wx:if="{{teacher.parentTestimonials.length}}" class="card profile-card">
      <view class="section-title">家长评价</view>
      <view class="quote-list">
        <view wx:for="{{teacher.parentTestimonials}}" wx:key="*this" class="quote-card">“{{item}}”</view>
      </view>
    </view>

    <view class="card profile-card">
      <view class="section-title">教学经历与资质</view>
      <view wx:if="{{profileSections.length}}" class="profile-list">
        <view wx:for="{{profileSections}}" wx:key="key" class="profile-section">
          <view class="profile-label">{{item.label}}</view>
          <view wx:if="{{item.tone === 'list' && item.lines.length > 1}}" class="profile-lines">
            <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this" class="profile-line">
              <text class="profile-dot"></text>
              <text class="profile-line-text">{{line}}</text>
            </view>
          </view>
          <view wx:else class="profile-text {{item.tone === 'quote' ? 'profile-quote' : ''}}">
            {{item.text}}
          </view>
        </view>
      </view>
      <view wx:else class="muted profile-empty">老师介绍待补充。</view>
    </view>
  </block>
</view>
