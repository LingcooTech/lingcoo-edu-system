.back-button {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.back-button::after {
  border: 0;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
  display: grid;
  gap: 28rpx;
  justify-items: center;
}

.empty-button {
  width: 320rpx;
}

.teacher-detail-page {
  padding-right: 0;
  padding-left: 0;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  background: #f6f2eb;
}

.header {
  position: relative;
  overflow: hidden;
  margin-top: -42rpx;
  padding: 42rpx 40rpx 72rpx;
  background:
    radial-gradient(circle at 14% 18%, rgba(239, 210, 166, 0.76), transparent 34%),
    radial-gradient(circle at 88% 4%, rgba(188, 215, 226, 0.72), transparent 38%),
    linear-gradient(135deg, #fbf0dc 0%, #f5efe7 54%, #e9f1f4 100%);
}

.header::after {
  position: absolute;
  right: -112rpx;
  bottom: -152rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 999rpx;
  background: rgba(154, 106, 75, 0.08);
  content: '';
}

.header-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 236rpx;
  gap: 28rpx;
  align-items: center;
}

.avatar {
  display: block;
  width: 236rpx;
  height: 284rpx;
  margin-top: 22rpx;
  border-radius: 32rpx;
  background: #efe6dc;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.58);
  color: #9a6a4b;
  font-size: 54rpx;
  font-weight: 800;
}

.teacher-main {
  min-width: 0;
}

.teacher-logo-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.teacher-kicker {
  min-width: 0;
  color: #8a6347;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.teacher-kicker-logo {
  width: 118rpx;
  height: 42rpx;
  display: block;
}

.teacher-name {
  margin-top: 12rpx;
  color: #211f1c;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.04;
  letter-spacing: 0;
}

.tagline {
  margin-top: 22rpx;
  color: #514b43;
  font-size: 30rpx;
  line-height: 1.74;
}

.specialties {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
  white-space: nowrap;
}

.specialties-track {
  display: flex;
  gap: 12rpx;
  padding-right: 6rpx;
}

.specialties .chip {
  flex: 0 0 auto;
  border: 1rpx solid rgba(154, 106, 75, 0.16);
  background: rgba(255, 255, 255, 0.76);
  color: #8f6042;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.stats-shell {
  position: relative;
  z-index: 2;
  overflow: hidden;
  margin: -42rpx 36rpx 0;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 42rpx rgba(73, 56, 38, 0.1);
}

.stat-card {
  padding: 24rpx 12rpx;
  text-align: center;
}

.stat-card + .stat-card {
  border-left: 1rpx solid rgba(33, 31, 28, 0.07);
}

.stat-value {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.profile-card {
  margin: 24rpx 36rpx 0;
  padding: 28rpx;
}

.teacher-bio {
  white-space: pre-wrap;
}

.profile-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.profile-section {
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 22rpx 24rpx;
}

.profile-label {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
}

.profile-text {
  margin-top: 18rpx;
  color: #57534e;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.profile-list-lines {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.profile-list-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #57534e;
  font-size: 27rpx;
  line-height: 1.65;
}

.profile-list-dot {
  width: 8rpx;
  height: 8rpx;
  flex: 0 0 8rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #9a6a4b;
}

.profile-list-text {
  flex: 1;
}

.profile-quote {
  color: #211f1c;
}

.profile-empty {
  margin-top: 24rpx;
  font-size: 26rpx;
}

.course-list,
.quote-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.course-card {
  display: block;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 24rpx;
}

.course-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
}

.course-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.course-summary {
  margin-top: 12rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.6;
}

.photo-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
}

.photo-track {
  display: flex;
  gap: 16rpx;
  padding-right: 4rpx;
}

.photo {
  display: block;
  width: 100%;
  height: 320rpx;
  border-radius: 22rpx;
  background: #f3efe7;
}

.photo-slide {
  width: 520rpx;
  flex: 0 0 520rpx;
}

.quote-card {
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 24rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.7;
}

.teacher-bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  background: rgba(255, 255, 255, 0.96);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(33, 31, 28, 0.08);
}

.bottom-btn {
  width: 260rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.course-picker-mask {
  position: fixed;
  z-index: 120;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.42);
}

.course-picker {
  width: 100%;
  max-height: 76vh;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  margin: 0 auto 28rpx;
}

.course-picker-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.course-picker-list {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.course-picker-item {
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 20rpx;
  background: #faf7ef;
  padding: 22rpx;
}

.course-picker-name {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 800;
}

.course-picker-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 24rpx;
}

.course-picker-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  min-height: 76rpx;
  margin-top: 20rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f7f3ee;
  color: #8b857c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  padding: 0;
}

.course-picker-cancel::after {
  border: 0;
}
