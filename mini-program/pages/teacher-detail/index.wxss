.back-button {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 0;
  background: transparent;
  color: #1f6f5b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.back-button::after {
  border: 0;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
  display: grid;
  gap: 28rpx;
  justify-items: center;
}

.empty-button {
  width: 320rpx;
}

.header {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-color: rgba(197, 154, 84, 0.38);
  background: #fffaf0;
}

.header::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #17324d, #c59a54);
}

.teacher-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  flex: 0 0 128rpx;
  border-radius: 32rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e9f4ef;
  color: #1f6f5b;
  font-size: 40rpx;
  font-weight: 800;
}

.teacher-main {
  min-width: 0;
  flex: 1;
}

.teacher-name {
  color: #1f2b24;
  font-size: 38rpx;
  font-weight: 800;
}

.teacher-title {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.institution {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 280rpx;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(197, 154, 84, 0.55);
  border-radius: 999rpx;
  background: #fff;
  color: #17324d;
  font-size: 24rpx;
  font-weight: 700;
}

.institution-logo {
  width: 160rpx;
  height: 38rpx;
}

.tagline {
  margin-top: 24rpx;
  color: #34403a;
  font-size: 30rpx;
  line-height: 1.7;
}

.specialties {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.highlight-section {
  margin-top: 24rpx;
}

.highlight-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.highlight-card {
  border: 1rpx solid rgba(31, 43, 36, 0.08);
  border-left: 6rpx solid #17324d;
  border-radius: 18rpx;
  background: #fff;
  padding: 22rpx 24rpx;
}

.highlight-label {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
}

.highlight-text {
  margin-top: 8rpx;
  color: #1f2b24;
  font-size: 27rpx;
  line-height: 1.65;
}

.bio {
  margin-top: 24rpx;
  padding: 32rpx;
}

.bio-title {
  margin-bottom: 24rpx;
}

.qr-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.qr-title {
  color: #1f2b24;
  font-size: 30rpx;
  font-weight: 800;
}

.qr-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.qr-image {
  width: 360rpx;
  height: 360rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(31, 43, 36, 0.08);
  border-radius: 24rpx;
  background: #fff;
}
