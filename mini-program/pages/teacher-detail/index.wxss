.back-button {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 0;
  background: transparent;
  color: #9a6a4b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.back-button::after {
  border: 0;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
  display: grid;
  gap: 28rpx;
  justify-items: center;
}

.empty-button {
  width: 320rpx;
}

.teacher-detail-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  background: #f5f3ef;
}

.header {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-color: rgba(197, 154, 84, 0.38);
  background: #fffaf0;
}

.header-main {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.teacher-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
  flex: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  border-radius: 28rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 40rpx;
  font-weight: 800;
}

.teacher-main {
  min-width: 0;
  flex: 1;
  padding-right: 168rpx;
}

.teacher-name {
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 800;
}

.teacher-title {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.institution {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 280rpx;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(197, 154, 84, 0.55);
  border-radius: 999rpx;
  background: #fff;
  color: #17324d;
  font-size: 24rpx;
  font-weight: 700;
}

.institution-corner {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  margin-top: 0;
}

.institution-corner.institution,
.institution-corner.institution-logo-only {
  margin-top: 0;
}

.institution-logo-only {
  display: flex;
  align-items: center;
  width: 160rpx;
  height: 38rpx;
  margin-top: 12rpx;
}

.institution-logo {
  width: 160rpx;
  height: 38rpx;
}

.tagline {
  margin-top: 24rpx;
  color: #34403a;
  font-size: 30rpx;
  line-height: 1.7;
}

.specialties {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.stat-card {
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  padding: 18rpx 12rpx;
  text-align: center;
}

.stat-value {
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.profile-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.profile-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.profile-section {
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-left: 6rpx solid #17324d;
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 22rpx 24rpx;
}

.profile-label {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
}

.profile-text {
  margin-top: 8rpx;
  color: #57534e;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.profile-quote {
  border-left: 4rpx solid #c59a54;
  padding-left: 18rpx;
  color: #211f1c;
}

.profile-lines {
  display: grid;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-line {
  display: flex;
  gap: 12rpx;
  color: #57534e;
  font-size: 27rpx;
  line-height: 1.6;
}

.profile-dot {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #c59a54;
}

.profile-line-text {
  flex: 1;
}

.profile-empty {
  margin-top: 24rpx;
  font-size: 26rpx;
}

.course-list,
.quote-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.course-card {
  display: block;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 24rpx;
}

.course-name {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
}

.course-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.course-summary {
  margin-top: 12rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.6;
}

.photo-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
}

.photo-track {
  display: flex;
  gap: 16rpx;
  padding-right: 4rpx;
}

.photo {
  display: block;
  width: 100%;
  height: 320rpx;
  border-radius: 22rpx;
  background: #f3efe7;
}

.photo-slide {
  width: 520rpx;
  flex: 0 0 520rpx;
}

.quote-card {
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 24rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.7;
}

.teacher-bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  background: rgba(255, 255, 255, 0.96);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(33, 31, 28, 0.08);
}

.bottom-btn {
  width: 260rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.course-picker-mask {
  position: fixed;
  z-index: 120;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.42);
}

.course-picker {
  width: 100%;
  max-height: 76vh;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  margin: 0 auto 28rpx;
}

.course-picker-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.course-picker-list {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.course-picker-item {
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 20rpx;
  background: #faf7ef;
  padding: 22rpx;
}

.course-picker-name {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 800;
}

.course-picker-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 24rpx;
}

.course-picker-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  min-height: 76rpx;
  margin-top: 20rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f7f3ee;
  color: #8b857c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  padding: 0;
}

.course-picker-cancel::after {
  border: 0;
}
