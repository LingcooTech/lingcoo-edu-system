.back-button {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 0;
  background: transparent;
  color: #1f6f5b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.back-button::after {
  border: 0;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
  display: grid;
  gap: 28rpx;
  justify-items: center;
}

.empty-button {
  width: 320rpx;
}

.header {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-color: rgba(197, 154, 84, 0.38);
  background: #fffaf0;
}

.header-main {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.teacher-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
  flex: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  border-radius: 28rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e9f4ef;
  color: #1f6f5b;
  font-size: 40rpx;
  font-weight: 800;
}

.teacher-main {
  min-width: 0;
  flex: 1;
}

.teacher-name {
  color: #1f2b24;
  font-size: 36rpx;
  font-weight: 800;
}

.teacher-title {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.institution {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 280rpx;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(197, 154, 84, 0.55);
  border-radius: 999rpx;
  background: #fff;
  color: #17324d;
  font-size: 24rpx;
  font-weight: 700;
}

.institution-logo-only {
  display: flex;
  align-items: center;
  width: 160rpx;
  height: 38rpx;
  margin-top: 12rpx;
}

.institution-logo {
  width: 160rpx;
  height: 38rpx;
}

.qr-top {
  width: 168rpx;
  flex: 0 0 168rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  padding: 14rpx;
}

.qr-top-image {
  width: 140rpx;
  height: 140rpx;
  margin-top: 10rpx;
  border-radius: 14rpx;
  background: #fff;
}

.tagline {
  margin-top: 24rpx;
  color: #34403a;
  font-size: 30rpx;
  line-height: 1.7;
}

.specialties {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.stat-card {
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  padding: 18rpx 12rpx;
  text-align: center;
}

.stat-value {
  color: #1f2b24;
  font-size: 30rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 4rpx;
  color: #6c766f;
  font-size: 22rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-btn {
  width: 100%;
}

.profile-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.profile-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.profile-section {
  border: 1rpx solid rgba(31, 43, 36, 0.08);
  border-left: 6rpx solid #17324d;
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 22rpx 24rpx;
}

.profile-label {
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 800;
}

.profile-text {
  margin-top: 8rpx;
  color: #4f5a53;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.profile-quote {
  border-left: 4rpx solid #c59a54;
  padding-left: 18rpx;
  color: #1f2b24;
}

.profile-lines {
  display: grid;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-line {
  display: flex;
  gap: 12rpx;
  color: #4f5a53;
  font-size: 27rpx;
  line-height: 1.6;
}

.profile-dot {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #c59a54;
}

.profile-line-text {
  flex: 1;
}

.profile-empty {
  margin-top: 24rpx;
  font-size: 26rpx;
}

.course-list,
.quote-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.course-card {
  display: block;
  border: 1rpx solid rgba(31, 43, 36, 0.08);
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 24rpx;
}

.course-name {
  color: #1f2b24;
  font-size: 29rpx;
  font-weight: 800;
}

.course-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.course-summary {
  margin-top: 12rpx;
  color: #4f5a53;
  font-size: 26rpx;
  line-height: 1.6;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.photo {
  width: 100%;
  height: 210rpx;
  border-radius: 18rpx;
  background: #f3efe7;
}

.quote-card {
  border-radius: 18rpx;
  background: #faf7ef;
  padding: 24rpx;
  color: #4f5a53;
  font-size: 26rpx;
  line-height: 1.7;
}

.qr-title {
  color: #17324d;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}
