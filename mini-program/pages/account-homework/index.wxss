.homework-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  overflow: hidden;
  padding: 6rpx;
}

.homework-tab {
  display: flex;
  min-width: 0;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #6b6258;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.homework-tab.active {
  background: #211f1c;
  color: #fff;
}

.homework-form {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.homework-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  line-height: 1.6;
  padding: 22rpx 24rpx;
}

.homework-submit {
  width: 100%;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-cell {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #eef1ee;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(33, 31, 28, 0.78);
  color: #fff;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
}

.image-add {
  display: flex;
  width: 160rpx;
  height: 160rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(33, 31, 28, 0.22);
  border-radius: 16rpx;
  background: #fbfaf7;
  color: #8b857c;
}

.image-add-plus {
  font-size: 50rpx;
  line-height: 1;
}

.image-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.hw-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.hw-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #eef1ee;
}

.homework-rating {
  display: inline-flex;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #9a6a4b;
  font-size: 23rpx;
  font-weight: 900;
  padding: 8rpx 16rpx;
}
