<custom-navbar title="课表" />
<view class="page schedule-page">
  <view class="schedule-hero">
    <view class="week-grid">
      <button
        wx:for="{{weekDays}}"
        wx:key="key"
        class="day-cell {{item.selected ? 'selected' : ''}}"
        data-iso-date="{{item.isoDate}}"
        bindtap="onSelectDate"
      >
        <view class="weekday">{{item.weekday}}</view>
        <view class="day-number">{{item.day}}</view>
      </button>
    </view>
    <view class="selected-date">{{selectedDateLabel}}</view>
    <view class="week-actions">
      <button bindtap="onPreviousWeek">上一周</button>
      <button bindtap="onCurrentWeek">本周</button>
      <button bindtap="onNextWeek">下一周</button>
    </view>
  </view>

  <view class="schedule-body">
    <view class="section-title">课程安排</view>

    <skeleton wx:if="{{loading}}" variant="list" />

    <view wx:elif="{{selectedEvents.length}}" class="event-list">
      <view
        wx:for="{{selectedEvents}}"
        wx:key="id"
        class="event-card {{item.highlighted ? 'is-mine' : ''}} {{item.type == 'trial_session' ? 'is-trial' : ''}}"
        data-url="{{item.url}}"
        bindtap="onOpenEvent"
      >
        <view class="event-card-head">
          <view class="event-time">{{item.startsAtLabel}}</view>
          <view class="event-badge">{{item.badge}}</view>
        </view>
        <view class="event-title">{{item.courseName}} · {{item.title}}</view>
        <view class="event-meta">{{item.meta}}</view>
        <view wx:if="{{item.studentNames}}" class="event-students">孩子：{{item.studentNames}}</view>
      </view>
    </view>

    <view wx:else class="schedule-empty">
      <view class="empty-mark">...</view>
      <view class="empty-text">当天暂无公开课程安排～</view>
    </view>
  </view>
</view>
<tabbar />
