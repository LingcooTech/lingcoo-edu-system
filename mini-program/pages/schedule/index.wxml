<view class="schedule-page">
  <view class="schedule-hero" style="{{heroStyle}}">
    <view class="schedule-title">课表</view>
    <view class="week-grid">
      <button
        wx:for="{{weekDays}}"
        wx:key="key"
        class="day-cell {{item.selected ? 'selected' : ''}}"
        data-iso-date="{{item.isoDate}}"
        bindtap="onSelectDate"
      >
        <view class="weekday">{{item.weekday}}</view>
        <view class="day-number">{{item.day}}</view>
      </button>
    </view>
    <view class="selected-date">{{selectedDateLabel}}</view>
  </view>

  <view class="schedule-body">
    <view class="section-title">今日课程</view>

    <skeleton wx:if="{{loading}}" variant="list" />

    <view wx:elif="{{needLogin}}" class="schedule-empty">
      <view class="empty-mark">...</view>
      <view class="empty-text">登录后即可查看课程安排～</view>
      <button class="btn btn-primary login-button" bindtap="goLogin">去登录</button>
    </view>

    <view wx:elif="{{selectedEvents.length}}" class="event-list">
      <view wx:for="{{selectedEvents}}" wx:key="id" class="event-card">
        <view class="event-time">{{item.startsAtLabel}}</view>
        <view class="event-title">{{item.courseName}} · {{item.title}}</view>
        <view class="event-meta">{{item.student.name}} · {{item.class.name}} · {{item.classroomName}}</view>
      </view>
    </view>

    <view wx:else class="schedule-empty">
      <view class="empty-mark">...</view>
      <view class="empty-text">当天暂无课程安排～</view>
    </view>
  </view>
</view>
