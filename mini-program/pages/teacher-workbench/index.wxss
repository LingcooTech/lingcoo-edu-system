.summary-card {
  padding: 32rpx;
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.summary-eyebrow {
  color: #8b857c;
  font-size: 25rpx;
}

.summary-title {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 40rpx;
  font-weight: 900;
}

.scope-tabs {
  display: flex;
  flex-shrink: 0;
  border: 1rpx solid rgba(33, 31, 28, 0.1);
  border-radius: 999rpx;
  background: #f6f4f0;
  padding: 6rpx;
}

.scope {
  min-height: 52rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #57534e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 52rpx;
  padding: 0 22rpx;
}

.scope::after,
.tab::after,
.day::after {
  border: 0;
}

.scope-active {
  background: #211f1c;
  color: #fff;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 34rpx;
}

.summary-value {
  color: #211f1c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary-label {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
}

.tab {
  min-height: 86rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 22rpx;
  background: #fff;
  color: #211f1c;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.25;
  padding: 0 6rpx;
}

.tab-active {
  border-color: #211f1c;
  background: #211f1c;
  color: #fff;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 900;
}

.schedule-title {
  margin-top: 38rpx;
}

.list {
  display: grid;
  gap: 18rpx;
}

.compact-card,
.class-card,
.student-card {
  padding: 28rpx;
}

.card-title {
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.4;
}

.card-meta {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 16rpx;
}

.pill.subtle {
  background: #f6f4f0;
  color: #57534e;
}

.empty-card {
  padding: 34rpx;
  color: #8b857c;
  font-size: 26rpx;
}

.calendar-card {
  overflow: hidden;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
}

.day {
  min-height: 104rpx;
  border-radius: 0;
  background: transparent;
  color: #211f1c;
  font-size: 24rpx;
  line-height: 1.2;
  padding: 0;
}

.day-active {
  background: #f1e9e1;
  color: #9a6a4b;
}

.day-has .day-num::after,
.day-active .day-num::after {
  display: block;
  width: 8rpx;
  height: 8rpx;
  margin: 8rpx auto 0;
  border-radius: 999rpx;
  background: #9a6a4b;
  content: '';
}

.day-label {
  color: #8b857c;
  font-size: 20rpx;
}

.day-num {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.session-row {
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
}

.session-row:last-child {
  border-bottom: 0;
}

.session-time {
  color: #211f1c;
  font-size: 36rpx;
  font-weight: 900;
}

.session-class {
  margin-top: 6rpx;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.status-text {
  color: #57534e;
  font-size: 24rpx;
}

.session-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
}

.class-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  border-bottom: 1rpx solid rgba(33, 31, 28, 0.08);
  text-align: center;
}

.stat-num {
  color: #211f1c;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.student-mini-list {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.student-mini,
.balance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  padding: 18rpx 20rpx;
}

.student-name {
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.balance {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 25rpx;
  font-weight: 850;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.balance-list {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.content-text {
  margin-top: 20rpx;
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.7;
}

.homework-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.homework-image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  background: #f6f4f0;
}

.teacher-feedback {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.42);
}

.work-sheet {
  width: 100%;
  max-height: 90vh;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.review-sheet {
  max-height: 82vh;
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  margin: 0 auto 28rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.sheet-title {
  color: #211f1c;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.sheet-meta {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.4;
}

.sheet-close-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 44rpx;
  line-height: 68rpx;
  padding: 0;
}

.sheet-close-icon::after,
.status-option::after,
.review-status::after {
  border: 0;
}

.sheet-session {
  margin-top: 24rpx;
  border-radius: 22rpx;
  background: #f6f4f0;
  padding: 22rpx;
  text-align: center;
}

.sheet-time {
  color: #211f1c;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.sheet-date {
  margin-top: 8rpx;
  color: #9a6a4b;
  font-size: 24rpx;
  font-weight: 800;
}

.sheet-desc {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.roll-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: #fbfaf7;
  padding: 18rpx 10rpx;
  text-align: center;
}

.roll-num {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.1;
}

.roll-label {
  margin-top: 6rpx;
  color: #8b857c;
  font-size: 21rpx;
}

.sheet-scroll {
  max-height: 46vh;
  margin-top: 20rpx;
}

.feedback-scroll {
  max-height: 52vh;
}

.sheet-list {
  display: grid;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.sheet-loading,
.sheet-empty {
  color: #8b857c;
  font-size: 26rpx;
  padding: 34rpx 0;
  text-align: center;
}

.roll-row,
.feedback-row,
.review-origin {
  border: 1rpx solid rgba(33, 31, 28, 0.07);
  border-radius: 22rpx;
  background: #fff;
  padding: 22rpx;
}

.roll-student {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.roll-name {
  color: #211f1c;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.35;
}

.roll-grade {
  margin-top: 4rpx;
  color: #8b857c;
  font-size: 22rpx;
}

.recorded-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #e8f3ec;
  color: #287047;
  font-size: 22rpx;
  font-weight: 850;
  padding: 8rpx 16rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.status-option {
  min-height: 62rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 16rpx;
  background: #f6f4f0;
  color: #57534e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 62rpx;
  padding: 0;
}

.status-option-active {
  border-color: #9a6a4b;
  background: #f1e9e1;
  color: #9a6a4b;
}

.status-option[disabled] {
  opacity: 0.58;
}

.feedback-input {
  width: 100%;
  min-height: 168rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(33, 31, 28, 0.08);
  border-radius: 18rpx;
  background: #fbfaf7;
  color: #211f1c;
  font-size: 25rpx;
  line-height: 1.6;
  padding: 18rpx;
  box-sizing: border-box;
}

.review-input {
  min-height: 220rpx;
}

.review-status-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.review-status {
  min-height: 72rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
  color: #57534e;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 72rpx;
}

.review-status-active {
  background: #211f1c;
  color: #fff;
}

.sheet-error {
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #fff1f0;
  color: #c15c3a;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 16rpx 18rpx;
}

.sheet-submit {
  width: 100%;
  margin-top: 20rpx;
}
