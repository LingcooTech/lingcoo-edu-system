.hero,
.block-card,
.trial-card,
.form-card {
  padding: 30rpx;
}

.hero-title {
  margin-top: 18rpx;
}

.hero-subtitle {
  margin-top: 16rpx;
}

.hero-image {
  width: 100%;
  height: 340rpx;
  margin-top: 24rpx;
  border-radius: 22rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.trial-list {
  display: grid;
  gap: 16rpx;
  margin-top: 20rpx;
}

.trial-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 1rpx solid rgba(31, 43, 36, 0.1);
  border-radius: 18rpx;
  padding: 22rpx;
}

.trial-option-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 18rpx;
}

.trial-cover {
  width: 148rpx;
  height: 104rpx;
  flex: 0 0 148rpx;
  border-radius: 16rpx;
  background: #e9f4ef;
}

.trial-copy {
  min-width: 0;
  flex: 1;
}

.trial-title {
  color: #1f2b24;
  font-size: 27rpx;
  font-weight: 800;
}

.trial-meta,
.trial-empty,
.form-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.trial-fee {
  margin-top: 8rpx;
  color: #a15c12;
  font-size: 24rpx;
  font-weight: 700;
}

.form-hint {
  margin-bottom: 22rpx;
}

.submit-button {
  margin-top: 24rpx;
  width: 100%;
}

.empty-state {
  padding-top: 120rpx;
  text-align: center;
}

.empty-button {
  margin-top: 28rpx;
}
