<view class="page">
  <skeleton wx:if="{{loading}}" variant="detail" />

  <view wx:elif="{{notFound}}" class="empty-state">
    <view class="section-title">活动不存在或已结束</view>
    <navigator class="btn btn-outline empty-button" url="/pages/home/index" open-type="switchTab">返回首页</navigator>
  </view>

  <block wx:else>
    <view class="hero card">
      <view class="eyebrow">{{payload.channel ? payload.channel.name : '招生活动'}}</view>
      <view class="title hero-title">{{payload.campaign.name}}</view>
      <view class="body-text hero-subtitle">
        {{payload.course ? payload.course.name + ' · ' + payload.course.summary : payload.organization.publicProfile.bannerSubtitle}}
      </view>
      <image
        wx:if="{{heroImageUrl}}"
        class="hero-image"
        src="{{heroImageUrl}}"
        mode="aspectFill"
      />
      <view class="chips">
        <text wx:if="{{payload.course}}" class="chip">{{payload.course.category}}</text>
        <text wx:if="{{payload.course}}" class="chip">{{payload.course.ageRange}}</text>
        <text
          wx:if="{{!payload.course}}"
          wx:for="{{payload.organization.publicProfile.highlights}}"
          wx:key="text"
          class="chip"
        >
          {{item.title || item.text}}
        </text>
      </view>
    </view>

    <view wx:if="{{contentBlocks.length}}" class="section card block-card">
      <block-renderer blocks="{{contentBlocks}}" />
    </view>

    <view class="section card trial-card">
      <view class="section-title">可预约试听</view>
      <radio-group wx:if="{{trialSessions.length}}" class="trial-list" bindchange="onTrialChange">
        <label wx:for="{{trialSessions}}" wx:key="id" class="trial-option">
          <view class="trial-option-main">
            <image wx:if="{{item.coverImageUrl}}" class="trial-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
            <view class="trial-copy">
              <view class="trial-title">{{item.title}}</view>
              <view class="muted trial-meta">{{item.startsAtLabel}} · {{item.bookedCount}}/{{item.capacity}}</view>
              <view wx:if="{{item.reservationFeeLabel}}" class="trial-fee">{{item.reservationFeeLabel}}</view>
            </view>
          </view>
          <radio value="{{item.id}}" checked="{{trialSessionId == item.id}}" color="#9a6a4b" />
        </label>
      </radio-group>
      <view wx:else class="muted trial-empty">当前活动不绑定固定试听课，提交后老师会电话确认合适时间。</view>
    </view>

    <form class="section card form-card" bindsubmit="onSubmit">
      <view class="section-title">提交报名</view>
      <view class="muted form-hint">
        {{selectedRequiresReservationFee ? '本场需支付试听席位保留费后保留名额。' : (trialSessionId ? '提交后进入预约试听阶段。' : '提交后进入待联系阶段。')}}
      </view>
      <view class="form-gap">
        <input class="form-field" name="guardianName" placeholder="家长姓名" />
        <input class="form-field" name="phone" type="number" placeholder="手机号" />
        <input class="form-field" name="studentName" placeholder="孩子姓名" />
        <input class="form-field" name="grade" placeholder="年级 / 年龄" />
      </view>
      <button class="btn btn-primary submit-button" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">
        {{submitting ? '提交中...' : (selectedRequiresReservationFee ? '去支付保留名额' : '立即预约')}}
      </button>
    </form>
  </block>
</view>
