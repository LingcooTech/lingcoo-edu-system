.teacher-profile-edit-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 170rpx;
  background: #f6f4f0;
}

.edit-card,
.error-card {
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 31, 28, 0.05);
}

.error-card {
  color: #a83f35;
  background: #fff1ef;
}

.section-title {
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
}

.field {
  min-width: 0;
  margin-top: 24rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6b6258;
  font-size: 23rpx;
  font-weight: 750;
}

.text-input,
.text-area {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e3ded7;
  border-radius: 18rpx;
  background: #fbfaf8;
  color: #211f1c;
  font-size: 27rpx;
  padding: 0 22rpx;
}

.text-input {
  min-height: 78rpx;
  line-height: 78rpx;
}

.text-area {
  min-height: 210rpx;
  line-height: 1.65;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.text-area.compact {
  min-height: 150rpx;
}

.submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-top: 1rpx solid #e7e1da;
  background: rgba(255, 255, 255, 0.96);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
}

.submit-hint {
  flex: 1;
  color: #8b857c;
  font-size: 22rpx;
}

.submit-button {
  min-width: 190rpx;
  height: 76rpx;
  border: 0;
  border-radius: 18rpx;
  background: #9a6a4b;
  color: #fff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
}

.submit-button::after {
  border: 0;
}
