.trial-detail-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.header,
.fee-card,
.order-card,
.form-card {
  padding: 26rpx;
}

.trial-title {
  margin-top: 16rpx;
}

.summary {
  margin-top: 14rpx;
}

.trial-cover {
  display: block;
  width: 100%;
  height: 330rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #f1e9e1;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.meta-card {
  border-radius: 18rpx;
  background: #f7faf8;
  padding: 16rpx;
}

.meta-label {
  color: #8b857c;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 8rpx;
  color: #211f1c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.fee-card {
  border-color: rgba(161, 92, 18, 0.2);
  background: #fffaf0;
}

.fee-copy {
  margin-top: 12rpx;
}

.notice-text {
  margin-top: 16rpx;
  white-space: pre-wrap;
  color: #7a4f00;
  font-size: 24rpx;
  line-height: 1.7;
}

.order-no {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.order-status {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f2f0ea;
  color: #5d655f;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.order-status.pending {
  background: #fff4d8;
  color: #8a5a00;
}

.order-status.paid {
  background: #f1e9e1;
  color: #9a6a4b;
}

.order-line {
  margin-top: 20rpx;
}

.order-amount {
  color: #211f1c;
  font-size: 30rpx;
  font-weight: 800;
}

.pay-button,
.submit-button,
.account-button {
  margin-top: 22rpx;
  width: 100%;
}

.form-hint {
  margin: 10rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.sticky-cta {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin: 0;
  border-top: 1rpx solid rgba(33, 31, 28, 0.08);
  background: rgba(255, 255, 255, 0.96);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(33, 31, 28, 0.08);
}

.sticky-button {
  width: 260rpx;
  min-height: 76rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.sticky-button.secondary {
  color: #211f1c;
}

.empty-state {
  padding-top: 120rpx;
  text-align: center;
}

.empty-button {
  margin-top: 28rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(33, 31, 28, 0.42);
}

.bottom-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  padding: 18rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  transition: transform 0.18s ease;
}

.bottom-sheet.dragging {
  transition: none;
}

.sheet-handle {
  width: 78rpx;
  height: 32rpx;
  border-radius: 999rpx;
  margin: 0 auto 14rpx;
  position: relative;
}

.sheet-handle::after {
  position: absolute;
  top: 12rpx;
  left: 0;
  width: 78rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  content: '';
}

.sheet-heading {
  position: relative;
  align-items: flex-start;
  gap: 16rpx;
  padding-right: 76rpx;
}

.close-button {
  position: absolute;
  top: -2rpx;
  right: 0;
  display: flex;
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  min-height: 56rpx;
  max-height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 52rpx;
  overflow: hidden;
  text-align: center;
}

.close-button:active {
  background: #eadbce;
}
