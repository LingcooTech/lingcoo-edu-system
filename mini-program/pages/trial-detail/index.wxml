<view class="page">
  <skeleton wx:if="{{loading}}" variant="detail" />

  <view wx:elif="{{notFound}}" class="empty-state">
    <view class="section-title">公开课不存在或已关闭</view>
    <button class="btn btn-outline empty-button" bindtap="goHome">返回首页</button>
  </view>

  <block wx:else>
    <view class="header card">
      <view class="title trial-title">{{detail.trialSession.title}}</view>
      <view class="body-text summary">{{detail.course.summary}}</view>
      <image
        wx:if="{{detail.trialSession.coverImageUrl || detail.course.coverImageUrl}}"
        class="trial-cover"
        src="{{detail.trialSession.coverImageUrl || detail.course.coverImageUrl}}"
        mode="aspectFill"
      />
      <view class="meta-grid">
        <view class="meta-card">
          <view class="meta-label">开始时间</view>
          <view class="meta-value">{{startsAtLabel}}</view>
        </view>
        <view class="meta-card">
          <view class="meta-label">地点</view>
          <view class="meta-value">{{campusLabel}}</view>
        </view>
        <view class="meta-card">
          <view class="meta-label">名额</view>
          <view class="meta-value">{{detail.trialSession.bookedCount}}/{{detail.trialSession.capacity}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{requiresReservationFee}}" class="section card fee-card">
      <view class="section-title">{{reservationFeeLabel}}</view>
      <view class="body-text fee-copy">支付成功后保留本场试听或公开课名额。</view>
      <view wx:if="{{detail.trialSession.reservationNotice}}" class="notice-text">{{detail.trialSession.reservationNotice}}</view>
    </view>

    <view wx:if="{{order}}" class="section card order-card">
      <view class="row-between">
        <view>
          <view class="section-title">占位费订单</view>
          <view class="muted order-no">{{order.orderNo}}</view>
        </view>
        <view class="order-status {{order.status}}">{{order.statusLabel}}</view>
      </view>
      <view class="row-between order-line">
        <view class="muted">金额</view>
        <view class="order-amount">{{order.amountLabel}}</view>
      </view>
      <button wx:if="{{order.status == 'pending'}}" class="btn btn-primary pay-button" loading="{{paying}}" disabled="{{paying}}" data-order-no="{{order.orderNo}}" bindtap="onContinuePay">
        {{paying ? '支付中...' : '继续支付'}}
      </button>
    </view>

    <view class="section card form-card reserve-card">
      <view class="section-title">{{requiresReservationFee ? '保留试听席位' : '预约试听'}}</view>
      <view class="muted form-hint">
        {{requiresReservationFee ? '登录后可支付席位保留费，老师按场次安排接待。' : '留下信息后，老师会电话确认试听安排。'}}
      </view>
      <button class="btn btn-primary submit-button" bindtap="onReserveTap" disabled="{{full}}">
        {{full ? '名额已满' : (requiresReservationFee ? '保留名额' : '立即预约')}}
      </button>
    </view>

    <view class="sticky-cta app-bottom-bar">
      <view class="sticky-note">{{startsAtLabel || '试听场次'}}</view>
      <button class="btn btn-primary sticky-button" bindtap="onReserveTap" disabled="{{full}}">
        {{full ? '名额已满' : (requiresReservationFee ? '保留名额' : '预约试听')}}
      </button>
    </view>

    <view wx:if="{{showReservationForm}}" class="sheet-mask" bindtap="closeReservationForm">
      <form class="bottom-sheet" catchtap="noop" bindsubmit="onSubmit">
        <view class="sheet-handle"></view>
        <view class="row-between sheet-heading">
          <view>
            <view class="section-title">{{requiresReservationFee ? '保留试听席位' : '预约试听'}}</view>
            <view class="muted form-hint">
              {{requiresReservationFee ? '请先登录家长中心，再支付席位保留费。' : '提交后老师会电话确认试听安排。'}}
            </view>
          </view>
          <button class="close-button" bindtap="closeReservationForm">关闭</button>
        </view>
        <view class="form-gap">
          <input class="form-field" name="guardianName" placeholder="家长姓名" value="{{guardianName}}" />
          <input class="form-field" name="phone" type="number" placeholder="手机号" value="{{phone}}" />
          <input class="form-field" name="studentName" placeholder="孩子姓名" value="{{studentName}}" />
          <input class="form-field" name="grade" placeholder="年级 / 年龄" value="{{grade}}" />
        </view>
        <button class="btn btn-primary submit-button" form-type="submit" loading="{{submitting || paying}}" disabled="{{submitting || paying || full}}">
          {{full ? '名额已满' : (submitting || paying ? '处理中...' : (requiresReservationFee ? '支付保留名额' : '提交预约'))}}
        </button>
        <button wx:if="{{requiresReservationFee}}" class="btn btn-outline account-button" bindtap="goAccount">
          家长中心登录
        </button>
      </form>
    </view>
  </block>
</view>
