.page-title {
  margin-top: 12rpx;
}

.intro {
  margin-top: 12rpx;
}

.course-list {
  display: grid;
  gap: 20rpx;
  margin-top: 28rpx;
}

.course-card {
  padding: 28rpx;
}

.course-name {
  flex: 1;
  min-width: 0;
  color: #1f2b24;
  font-size: 31rpx;
  font-weight: 800;
}

.price {
  flex-shrink: 0;
  color: #1f2b24;
  font-size: 26rpx;
  font-weight: 800;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.summary {
  margin-top: 14rpx;
}
