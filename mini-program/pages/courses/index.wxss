.page-title {
  margin-top: 12rpx;
}

.intro {
  margin-top: 12rpx;
}

.course-list {
  display: grid;
  gap: 20rpx;
  margin-top: 28rpx;
}

.course-card {
  overflow: hidden;
  padding: 28rpx;
}

.course-cover {
  display: block;
  width: calc(100% + 56rpx);
  height: 300rpx;
  margin: -28rpx -28rpx 24rpx;
  background: #e9f4ef;
}

.course-name {
  flex: 1;
  min-width: 0;
  color: #1f2b24;
  font-size: 31rpx;
  font-weight: 800;
}

.price {
  flex-shrink: 0;
  color: #1f2b24;
  font-size: 26rpx;
  font-weight: 800;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.summary {
  margin-top: 14rpx;
}
