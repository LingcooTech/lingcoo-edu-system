.courses-page {
  padding-bottom: 130rpx;
  background: #f5f3ef;
}

.courses-hero {
  margin: -24rpx -24rpx 0;
  margin-top: -88px;
  border-radius: 0 0 36rpx 36rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0)),
    linear-gradient(180deg, #ead6bf 0%, #f6eee5 100%);
  padding: calc(88px + 38rpx) 30rpx 54rpx;
}

.courses-eyebrow {
  color: #8b5e42;
  font-size: 25rpx;
  font-weight: 900;
}

.courses-title {
  margin-top: 14rpx;
  color: #211f1c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.16;
}

.courses-subtitle {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: #6b6258;
  font-size: 27rpx;
  line-height: 1.55;
}

.courses-count {
  display: inline-flex;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #8b5e42;
  font-size: 24rpx;
  font-weight: 900;
  padding: 12rpx 20rpx;
}

.course-list {
  display: grid;
  gap: 20rpx;
  margin-top: -20rpx;
}

.course-card {
  overflow: hidden;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  background: #fff;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.course-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.course-cover {
  display: block;
  width: calc(100% + 48rpx);
  height: 260rpx;
  margin: -24rpx -24rpx 22rpx;
  background: linear-gradient(90deg, #f1e9e1 0%, #f7f3ee 50%, #f1e9e1 100%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.course-name {
  flex: 1;
  min-width: 0;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 800;
}

.price {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.summary {
  margin-top: 14rpx;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}
