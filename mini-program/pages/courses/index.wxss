.courses-page {
  padding-bottom: 130rpx;
  background: #f5f3ef;
}

.courses-hero {
  position: relative;
  min-height: 360rpx;
  overflow: hidden;
  margin: -24rpx -24rpx 0;
  margin-top: -88px;
  border-radius: 0;
  background: #cfa57d;
}

.courses-head-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    radial-gradient(circle at 82% 12%, rgba(255, 255, 255, 0.36), rgba(255, 255, 255, 0) 38%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(33, 31, 28, 0.44));
}

.courses-head-copy {
  position: absolute;
  right: 250rpx;
  bottom: 48rpx;
  left: 28rpx;
  color: #fff;
}

.courses-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.26;
}

.courses-subtitle {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  line-height: 1.5;
}

.courses-count {
  position: absolute;
  right: 28rpx;
  bottom: 68rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #8b5e42;
  font-size: 24rpx;
  font-weight: 900;
  padding: 12rpx 20rpx;
  white-space: nowrap;
}

.course-list {
  display: grid;
  gap: 20rpx;
  margin-top: 18rpx;
  position: relative;
  z-index: 2;
}

.course-card {
  overflow: hidden;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  background: #fff;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.course-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.course-cover {
  display: block;
  width: calc(100% + 48rpx);
  height: 260rpx;
  margin: -24rpx -24rpx 22rpx;
  background: linear-gradient(90deg, #f1e9e1 0%, #f7f3ee 50%, #f1e9e1 100%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.course-name {
  flex: 1;
  min-width: 0;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 800;
}

.price {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.summary {
  margin-top: 14rpx;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}
