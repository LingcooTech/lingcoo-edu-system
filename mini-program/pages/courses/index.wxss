.page-title {
  margin-top: 12rpx;
}

.intro {
  margin-top: 12rpx;
}

.course-list {
  display: grid;
  gap: 20rpx;
  margin-top: 28rpx;
}

.course-card {
  overflow: hidden;
  padding: 24rpx;
}

.course-cover {
  display: block;
  width: calc(100% + 48rpx);
  height: 260rpx;
  margin: -24rpx -24rpx 22rpx;
  background: #f1e9e1;
}

.course-name {
  flex: 1;
  min-width: 0;
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 800;
}

.price {
  flex-shrink: 0;
  color: #211f1c;
  font-size: 26rpx;
  font-weight: 800;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.summary {
  margin-top: 14rpx;
}
