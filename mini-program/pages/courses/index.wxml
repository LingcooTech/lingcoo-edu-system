<custom-navbar title="活动" transparent="{{!navSolid}}" />
<view class="page courses-page">
  <view class="courses-hero">
    <view class="courses-head-shade"></view>
    <view class="courses-head-copy">
      <view class="courses-title">选择适合孩子的活动</view>
      <view class="courses-subtitle">活动由合作机构组织实施</view>
    </view>
    <view wx:if="{{courses.length}}" class="courses-count">{{courses.length}} 个活动开放中</view>
  </view>

  <view class="course-filters">
    <view class="filter-grid">
      <picker
        mode="selector"
        range="{{institutionOptions}}"
        range-key="label"
        value="{{selectedInstitutionIndex}}"
        bindchange="onInstitutionChange"
      >
        <view class="filter-picker">{{institutionOptions[selectedInstitutionIndex].label}}</view>
      </picker>
      <picker
        mode="selector"
        range="{{categoryOptions}}"
        range-key="label"
        value="{{selectedCategoryIndex}}"
        bindchange="onCategoryChange"
      >
        <view class="filter-picker">{{categoryOptions[selectedCategoryIndex].label}}</view>
      </picker>
    </view>
    <view class="filter-footer">
      <view class="filter-count">筛选结果 {{courses.length}} 个</view>
    </view>
  </view>

  <skeleton wx:if="{{loading}}" variant="list" />
  <view wx:elif="{{courses.length}}" class="course-list">
    <navigator wx:for="{{courses}}" wx:key="id" class="card course-card" url="/pages/course-detail/index?slug={{item.slug}}">
      <image wx:if="{{item.coverImageUrl}}" class="course-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
      <view class="row-between">
        <view class="course-name">{{item.name}}</view>
        <view class="price">{{item.priceLabel}}</view>
      </view>
      <view class="provider-line">合作机构：{{item.providerLabel}}</view>
      <view class="muted meta">{{item.category}} · {{item.ageRange}} · {{item.durationMinutes}} 分钟</view>
      <view class="body-text summary">{{item.summary}}</view>
    </navigator>
  </view>
  <view wx:else class="empty">活动即将上线</view>
</view>
<tabbar />
