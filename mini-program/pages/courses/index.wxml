<view class="page">
  <view class="eyebrow">课程</view>
  <view class="title page-title">课程列表</view>
  <view class="body-text intro">选择感兴趣的课程，查看详情并预约试听。</view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{courses.length}}" class="course-list">
    <navigator wx:for="{{courses}}" wx:key="id" class="card course-card" url="/pages/course-detail/index?slug={{item.slug}}">
      <image wx:if="{{item.coverImageUrl}}" class="course-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
      <view class="row-between">
        <view class="course-name">{{item.name}}</view>
        <view class="price">{{item.priceLabel}}</view>
      </view>
      <view class="muted meta">{{item.category}} · {{item.ageRange}} · {{item.durationMinutes}} 分钟</view>
      <view class="body-text summary">{{item.summary}}</view>
    </navigator>
  </view>
  <view wx:else class="empty">课程即将上线</view>
</view>
