.stories-page {
  padding-bottom: 130rpx;
  background: #f5f3ef;
}

.story-list {
  display: grid;
  gap: 16rpx;
}

.story-card {
  display: flex;
  min-height: 170rpx;
  align-items: center;
  gap: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(33, 31, 28, 0.05);
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 18rpx;
}

.story-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.story-cover {
  display: flex;
  width: 184rpx;
  height: 132rpx;
  flex: 0 0 184rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #f1e9e1;
}

.story-cover-fallback {
  color: #9a6a4b;
  font-size: 34rpx;
  font-weight: 900;
}

.story-body {
  flex: 1;
  min-width: 0;
}

.story-title {
  display: -webkit-box;
  overflow: hidden;
  color: #211f1c;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.story-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: #57534e;
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
