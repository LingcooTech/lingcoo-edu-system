.gallery-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f5f3ef;
}

.gallery-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gallery-count {
  color: #8b857c;
  font-size: 24rpx;
  font-weight: 850;
}

.works-list {
  display: grid;
  gap: 22rpx;
}

.work-card {
  overflow: hidden;
}

.work-frame {
  margin: 24rpx 24rpx 0;
  background: #fff;
}

.frame-classic {
  border: 14rpx solid #fff;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(154, 106, 75, 0.16);
}

.frame-gallery {
  border: 20rpx solid #eee5da;
  border-radius: 18rpx;
  box-shadow: inset 0 0 0 4rpx #fff;
}

.frame-paper {
  border: 16rpx solid #fbfaf7;
  border-radius: 10rpx;
  box-shadow: 0 10rpx 24rpx rgba(33, 31, 28, 0.08);
  transform: rotate(-0.4deg);
}

.work-cover {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 10rpx;
  background: #ece8df;
}

.work-body {
  padding: 24rpx;
}

.row-between {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.work-title {
  color: #211f1c;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.work-meta,
.work-foot {
  margin-top: 8rpx;
  color: #8b857c;
  font-size: 23rpx;
  line-height: 1.45;
}

.source-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #f1e9e1;
  color: #9a6a4b;
  font-size: 22rpx;
  font-weight: 850;
  padding: 8rpx 16rpx;
}

.work-desc {
  margin-top: 16rpx;
  border-radius: 18rpx;
  background: #fbfaf7;
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.6;
  padding: 18rpx;
}

.gallery-empty {
  display: flex;
  min-height: 420rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.gallery-mark {
  width: 112rpx;
  height: 112rpx;
  border: 16rpx solid #f1e9e1;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff 0%, #f8f3ed 100%);
  box-shadow: inset 0 0 0 2rpx rgba(154, 106, 75, 0.14);
}

.gallery-title {
  margin-top: 28rpx;
  color: #211f1c;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.gallery-desc {
  max-width: 540rpx;
  margin-top: 12rpx;
  color: #8b857c;
  font-size: 25rpx;
  line-height: 1.55;
}
