{
  "name": "lingcoo-edu-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted education operations platform for community classrooms and training centers.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:api": "npm run dev",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:admin": "cd admin-ui && npm run dev",
    "dev:public": "cd public-web && npm run dev",
    "build": "tsc -p tsconfig.json",
    "build:admin": "cd admin-ui && npm install && npm run build",
    "build:public": "cd public-web && npm install && npm run build",
    "build:all": "npm run build:admin && npm run build:public && npm run build",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit && cd admin-ui && npm run typecheck && cd ../public-web && npm run typecheck",
    "lint": "eslint . && cd admin-ui && npm run lint && cd ../public-web && npm run lint",
    "lint:fix": "eslint . --fix && cd admin-ui && npm run lint -- --fix && cd ../public-web && npm run lint -- --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:bootstrap": "node dist/db/bootstrap.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "db:preflight-lessons": "node scripts/preflight-package-ledger.mjs",
    "db:reconcile-lessons": "node scripts/reconcile-package-ledger.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.3",
    "alipay-sdk": "^4.14.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "nodemailer": "^8.0.9",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
