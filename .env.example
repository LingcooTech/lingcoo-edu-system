NODE_ENV=development
APP_NAME=fd-edu-stack
APP_VERSION=development
API_HOST=0.0.0.0
API_PORT=8090
PUBLIC_WEB_BASE_URL=http://localhost:5174
PUBLIC_WEB_ORIGIN=http://localhost:5174
ADMIN_WEB_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=change-me-in-production
DATABASE_URL=postgres://fd_edu:fd_edu_password@postgres:5432/fd_edu
REDIS_URL=redis://redis:6379
LOG_LEVEL=info
FD_DOMAIN_BINDING_SOURCE=none
FD_BOUND_HOST=

# 微信小程序登录（AppSecret 只放运行环境，不提交真实值）
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
WECHAT_MINI_PROGRAM_STATE=
WECHAT_MINI_SUBSCRIBE_TRIAL_TEMPLATE_ID=
WECHAT_MINI_SUBSCRIBE_PAYMENT_TEMPLATE_ID=
WECHAT_MINI_SUBSCRIBE_LESSON_REMINDER_TEMPLATE_ID=
WECHAT_MINI_SUBSCRIBE_LESSON_CONSUMED_TEMPLATE_ID=
WECHAT_MINI_SUBSCRIBE_LEARNING_UPDATE_TEMPLATE_ID=

# 微信支付（也可在 Web 管理后台支付设置里配置）
WECHAT_PAY_APP_ID=
WECHAT_PAY_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_PAY_NOTIFY_URL=

POSTGRES_DB=fd_edu
POSTGRES_USER=fd_edu
POSTGRES_PASSWORD=fd_edu_password

CADDY_SITE_ADDRESS=:80
FD_EDU_HTTP_PORT=18090
FD_EDU_HTTPS_PORT=18446
FD_EDU_RUNTIME_IMAGE=ghcr.io/lingcootech/lingcoo-edu-system:latest
